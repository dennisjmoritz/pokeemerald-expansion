script Route131_EventScript_Talia {
    trainerbattle_double(TRAINER_TALIA, Route131_Text_TaliaIntro, Route131_Text_TaliaDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route131_Text_TaliaPostBattle)
