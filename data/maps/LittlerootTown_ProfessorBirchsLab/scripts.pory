text LittlerootTown_ProfessorBirchsLab_Text_CrammedWithBooksOnPokemon {
    format("It's crammed with books on POKéMON.")
}

text LittlerootTown_ProfessorBirchsLab_Text_PCUsedForResearch {
    format("It's a PC used for research. Better not mess around with it.")
}

text LittlerootTown_ProfessorBirchsLab_Text_BookTooHardToRead {
    format("It's a book that's too hard to read.")
}

text LittlerootTown_ProfessorBirchsLab_Text_SeriousLookingMachine {
    format("It's a serious-looking machine. The PROF must use this for research.")
}

text LittlerootTown_ProfessorBirchsLab_Text_BirchEnjoysRivalsHelpToo {
    format("PROF. BIRCH is studying the habitats\nand distribution of POKéMON.\pThe PROF enjoys {RIVAL}'s help, too.\nThere's a lot of love there.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BrendanHaveYouGoneToBattleFrontier {
    format("BRENDAN: Hey, {PLAYER}!\nHave you gone out to that place,\lthe BATTLE FRONTIER?$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BrendanWhereShouldIGoNext {
    format("BRENDAN: Where should I look for\nPOKéMON next…$")
}

text LittlerootTown_ProfessorBirchsLab_Text_CountlessPokemonAwait {
    format("PROF. BIRCH: Countless POKéMON\nawait you!\pArgh, I'm getting the itch to get out\nand do fieldwork again!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_GetRivalToTeachYou {
    format("PROF. BIRCH: Great!\n{RIVAL} should be happy, too.\pGet {RIVAL} to teach you what it\nmeans to be a TRAINER.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayTakeBreakFromFieldwork {
    format("MAY: I think I'll take a short break\nfrom fieldwork.\pI think I'll help the PROF here for\na while.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_HeardYouBeatRivalTakePokedex {
    format("PROF. BIRCH: Oh, hi, {PLAYER}{KUN}!\pI heard you beat {RIVAL} on\nyour first try. That's excellent!\p{RIVAL}'s been helping with my research\nfor a long time.\p{RIVAL} has an extensive history as\na TRAINER already.\pHere, {PLAYER}{KUN}, I ordered this for my\nresearch, but I think you should have\lthis POKéDEX.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MightBeGoodIdeaToGoSeeRival {
    format("PROF. BIRCH: If you work at POKéMON\nand gain experience, I think you'll make\lan extremely good TRAINER.\pMy kid, {RIVAL}, is also studying\nPOKéMON while helping me out.\p{PLAYER}{KUN}, don't you think it might be\na good idea to go see {RIVAL}?$")
}

text LittlerootTown_ProfessorBirchsLab_Text_WhyNotGiveNicknameToMon {
    format("PROF. BIRCH: While you're at it, why not\ngive a nickname to that {STR_VAR_1}?$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BrendanYouCanThankMe {
    format("BRENDAN: I went out all over HOENN\nand checked out POKéMON.\pYou can thank me for getting\nthe NATIONAL Mode POKéDEX.\pYep, you're lucky, {PLAYER}!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_CompletedDexChoosePokemon {
    format("PROF. BIRCH: Oh, {PLAYER}{KUN}!\nLet's have a look at your POKéDEX.\p… … … … … …\n… … … … … …\pYes, there's no doubt about it.\pYou really have completed the HOENN\nregion's POKéDEX.\pThat's more than just impressive.\pI have a gift for you.\pConsider it my show of appreciation\nfor the fantastic work you've done.\pMy gift is a rare POKéMON only found\nin another region!\pYou can have any one of these\nthree POKéMON!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_OhYourBagsFull {
    format("Oh? Your BAG's full.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_GrassyPatchWaiting2 {
    format("PROF. BIRCH: But listen.\nYou've become the CHAMPION,\lbut your POKéMON journey isn't over.\pThere is no end to the road\nthat is POKéMON.\pSomewhere, there is a grassy patch\nthat's waiting for you!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_HeyYourBagsFull {
    format("Hey, your BAG's full.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayUpgradeSoCool {
    format("MAY: Eheheh!\pIt's so cool that even my POKéDEX\nis getting updated!\pIt's because you went out and caught\nso many POKéMON, {PLAYER}{KUN}!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayHaveYouGoneToBattleFrontier {
    format("MAY: Oh, hi, {PLAYER}{KUN}!\nHave you gone to that place,\lthe BATTLE FRONTIER?$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BirchIsntOneForDeskWork {
    format("The PROF isn't one for doing desk work.\nHe's the type of person who would\lrather go outside and experience\lthings than read about them here.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayWhatNextImStayingHere {
    format("MAY: {PLAYER}{KUN}, after this…\nWhat are you going to do?\pAre you going to keep battling\nand sharpening your skills?\pOr are you going to try filling\nthe NATIONAL POKéDEX?\pI'm staying here to help the PROF.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_CanHaveAnyOneOfRarePokemon {
    format("PROF. BIRCH: These are rare POKéMON\nonly found in another region!\pYou can have any one of these\nthree POKéMON!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BetterLeaveOthersAlone {
    format("You received the promised POKéMON.\nBetter leave the others alone.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_TakeYourTimeAllInvaluable {
    format("PROF. BIRCH: Take your time before\nyou decide.\pThey're all invaluable POKéMON.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_GrassyPatchWaiting {
    format("PROF. BIRCH: Listen, {PLAYER}{KUN}.\nYou've completed the HOENN POKéDEX,\lbut your POKéMON journey isn't over.\pThere is no end to the road\nthat is POKéMON.\pSomewhere, there is a grassy patch\nthat's waiting for you!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BrendanGotPokedexTooTakeThese {
    format("BRENDAN: Huh…\nSo you got a POKéDEX, too.\pWell then, here.\nI'll give you these.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_OtherRegionsUpgradeToNational {
    format("PROF. BIRCH: Now…\p{PLAYER}{KUN} and {RIVAL}, I've had the two\nof you help me study POKéMON.\pThanks to your help, new facts\nare coming to light.\pIt appears that in the HOENN region,\nthere are also POKéMON from other\lregions.\pIt goes to show how rich and varied\nthe natural environments of HOENN\lhappen to be.\pThat's why I think it's necessary for\nme to upgrade your POKéDEX to\lthe NATIONAL Mode.\pHere, let me see your POKéDEX units.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayWhereShouldIGoNext {
    format("MAY: I wonder where I should go look\nfor POKéMON next?$")
}

text LittlerootTown_ProfessorBirchsLab_Text_MayGotPokedexTooTakeThese {
    format("MAY: Oh, wow, {PLAYER}{KUN}!\nYou got a POKéDEX, too!\pThat's great! Just like me!\nI've got something for you, too!$")
}

text LittlerootTown_ProfessorBirchsLab_Text_DontBeThatWay {
    format("PROF. BIRCH: Oh, don't be that way.\nYou should go meet my kid.$")
}

text LittlerootTown_ProfessorBirchsLab_Text_BrendanTakeBreakFromFieldwork {
    format("BRENDAN: For the time being,\nI'm taking a break from fieldwork.\pI'll be helping out the PROF here\nfor a while.$")
}
