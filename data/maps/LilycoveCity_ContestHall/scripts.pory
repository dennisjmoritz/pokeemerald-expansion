text LilycoveCity_ContestHall_Text_SmartContestStage {
    format("SMARTNESS CONTEST STAGE BE IMPRESSED BY SMART POKéMON!")
}

text LilycoveCity_ContestHall_Text_CuteContestStage {
    format("CUTENESS CONTEST STAGE BE CHARMED BY CUTE POKéMON!")
}

text LilycoveCity_ContestHall_Text_BeautyContestStage {
    format("BEAUTY CONTEST STAGE BE ALLURED BY BEAUTIFUL POKéMON!")
}

text LilycoveCity_ContestHall_Text_WinBeautyContestMakesMeHappy {
    format("You know, if I win at a BEAUTY\nCONTEST, sure it makes me\lhappy. More than usual, anyway.$")
}

text LilycoveCity_ContestHall_Text_MyMonAppealSoMuchCuter {
    format("Everyone's POKéMON are very cute.\pHowever, if my POKéMON were to make\na cute appeal…\pI'm sure that it would be so much \ncuter than the others.$")
}

text LilycoveCity_ContestHall_Text_AreYouEnjoyingThisContest {
    format("JUDGE: Are you enjoying this CONTEST?\pCome back with three friends, and\nall of you may enter a CONTEST!$")
}

text LilycoveCity_ContestHall_Text_MyChildIsInContest {
    format("My child is in this CONTEST.$")
}

text LilycoveCity_ContestHall_Text_EveryPokemonPristineBeauty {
    format("JUDGE: Ah, every POKéMON here is\na model of pristine beauty!\pWhy, I almost forgot to score them!$")
}

text LilycoveCity_ContestHall_Text_InTheMiddleOfContest {
    format("MC: Uh-oh! Hello!\nWe're in the middle of a CONTEST!\pPlease enter at our registration\ncounter and come out, okay?$")
}

text LilycoveCity_ContestHall_Text_EnteredBunchOfContests {
    format("I've entered a bunch of CONTESTS,\nso I'm seeing how things work.\pIf you're in a COOLNESS CONTEST,\ncool moves go over as appeals.\pBut smart moves and cute moves\ndon't go over well, for instance.$")
}

text LilycoveCity_ContestHall_Text_ThatGirlThereIsCutest {
    format("I think that girl over there is\nthe cutest of the lot.\pWhat's that? They're judging\nPOKéMON by their looks?$")
}

text LilycoveCity_ContestHall_Text_PokemonLooksLikeYoungerMe {
    format("This pretty POKéMON looks just like\nme when I was younger.\pRight when I said that, my husband\nspewed the coffee he was drinking.\pDid I say something funny?$")
}

text LilycoveCity_ContestHall_Text_PokemonSmarterThanTrainers {
    format("I think the POKéMON look smarter\nthan their TRAINERS. By a lot.$")
}

text LilycoveCity_ContestHall_Text_OverdidGrooming {
    format("Waaaah!\pI brushed and groomed my POKéMON\ncarefully for this CONTEST…\pBut I overdid it…\nMy POKéMON's coat turned all scraggly…\pWhat should I do?$")
}

text LilycoveCity_ContestHall_Text_StillLoveSmartnessContests {
    format("When all's said and done, I still love\nSMARTNESS CONTESTS.\pThat intellectual green color…\nIt's so… So… Cool.$")
}

text LilycoveCity_ContestHall_Text_RaisedMonToBeSmart {
    format("I've spent many a year, and all my\nwisdom besides, raising this POKéMON\lto be smart.\pIt won't be easily bested by some\nyoung pup's POKéMON.\pMy dear wife, are you seeing this?$")
}

text LilycoveCity_ContestHall_Text_IsntThisPlaceHumongous {
    format("Whoa, isn't this place humongous!\pThe tension in the air… It's not\nlike a CONTEST hall in the sticks.$")
}

text LilycoveCity_ContestHall_Text_DontAppreciateCuteLeechLife {
    format("Oh, dear, no!\pMy darling ZUBAT's LEECH LIFE is so\ncute I kept using it over and over!\pBut these mean people don't appreciate\nit at all!$")
}

text LilycoveCity_ContestHall_Text_JudgeWontSeeAuroraBeam {
    format("This AURORA BEAM is so dazzling,\nthe JUDGE won't be able to see it.\pUh, wait a second…\nThat'll be meaningless, then!$")
}

text LilycoveCity_ContestHall_Text_PetalDanceIsMarvel {
    format("My POKéMON's PETAL DANCE is a marvel\nof elegance.\pI won't let anyone disturb its\nperformance.$")
}

text LilycoveCity_ContestHall_Text_EnteredWrongContest {
    format("Ayayayay…\nI entered the wrong CONTEST.\pI entered this tough POKéMON in\nthe SMARTNESS CONTEST…\pCome on, wow them with a smart-looking\nROCK SMASH.$")
}

text LilycoveCity_ContestHall_Text_EyesWillBeGluedToMyBeauty {
    format("A POKéMON this beautiful…\nThere isn't another one like it.\pEveryone's eyes will be glued to\nmy beauty.$")
}

text LilycoveCity_ContestHall_Text_AreYouEnteringBeautyContest {
    format("MC: Are you entering the BEAUTY\nCONTEST, too? Good luck!$")
}

text LilycoveCity_ContestHall_Text_GiveItBestSmartAppeal {
    format("MC: Okay, SMART POKéMON and their\nTRAINERS, are you ready?!\pGive it your best showing!\nLet's appeal!$")
}

text LilycoveCity_ContestHall_Text_SuchCharmingCuteAppeals {
    format("JUDGE: Oh, such charming and cute\nappeals!\pOh, my goodness! What a perfectly\nadorable WATER SPORT appeal!$")
}

text LilycoveCity_ContestHall_Text_YoureBeautifulGrandpa {
    format("Kiyaaah! You're beautiful, Grandpa!$")
}

text LilycoveCity_ContestHall_Text_AllSeemToUseDifferentMoves {
    format("Even when TRAINERS enter the same\nkind of POKéMON, they all seem to use\ldifferent moves for appeals.\pIt's just like the way people have\ndifferent styles for battling.$")
}

text LilycoveCity_ContestHall_Text_TodayWonSmartnessContest {
    format("This POKéMON won the BEAUTY CONTEST\nhere before.\pWell, guess what? Today, I made it\nwin a SMARTNESS CONTEST!\pMy abilities scare even me…$")
}

text LilycoveCity_ContestHall_Text_CantWinOnBeautyAlone {
    format("You can't always win on just beauty\nalone.\pYou have to groom your POKéMON so\nit's nice and glossy like mine.$")
}

text LilycoveCity_ContestHall_Text_GanderAtAllThosePrettyPokemon {
    format("Wahahahah!\pWill you take a gander at all those\npretty POKéMON!\lI just love this sort of glitz!$")
}

text LilycoveCity_ContestHall_Text_ManWhoWonEarlierHadPokeblocks {
    format("That young man who won earlier had\na whole bunch of different {POKEBLOCK}S.\pCan you win if you had that many\nof those things?$")
}

text LilycoveCity_ContestHall_Text_NeverWonBattleButContest {
    format("My POKéMON has never won in a battle,\nbut put it in a CONTEST and look out!$")
}

text LilycoveCity_ContestHall_Text_MyAzurillWasDistracted {
    format("Oh, no… My sweet AZURILL was\ndistracted by another POKéMON.$")
}

text LilycoveCity_ContestHall_Text_WantCuteMonOfMyOwn {
    format("Ohh, seeing all these cute POKéMON,\nthey make we want to get my own!\pI'm going to go catch some!$")
}

text LilycoveCity_ContestHall_Text_IfMonPullsSmartMoveNext {
    format("There it is!\pIf my POKéMON pulls a smart move next,\nthe audience's excitement will peak!$")
}
