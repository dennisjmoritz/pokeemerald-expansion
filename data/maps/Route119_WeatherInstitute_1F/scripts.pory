text Route119_WeatherInstitute_1F_Text_WhatWereAquasUpTo {
    format("Hello!\nWe've been saved by your actions!\pWhat I don't understand is what on\nearth the AQUAS were up to.$")
}

text Route119_WeatherInstitute_1F_Text_ProfStudyingRain {
    format("The PROFESSOR loves rain.\nThat's a fact.\pBut if it keeps raining, people will be in\ntrouble. That's another fact.\pAnd thus, the PROFESSOR is studying\nif the rain can be put to good use.$")
}
