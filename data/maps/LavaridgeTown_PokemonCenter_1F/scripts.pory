mapscripts LavaridgeTown_PokemonCenter_1F_MapScripts {
}

script LavaridgeTown_PokemonCenter_1F_EventScript_Gentleman {
    msgbox(LavaridgeTown_PokemonCenter_1F_Text_TrainersShouldRestToo, MSGBOX_NPC)
    end
}

script LavaridgeTown_PokemonCenter_1F_EventScript_Nurse {
    end
}

script LavaridgeTown_PokemonCenter_1F_EventScript_Woman {
    msgbox(LavaridgeTown_PokemonCenter_1F_Text_TrainersPokemonSpendTimeTogether, MSGBOX_NPC)
    end
}

script LavaridgeTown_PokemonCenter_1F_EventScript_Youngster {
    msgbox(LavaridgeTown_PokemonCenter_1F_Text_HotSpringCanInvigorate, MSGBOX_NPC)
    end
}

text LavaridgeTown_PokemonCenter_1F_Text_TrainersShouldRestToo {
    format("Hohoho! Hey, kid, you can reach\nthe hot springs from here.\pIf POKéMON are getting rest, so too\nshould their TRAINERS.$")
}

text LavaridgeTown_PokemonCenter_1F_Text_TrainersPokemonSpendTimeTogether {
    format("I think POKéMON get closer to their\nTRAINERS if they spend time together.\pThe longer the better.\nThat's what I think.$")
}

text LavaridgeTown_PokemonCenter_1F_Text_HotSpringCanInvigorate {
    format("It's sort of magical how just sitting\nin a hot-spring pool can invigorate.\pI wish I could let my POKéMON\nsoak, too.$")
}
