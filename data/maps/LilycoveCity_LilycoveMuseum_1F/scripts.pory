text LilycoveCity_LilycoveMuseum_Text_BirdPokemonSculptureReplica {
    format("It's a replica of a famous sculpture.\p It depicts an ancient BIRD POKéMON.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_PaintingOfGrassPokemon {
    format("It's a painting of GRASS POKéMON swaying in a breeze.\p They appear to be enjoying the wind's gentle caress.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_StoneTabletWithAncientText {
    format("It's a huge stone tablet inscribed with POKéMON and dense text in the\l small characters of an ancient,\l unreadable language.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_BigPokeBallCarvedFromStone {
    format("It's a big POKé BALL carved from a black stone.\p It was apparently used in festivals in the olden days.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_VeryOldPainting {
    format("It's a very old painting. The paint is peeling here and there.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_OddLandscapeFantasticScenery {
    format("It's an odd landscape with bizarre and fantastic scenery.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_PaintingOfBerries {
    format("It's a delicious-looking painting of BERRIES.\p This painting could make you hungry!")
}

text LilycoveCity_LilycoveMuseum_1F_Text_PaintingOfBeautifulWoman {
    format("It's a painting of a beautiful, smiling woman with a POKéMON on her lap.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_PaintingOfLegendaryPokemon {
    format("It's a painting of a legendary POKéMON from long ago.\p The artist painted this from imagination.")
}

text LilycoveCity_LilycoveMuseum_1F_Text_ThisMuseumIsInspiration {
    format("This ART MUSEUM… Well, you could\nsee many fantastic paintings.\pAnd the CURATOR is a wonderful person.\pAmong artists like myself, this MUSEUM\nis an inspiration.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_ExcellentCanYouComeWithMe {
    format("Ah, excellent!\nYou do like paintings!\pThen, may I ask you to come with me?$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_ThisPokemonIsAdorable {
    format("This POKéMON is adorable!\nJust like our little boy!$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_NotDisturbYouTakeYourTime {
    format("Ah, then let me not disturb you.\nPlease, do take your time.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_HonoredYoudVisitInSpiteOfThat {
    format("I see…\pI'm honored that you would visit\nus in spite of that.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_HeardMuseumGotNewPaintings {
    format("I'd heard that this ART MUSEUM got\nin some new paintings.\pSo, naturally I hurried over.\pAre the new paintings up on\nthe second floor?$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_ThisLadyIsPretty {
    format("This lady is pretty!\nShe's like Mommy!$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_MuseumTouristDestination {
    format("The ART MUSEUM has become a favorite\ntourist destination.\pIt's great for LILYCOVE…\nNo, great for the HOENN region!\pThis is what I've heard--a lone TRAINER\nprocured all the paintings upstairs.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_WelcomeToLilycoveMuseum {
    format("Welcome to LILYCOVE MUSEUM.\pPlease take the time to enjoy our\ncollection of fantastic artwork\lfeaturing POKéMON.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_CuratorHasBeenCheerful {
    format("Lately, the CURATOR has been\nunusually cheerful.\pI bet something good happened for him.\nDefinitely.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_AimToSeeGreatPaintings {
    format("I aim to see many great paintings\nhere and learn from them.\pI have this dream of one day having\nmy artwork exhibited here.$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_HaveYouAnInterestInPaintings {
    format("Oh? I do believe that you seem to\nbe a POKéMON TRAINER.\pHave you an interest in paintings,\ntoo?$")
}

text LilycoveCity_LilycoveMuseum_1F_Text_MustntForgetLoveForFineArts {
    format("Battling with POKéMON is fun,\nI'll grant you that.\pBut one mustn't forget our love for\nthe fine arts.$")
}
