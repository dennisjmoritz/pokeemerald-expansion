text Route133_Text_BeckDefeat {
    format("You… You're stunningly cool!")
}

text Route133_Text_BeckIntro {
    format("I came all the way out here with my BIRD POKéMON.")
}

text Route133_Text_BeckPostBattle {
    format("I'd like to go back to FORTREE, but I've grown to like this place, too.")
}

text Route133_Text_ConorDefeat {
    format("You have a firm sense of purpose.")
}

text Route133_Text_ConorIntro {
    format("Young people are too happy to go with the flow. They're without direction.")
}

text Route133_Text_ConorPostBattle {
    format("Don't let others lead you astray. Don't lose direction as you grow older.")
}

text Route133_Text_DebraDefeat {
    format("Another loss…")
}

text Route133_Text_DebraIntro {
    format("I've led a life of woe and misery… I've been cast away, and this is where I've drifted…")
}

text Route133_Text_DebraPostBattle {
    format("A life adrift… I don't want it anymore!")
}

text Route133_Text_FranklinDefeat {
    format("Strong! Too much so!")
}

text Route133_Text_FranklinIntro {
    format("Did the currents carry you here, too? This must have been fated. Let's battle!")
}

text Route133_Text_FranklinPostBattle {
    format("It's just my luck that a tough TRAINER like you would drift here… I must be cursed…")
}

text Route133_Text_LindaDefeat {
    format("No! Please!")
}

text Route133_Text_LindaIntro {
    format("Welcome! I've been expecting you!")
}

text Route133_Text_LindaPostBattle {
    format("A strong child TRAINER… That's so annoying!")
}

text Route133_Text_MollieDefeat {
    format("I may have lost thousands of times, but a loss still stings.")
}

text Route133_Text_MollieIntro {
    format("I must have battled thousands of times. I've lost count.")
}

text Route133_Text_MolliePostBattle {
    format("Keep at this, youngster. So you can become like my husband and me.")
}

text Route133_Text_WarrenDefeat {
    format("Darn it! My way is still too slack!")
}

text Route133_Text_WarrenIntro {
    format("I want to win like everyone else, but I won't raise POKéMON like everyone else.")
}

text Route133_Text_WarrenPostBattle {
    format("It's way more fun to do things the way I want than to be like everybody else. I mean, that's obvious!")
}