text JaggedPass_Text_DianaRegister {
    format("Will you ever be back in this area?\nIf you do return, I'd like a rematch.$")
}

text JaggedPass_Text_EthanRegister {
    format("When I get more used to this bumpiness,\nI'll be sure to win!\pCan you register me in your POKéNAV?$")
}

text JaggedPass_Text_GoWhereverYouWant {
    format("Okay, oh-kay!\nI admit it--you're strong!\pDon't worry about me.\nGo wherever you want!$")
}

text JaggedPass_Text_DianaPostRematch {
    format("I'll forget about losing and just\nenjoy this bumpy hike.$")
}

text JaggedPass_Text_EthanPostRematch {
    format("I should get an ACRO BIKE from RYDEL\nin MAUVILLE CITY…$")
}

text JaggedPass_Text_BoulderShakingInResponseToEmblem {
    format("Oh! This boulder is shaking in response\nto the MAGMA EMBLEM!$")
}
