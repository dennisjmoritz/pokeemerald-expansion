EcruteakCity_Text_SmithNPC1::
# 55 "data/maps/EcruteakCity/scripts.pory"
	.string "I've been expecting you, Mr. Anderson.$"

EcruteakCity_Text_SmithNPC2::
# 64 "data/maps/EcruteakCity/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

EcruteakCity_Text_SmithNPC3::
# 73 "data/maps/EcruteakCity/scripts.pory"
	.string "Never send a human to do a machine's\n"
	.string "job.$"

EcruteakCity_Text_SmithNPC4::
# 82 "data/maps/EcruteakCity/scripts.pory"
	.string "You hear that, Mr. Anderson? That is the\n"
	.string "sound of inevitability.$"

EcruteakCity_Text_SmithNPC5::
# 91 "data/maps/EcruteakCity/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

EcruteakCity_Text_SmithNPC6::
# 100 "data/maps/EcruteakCity/scripts.pory"
	.string "It's the question that drives us, Neo.$"

EcruteakCity_Text_SmithNPC7::
# 109 "data/maps/EcruteakCity/scripts.pory"
	.string "Unfortunately, no one can be told what\n"
	.string "the Matrix is.$"

EcruteakCity_Text_SmithNPC8::
# 118 "data/maps/EcruteakCity/scripts.pory"
	.string "I know kung fu.$"

EcruteakCity_Text_SmithNPC9::
# 127 "data/maps/EcruteakCity/scripts.pory"
	.string "Dodge this.$"

EcruteakCity_Text_SmithNPC10::
# 136 "data/maps/EcruteakCity/scripts.pory"
	.string "Choice is an illusion created between\n"
	.string "those with power and those without.$"

EcruteakCity_Text_SmithNPC11::
# 145 "data/maps/EcruteakCity/scripts.pory"
	.string "Hope is an illusion, Mr. Anderson.$"
