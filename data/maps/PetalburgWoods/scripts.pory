text PetalburgWoods_Text_YoureLoadedWithItems {
    format("You're loaded with items.\nI can't give you this GREAT BALL.$")
}

text PetalburgWoods_Text_NotAOneToBeFound {
    format("Hmmm…\nNot a one to be found…$")
}

text PetalburgWoods_Text_StayOutOfTallGrass {
    format("Yo, there!\nYour POKéMON doing okay?\pIf your POKéMON are weak and you want\nto avoid battles, you should stay out\lof tall grass.$")
}

text PetalburgWoods_Text_HiddenItemsExplanation {
    format("Sometimes, there are things on the\nground even if you can't see them.\pThat's why I always check where I'm\nwalking.$")
}

text PetalburgWoods_Text_IveBeenTrainingHard {
    format("You get to be popular if you have\nstrong POKéMON, right?\lSo, I've been training hard.$")
}

text PetalburgWoods_Text_IWantRematch2 {
    format("I want a rematch when my BUG \nPOKéMON grow up!\pI'm registering you in my POKéNAV!$")
}

text PetalburgWoods_Text_YouveGotSomeNerve {
    format("Grrr… You've got some nerve\nmeddling with TEAM AQUA!\lCome on and battle me again!\pI wish I could say that, but I'm out of\nPOKéMON…\pAnd, hey, we of TEAM AQUA are also\nafter something in RUSTBORO.\pI'll let you go today!$")
}

text PetalburgWoods_Text_IWantRematch1 {
    format("I want a rematch when my BUG\nPOKéMON grow up!\pI'm registering you in my POKéNAV!$")
}

text PetalburgWoods_Text_TeamAquaAfterSomethingInRustboro {
    format("Didn't that TEAM AQUA thug say\nthey were after something in\lRUSTBORO, too?$")
}

text PetalburgWoods_Text_MiracleSeedExplanation {
    format("It's a MIRACLE SEED.\nIf a POKéMON holds that item, its\lGRASS-type moves become stronger.\pBesides MIRACLE SEED, I think there are\nother convenient items for POKéMON\lto hold.$")
}
