text ViridianCity_Text_CatchMonsForEasierBattles {
    format("TRAINER TIPS\p Catch POKéMON and expand your collection.\p The more you have, the easier it is to battle.")
}

text ViridianCity_Text_CitySign {
    format("VIRIDIAN CITY The Eternally Green Paradise")
}

text ViridianCity_Text_GymSign {
    format("VIRIDIAN CITY POKéMON GYM")
}

text ViridianCity_Text_GymDoorsAreLocked {
    format("VIRIDIAN GYM's doors are locked…")
}

text ViridianCity_Text_MovesLimitedByPP {
    format("TRAINER TIPS\p The battle moves of POKéMON are limited by their POWER POINTS, PP.\p To replenish PP, rest your tired POKéMON at a POKéMON CENTER.")
}

text ViridianCity_Text_CanCarryMonsAnywhere {
    format("Those POKé BALLS at your waist!\nYou have POKéMON, don't you?\pIt's great that you can carry and\nuse POKéMON anytime, anywhere.$")
}

text ViridianCity_Text_WantToKnowAboutCaterpillarMons {
    format("You want to know about the two\nkinds of caterpillar POKéMON?$")
}
