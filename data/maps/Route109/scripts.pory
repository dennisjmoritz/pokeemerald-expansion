text Route109_Text_TrainerTipsSign {
    format("TRAINER TIPS\p POKéMON at the same level may not always have identical stats.\p POKéMON raised by TRAINERS are said to grow stronger than wild POKéMON.")
}

text Route109_Text_SeashoreHouseSign {
    format("SEASHORE HOUSE\p “May hot battles rage on hot sands! The place for hot TRAINERS!”")
}


text Route109_Text_AliceDefeated {
    format("Ouch, ouch, ouch!")
}

text Route109_Text_AliceIntro {
    format("Are you properly protected against the sun?")
}

text Route109_Text_AlicePostBattle {
    format("Cheeks are the most prone to burning!")
}

text Route109_Text_AustinaDefeated {
    format("Did I lose because I have an inner tube?")
}

text Route109_Text_AustinaIntro {
    format("I can't swim without my inner tube, but I won't lose at POKéMON!")
}

text Route109_Text_AustinaPostBattle {
    format("My inner tube is a fashion item. I can't be seen without it.")
}

text Route109_Text_CarterDefeated {
    format("This dude just lost one…")
}

text Route109_Text_CarterIntro {
    format("Wahahah! This dude's going to catch himself a big one!")
}

text Route109_Text_CarterPostBattle {
    format("This dude thinks you're a big one. No, you're a big-one-to-be!")
}

text Route109_Text_ChandlerDefeated {
    format("Oh, oh! Too bad!")
}

text Route109_Text_ChandlerIntro {
    format("Tadaah! See? My inner tube's round!")
}

text Route109_Text_ChandlerPostBattle {
    format("After I showed you my round inner tube, too…")
}

text Route109_Text_DavidDefeated {
    format("Aiyah! Flubbed out!")
}

text Route109_Text_DavidIntro {
    format("Hiyah! Look at my chiseled abs! This is what you call “cut”!")
}

text Route109_Text_DavidPostBattle {
    format("Hiyah!\pMy sculpted abs have nothing to do with POKéMON battles!")
}

text Route109_Text_EdmondDefeated {
    format("Urp… Ooooooohhhhhh… Urrrrpppp…")
}

text Route109_Text_EdmondIntro {
    format("Urrrrppp… Battle? With me?")
}

text Route109_Text_EdmondPostBattle {
    format("I'm usually stronger than this! I'm just seasick as a dog!\pI'm a SAILOR, but…")
}

text Route109_Text_ElijahDefeated {
    format("I'm cool even in defeat, hey?")
}

text Route109_Text_ElijahIntro {
    format("For a guy as macho as me, this kind of POKéMON is the perfect match!")
}

text Route109_Text_ElijahPostBattle {
    format("For a guy as macho as me, a port is the perfect setting!\pI guess I'll head for SLATEPORT.")
}

text Route109_Text_GwenDefeated {
    format("Oh, you're strong.")
}

text Route109_Text_GwenIntro {
    format("Hi, big TRAINER. Will you battle with me?")
}

text Route109_Text_GwenPostBattle {
    format("How did you get to be so strong?")
}

text Route109_Text_HaileyDefeated {
    format("I thought so! I didn't think we could win.")
}

text Route109_Text_HaileyIntro {
    format("I can't swim, so I'm pretending to swim.")
}

text Route109_Text_HaileyPostBattle {
    format("When I learn how to swim, I think my POKéMON will become tougher.")
}

text Route109_Text_HueyDefeated {
    format("You're the best!")
}

text Route109_Text_HueyIntro {
    format("I've laid anchor in ports around the world, but SLATEPORT's the best.")
}

text Route109_Text_HueyPostBattle {
    format("In the best port was the best TRAINER…")
}

text Route109_Text_LolaDefeated {
    format("Mommy!")
}

text Route109_Text_LolaIntro {
    format("Doesn't a beach umbrella look like a giant flower?")
}

text Route109_Text_LolaPostBattle {
    format("If you look at the beach from the sky, it looks like a big flower garden!")
}

text Route109_Text_RickyDefeated {
    format("Groan…")
}

text Route109_Text_RickyIntro {
    format("I'm thirsty… I could go for a SODA POP at the SEASHORE HOUSE…")
}

text Route109_Text_RickyPostBattle {
    format("I'm getting famished… My inner tube looks like a giant doughnut…")
}

text Route109_Text_ChillAtMyPapasSpot {
    format("Yo, TRAINERS!\nWhether you're hot to trot,\lor cool cat not,\lchill at my papa's spot!$")
}

text Route109_Text_ZigzagoonPicksUpLitter {
    format("The water around these parts is clean.\pBut, I get my ZIGZAGOON to pick up\nlitter from the shoreline at times.\pDirty water becomes rain and joins our\nrivers, which we drink from…\pIf we pollute the sea, it all comes\nback to haunt us eventually.$")
}

text Route109_Text_BrineySailToDewfordQuestion {
    format("MR. BRINEY: I thought you're supposed\nto deliver the DEVON GOODS.\pWould you like to sail back to\nDEWFORD, then?$")
}

text Route109_Text_WereGoingToMakeBigCastle {
    format("We're going to get all the sand from\nthe beach and make a big castle!\pAnd then we're going to be a king and\nqueen.\pWe'll let you be a servant.$")
}

text Route109_Text_BrineyTellMeWhenYouNeedToSail {
    format("MR. BRINEY: You just tell me whenever\nyou need to set sail again!$")
}

text Route109_Text_BrineyDeliverDevonGoods {
    format("MR. BRINEY: Then you go on and deliver\nthe DEVON GOODS. I'll be waiting.$")
}

text Route109_Text_BrineyDewfordItIs {
    format("MR. BRINEY: DEWFORD it is, then!\pAnchors aweigh!\nPEEKO, we're setting sail, my darling!$")
}

text Route109_Text_SandCastleTakingLongTime {
    format("Our sand castle's taking a long time\nto make.$")
}

text Route109_Text_LittleKidsDartAround {
    format("Little kids can dart around so quickly…\pYou don't dare take your eyes off them\nfor an instant. It's very taxing.\pMine are with my POKéMON, so they\nshould be okay, but…$")
}

text Route109_Text_ZigzagoonCry {
    format("ZIGZAGOON: Guguu?$")
}

text Route109_Text_MelPostBattle {
    format("MEL: Um, PAUL, are you angry with me? Please don't be angry.")
}

text Route109_Text_PaulPostBattle {
    format("PAUL: Well, don't tell anyone that we're here. This is just our private world of two!")
}
