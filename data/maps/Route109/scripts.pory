text Route109_Text_TrainerTipsSign {
    format("TRAINER TIPS\p POKéMON at the same level may not always have identical stats.\p POKéMON raised by TRAINERS are said to grow stronger than wild POKéMON.")
}

text Route109_Text_SeashoreHouseSign {
    format("SEASHORE HOUSE\p “May hot battles rage on hot sands! The place for hot TRAINERS!”")
}


text Route109_Text_AliceDefeated {
    "Ouch, ouch, ouch!"
}

text Route109_Text_AliceIntro {
    "Are you properly protected against\nthe sun?"
}

text Route109_Text_AlicePostBattle {
    "Cheeks are the most prone to burning!"
}

text Route109_Text_AustinaDefeated {
    "Did I lose because I have an inner\ntube?"
}

text Route109_Text_AustinaIntro {
    "I can't swim without my inner tube,\nbut I won't lose at POKéMON!"
}

text Route109_Text_AustinaPostBattle {
    "My inner tube is a fashion item.\nI can't be seen without it."
}

text Route109_Text_CarterDefeated {
    "This dude just lost one…"
}

text Route109_Text_CarterIntro {
    "Wahahah! This dude's going to catch\nhimself a big one!"
}

text Route109_Text_CarterPostBattle {
    "This dude thinks you're a big one.\nNo, you're a big-one-to-be!"
}

text Route109_Text_ChandlerDefeated {
    "Oh, oh!\nToo bad!"
}

text Route109_Text_ChandlerIntro {
    "Tadaah! See?\nMy inner tube's round!"
}

text Route109_Text_ChandlerPostBattle {
    "After I showed you my round inner\ntube, too…"
}

text Route109_Text_DavidDefeated {
    "Aiyah!\nFlubbed out!"
}

text Route109_Text_DavidIntro {
    "Hiyah! Look at my chiseled abs!\nThis is what you call “cut”!"
}

text Route109_Text_DavidPostBattle {
    "Hiyah!\pMy sculpted abs have nothing to do\nwith POKéMON battles!"
}

text Route109_Text_EdmondDefeated {
    "Urp… Ooooooohhhhhh…\nUrrrrpppp…"
}

text Route109_Text_EdmondIntro {
    "Urrrrppp…\nBattle? With me?"
}

text Route109_Text_EdmondPostBattle {
    "I'm usually stronger than this!\nI'm just seasick as a dog!\pI'm a SAILOR, but…"
}

text Route109_Text_ElijahDefeated {
    "I'm cool even in defeat, hey?"
}

text Route109_Text_ElijahIntro {
    "For a guy as macho as me, this kind\nof POKéMON is the perfect match!"
}

text Route109_Text_ElijahPostBattle {
    "For a guy as macho as me, a port\nis the perfect setting!\pI guess I'll head for SLATEPORT."
}

text Route109_Text_GwenDefeated {
    "Oh, you're strong."
}

text Route109_Text_GwenIntro {
    "Hi, big TRAINER.\nWill you battle with me?"
}

text Route109_Text_GwenPostBattle {
    "How did you get to be so strong?"
}

text Route109_Text_HaileyDefeated {
    "I thought so!\nI didn't think we could win."
}

text Route109_Text_HaileyIntro {
    "I can't swim, so I'm pretending\nto swim."
}

text Route109_Text_HaileyPostBattle {
    "When I learn how to swim, I think\nmy POKéMON will become tougher."
}

text Route109_Text_HueyDefeated {
    "You're the best!"
}

text Route109_Text_HueyIntro {
    "I've laid anchor in ports around\nthe world, but SLATEPORT's the best."
}

text Route109_Text_HueyPostBattle {
    "In the best port was the best\nTRAINER…"
}

text Route109_Text_LolaDefeated {
    "Mommy!"
}

text Route109_Text_LolaIntro {
    "Doesn't a beach umbrella look like\na giant flower?"
}

text Route109_Text_LolaPostBattle {
    "If you look at the beach from the sky,\nit looks like a big flower garden!"
}

text Route109_Text_RickyDefeated {
    "Groan…"
}

text Route109_Text_RickyIntro {
    "I'm thirsty… I could go for a SODA POP\nat the SEASHORE HOUSE…"
}

text Route109_Text_RickyPostBattle {
    "I'm getting famished… My inner tube\nlooks like a giant doughnut…"
}