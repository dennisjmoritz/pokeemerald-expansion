}

script Route109_EventScript_Alice {
    trainerbattle_double(TRAINER_ALICE, Route109_Text_AliceIntro, Route109_Text_AliceDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route109_Text_AlicePostBattle)
}

