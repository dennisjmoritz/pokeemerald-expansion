text Route116_Text_TrainerTipsBagHasPockets {
    format("TRAINER TIPS\p Your BAG has several POCKETS.\p Items you obtain are automatically placed in the appropriate POCKETS.\p No TRAINER can afford to be without a BAG of their own.")
}

text Route116_Text_RusturfTunnelSign {
    format("RUSTURF TUNNEL “Linking RUSTBORO and VERDANTURF\p “The tunnel project has been canceled.”")
}

text Route116_Text_TunnelersRestHouse {
    format("TUNNELER'S REST HOUSE")
}

text Route116_Text_TrainerTipsBToStopEvolution {
    format("TRAINER TIPS\p If you want to stop a POKéMON from evolving, press the B Button while it\l is trying to evolve.\l The startled POKéMON will stop.\p This is called an evolution cancel.")
}

text Route116_Text_RouteSignRustboro {
    format("ROUTE 116 {LEFT_ARROW} RUSTBORO CITY")
}


text Route116_Text_ClarkDefeat {
    format("Gasp… Gasp… Losing made me tired…")
}

text Route116_Text_ClarkIntro {
    format("If the tunnel doesn't go through, then I'll just go over the top.")
}

text Route116_Text_ClarkPostBattle {
    format("It's no big deal if there's no tunnel. To a HIKER, mountains are roads!")
}

text Route116_Text_DawsonDefeat {
    format("Oh, baby, say it isn't so!")
}

text Route116_Text_DawsonIntro {
    format("When you lay your eyes on my POKéMON's gorgeous fur, their beauty will render you helpless!")
}

text Route116_Text_DawsonPostBattle {
    format("Oh, no, no, no! You've mussed up my POKéMON's fur! You've ruined my hairdo, too! I'll have to call my stylist now!")
}

text Route116_Text_DevanDefeat {
    format("Aiyiyi! No contest at all!")
}

text Route116_Text_DevanIntro {
    format("We'll rock you hard!")
}

text Route116_Text_DevanPostBattle {
    format("I should try different POKéMON types, that's what I ought to do.")
}

text Route116_Text_JaniceDefeat {
    format("You're a notch above me…")
}

text Route116_Text_JaniceIntro {
    format("Let me teach you how strong my adorable POKéMON is!")
}

text Route116_Text_JanicePostBattle {
    format("POKéMON that possess cuteness and power, that's ideal, I think.")
}

text Route116_Text_JerryDefeat {
    format("I slacked off in school… That's why I lost.")
}

text Route116_Text_JerryIntro {
    format("We learn all sorts of things at the TRAINER'S SCHOOL.\pI want to test things out for real!")
}

text Route116_Text_JerryPostBattle {
    format("I'll have to redo some courses at the TRAINER'S SCHOOL. If I don't, ROXANNE will be steamed.")
}

text Route116_Text_JoeyDefeat {
    format("Ouch! A scrape! I have to put on a bandage!")
}

text Route116_Text_JoeyIntro {
    format("My POKéMON rule! Check them out!")
}

text Route116_Text_JoeyPostBattle {
    format("Bandages are signs of toughness! I've got another one!")
}

text Route116_Text_JohnsonDefeat {
    format("That was fun even though I lost.")
}

text Route116_Text_JohnsonIntro {
    format("It's a dead end up here. I'm bored, so can we battle?")
}

text Route116_Text_JohnsonPostBattle {
    format("Want to stay here and keep me company?")
}

text Route116_Text_JoseDefeat {
    format("I lost! I thought I had you!")
}

text Route116_Text_JoseIntro {
    format("My BUG POKéMON are tough! Let's battle!")
}

text Route116_Text_JosePostBattle {
    format("BUG POKéMON evolve quickly. So they get strong quickly, too.")
}

text Route116_Text_KarenDefeat {
    format("I'm in shock--I lost?")
}

text Route116_Text_KarenIntro {
    format("I study at school, and I study on the way home, too!")
}

text Route116_Text_KarenPostBattle {
    format("Awww, I'll never become an elegant TRAINER like ROXANNE this way!")
}

text Route116_Text_SarahDefeat {
    format("Oh, my goodness. This is a new experience for me.")
}

text Route116_Text_SarahIntro {
    format("Just so you know, I've never once been bested by anyone at anything.")
}

text Route116_Text_SarahPostBattle {
    format("My life of luxury affords me all that I could possibly desire.\pHowever, when it comes to POKéMON, my wealth has no meaning.")
}

text Route116_Text_DiggingTunnelWhenGoonOrderedMeOut {
    format("Nnn… Roar!\nWhat's going on?\pI was digging the tunnel without any\ntools when some goon ordered me out!\pThat tunnel's filled with POKéMON\nthat react badly to loud noises.\lThey could cause an uproar.\pThat's why we stopped using heavy\nequipment for tunneling…\pI'm worried that the goon will do\nsomething stupid and startle the\lPOKéMON into an uproar.$")
}

text Route116_Text_TokenOfAppreciation {
    format("As a token of our appreciation for\nyour delivering our package, I have\la gift of a new kind of POKé BALL\lfor our most wonderful TRAINER!$")
}

text Route116_Text_BagIsJamPacked {
    format("Your BAG is jam-packed.\nI can't give you this REPEAT BALL.$")
}

text Route116_Text_ScoundrelMadeOffWithPeeko {
    format("Ohhh, what am I to do?\pWe were on our walk, PEEKO and I, when\nwe were jumped by an odd thug…\pThe scoundrel made off with my\ndarling PEEKO!\pWrrrooooooaaaar! PEEKO!$")
}

text Route116_Text_NotWhatImLookingForMaybeTheyArentHere {
    format("Hmm…\nThese are BLACKGLASSES.\lThey're not what I'm looking for…\pMaybe my glasses aren't around\nhere…$")
}

text Route116_Text_GoonHightailedItOutOfTunnel {
    format("Nnn… Roar!\pThat goofy goon hightailed it out of\nthe tunnel! I can go back to digging!$")
}

text Route116_Text_CanYouHelpMeFindGlasses {
    format("I dropped my glasses…\nCan you help me find them?$")
}

text Route116_Text_CantFindGlassesNotHere {
    format("Hmm…\nI can't find my glasses anywhere…\lMaybe they're not around here…$")
}
