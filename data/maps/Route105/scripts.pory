text Route105_Text_AndresDefeated {
    format("Yes… I am no good at battling…")
}

text Route105_Text_AndresIntro {
    format("I'm convinced that the sea keeps secrets from us.")
}

text Route105_Text_AndresPostBattle {
    format("I'm sure there are many secrets to be discovered in the world's seas.\pI mean to find them all!")
}

text Route105_Text_BeverlyDefeated {
    format("I'm floating…")
}

text Route105_Text_BeverlyIntro {
    format("My body feels lighter in the water. It's as if I've gotten slimmer!")
}

text Route105_Text_DominikDefeated {
    format("I lost… Now I'm feeling blue…")
}

text Route105_Text_DominikIntro {
    format("Swimming the deep blue sea… It feels the greatest!")
}

text Route105_Text_DominikPostBattle {
    format("Why is the sea blue?\pI learned about that at the MUSEUM in SLATEPORT, but I forgot.")
}

text Route105_Text_FosterDefeated {
    format("I was thinking too much about that rock, while my POKéMON remained weak…")
}

text Route105_Text_FosterIntro {
    format("There's supposed to be a mystical rock around here. Do you know anything about it?")
}

text Route105_Text_FosterPostBattle {
    format("I can spend hours and hours staring at a nice rock without growing bored.")
}

text Route105_Text_ImaniDefeated {
    format("I lost while I was lounging!")
}

text Route105_Text_ImaniIntro {
    format("The blue, blue sky… The vast sea… It's so peaceful…")
}

text Route105_Text_ImaniPostBattle {
    format("I want to be told I'm relaxing to be with. Giggle.")
}

text Route105_Text_JosueDefeated {
    format("I lost because I battled at sea.")
}

text Route105_Text_JosueIntro {
    format("I'm exhausted from swimming. I'm just not used to it.\pI need a battle for a change of pace!")
}

text Route105_Text_JosuePostBattle {
    format("Yeah, for me, the sky is a much better match than the sea.")
}

text Route105_Text_LuisDefeated {
    format("Glub… Glub…")
}

text Route105_Text_LuisIntro {
    format("Whew! I was worried that a kid was drowning when I saw you.\pYou seem to be okay, so what do you say to a battle?")
}

text Route105_Text_LuisPostBattle {
    format("If you are drowning, the signal is to wave one arm toward the beach.")
}

text Route105_Text_PostBattle {
    format("Your body weight is reduced to just\none tenth in the water.\pThat would make me…\nWhoops! I'm not telling you my weight!")
}