    trainerbattle_double(TRAINER_BEVERLY, Route105_Text_BeverlyIntro, Route105_Text_BeverlyDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route105_Text_PostBattle)
}

