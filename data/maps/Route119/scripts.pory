text Route119_Text_WeatherInstitute {
    format("WEATHER INSTITUTE")
}

text Route119_Text_RouteSignFortree {
    format("ROUTE 119 {RIGHT_ARROW} FORTREE CITY")
}

text Route119_Text_TrainerTipsDecoration {
    format("TRAINER TIPS\p Up to sixteen decorations and furniture items can be placed in\l a SECRET BASE.\p Pick your favorite items and create your very own SECRET BASE exactly the\l way you want.")
}


text Route119_Text_BrentDefeat {
    format("Whoopsie! I lost!")
}

text Route119_Text_BrentIntro {
    format("We're the MIMIC CIRCLE! We MIMIC what you do!")
}

text Route119_Text_BrentPostBattle {
    format("What's so good about mimicry?\pFufufu… You'll never understand…")
}

text Route119_Text_CatherineDefeat {
    format("Accidents happen when you're not prepared!")
}

text Route119_Text_CatherineIntro {
    format("Oh? Look at you.\pFor someone on an adventure, you're traveling awfully light.")
}

text Route119_Text_CatherinePostBattle {
    format("You're traveling light but you have everything you need.\pYou're on top of things mentally and physically, too.")
}

text Route119_Text_ChrisDefeat {
    format("I don't have a clue about what it takes to win.")
}

text Route119_Text_ChrisIntro {
    format("You spoke to me… So you want to challenge me!\pSure! I'll try out the POKéMON I caught while SURFING!")
}

text Route119_Text_ChrisPostBattle {
    format("Go for a SURF on my POKéMON…\pThen fish off its back…\pIt's an indescribably luxuriant moment!")
}

text Route119_Text_DaytonDefeat {
    format("You're pretty amazing! Hohoho!")
}

text Route119_Text_DaytonIntro {
    format("Hohoho! I like kid TRAINERS! Let's have a good one!")
}

text Route119_Text_DaytonPostBattle {
    format("Hohoho! I'll try emulating the pep of kid TRAINERS like you!")
}

text Route119_Text_DonaldDefeat {
    format("I wish we'd never met…")
}

text Route119_Text_DonaldIntro {
    format("So, we finally meet! My BUG POKéMON will keep you company!")
}

text Route119_Text_DonaldPostBattle {
    format("I want to MIMIC you some more. Can you hurry up and move?")
}

text Route119_Text_DougDefeat {
    format("Whoop, that was a great match!")
}

text Route119_Text_DougIntro {
    format("Yep, you've finally caught me! Or were you trying to avoid me?")
}

text Route119_Text_DougPostBattle {
    format("We're the MIMIC CIRCLE! I hope you enjoyed our performance.")
}

text Route119_Text_FabianDefeat {
    format("You showed me who's the boss! We'll have to take the loss, oh, no!")
}

text Route119_Text_FabianIntro {
    format("Hit me with a power chord! Victory is mine! It's our time to shine, whoa, yeah!")
}

text Route119_Text_FabianPostBattle {
    format("Hit me with another power chord! Leave me alone! Your win you have to atone!")
}

text Route119_Text_GregDefeat {
    format("You're pretty strong!")
}

text Route119_Text_GregIntro {
    format("You don't know who I am, do you?\pBut, I also don't know you. So, we'll battle!")
}

text Route119_Text_GregPostBattle {
    format("Until you go away somewhere, we'll keep on mimicking your every move.")
}

text Route119_Text_HideoDefeat {
    format("I bow to your superiority.")
}

text Route119_Text_HideoIntro {
    format("To hide a tree, use a forest!")
}

text Route119_Text_HideoPostBattle {
    format("To hide a tree, use a forest! To hide a POKéMON, use a POKéMON!\pThere is no deep, hidden meaning to that.")
}

text Route119_Text_HughDefeat {
    format("Down and out!")
}

text Route119_Text_HughIntro {
    format("The vast sky holds untold promise!\pNothing can compare to the sheer exhilaration of flight!")
}

text Route119_Text_HughPostBattle {
    format("My BIRD POKéMON made my dreams of flying come true!")
}

text Route119_Text_JacksonDefeat {
    format("I didn't have enough POKéMON know-how…")
}

text Route119_Text_JacksonIntro {
    format("Who has the knowledge and the technique for survival?\pPOKéMON RANGERS, that's who!")
}

text Route119_Text_JacksonPostBattle {
    format("To break away from civilization and awaken the wild spirit within!\pThat's our vision.")
}

text Route119_Text_KentDefeat {
    format("I give up!")
}

text Route119_Text_KentIntro {
    format("The MIMIC CIRCLE was formed by people who like to MIMIC.\pA battle starts the instant we meet!")
}

text Route119_Text_KentPostBattle {
    format("Won't you join our MIMIC CIRCLE?")
}

text Route119_Text_PhilDefeat {
    format("We lacked potential…")
}

text Route119_Text_PhilIntro {
    format("I'll show you the true potential of me and my BIRD POKéMON!")
}

text Route119_Text_PhilPostBattle {
    format("Ever since I was a little kid, I always admired BIRD POKéMON…")
}

text Route119_Text_RachelDefeat {
    format("Oh, but… That's not fair.")
}

text Route119_Text_RachelIntro {
    format("Wherever and whenever I may be, I always have my parasol in hand.")
}

text Route119_Text_RachelPostBattle {
    format("You're asking if my parasol is heavy? Your BAG is filled with more junk than I ever carry around.")
}

text Route119_Text_TakashiDefeat {
    format("You're surprisingly good!")
}

text Route119_Text_TakashiIntro {
    format("If you're not on your guard, you're in for some pain!")
}

text Route119_Text_TakashiPostBattle {
    format("My surprise attack ended in failure…")
}

text Route119_Text_TaylorDefeat {
    format("But if you win, I lose…")
}

text Route119_Text_TaylorIntro {
    format("If you step forward, we step forward.\pIf you turn right, we turn, too…")
}

text Route119_Text_TaylorPostBattle {
    format("I can't MIMIC you winning the match. That's just impossible… It's burning me up…")
}

text Route119_Text_YasuDefeat {
    format("I admit defeat!")
}

text Route119_Text_YasuIntro {
    format("To lurk in shadows, and live in darkness… That is my destiny.\pI emerge to challenge you!")
}

text Route119_Text_YasuPostBattle {
    format("Those defeated in battle withdraw quietly back into the shadows. That, too, is destiny…")
}

text Route119_Text_BrendanIllGiveYouThis {
    format("BRENDAN: I'd say you're good enough\nto search for POKéMON anywhere.\pHere, I'll give you this.\nTry it out.$")
}

text Route119_Text_BrendanIntro {
    format("BRENDAN: {PLAYER}! So this is where\nyou've been looking for POKéMON?\pLet me see how good you got.\nI'll test you!\pNow!\nIt's a battle, so battle!$")
}

text Route119_Text_StayAwayFromWeatherInstitute {
    format("We're standing lookout here.\pHey, you! Stay away from the WEATHER\nINSTITUTE. It's not safe.$")
}

text Route119_Text_ThoughtFlyByCatchingBirdMons {
    format("I thought you FLY by catching a whole\nflock of BIRD POKéMON, and then\lhanging on to them somehow.\pBut it turns out there's an HM move\ncalled FLY!\pI wish I'd known about that a long\ntime ago…$")
}

text Route119_Text_TallGrassSnaresBikeTires {
    format("Tch…\nIt's a no-go…\pThe tall grass snares BIKE tires.\nThere's no way you can cycle here.$")
}

text Route119_Text_DontGoNearWeatherInstitute {
    format("Lookout duty is surprisingly boring.\pHey, you! Please don't go near the\nWEATHER INSTITUTE.$")
}

text Route119_Text_CanYourMonMakeSecretBase {
    format("Can your POKéMON use its SECRET POWER\non a big pile of grass and make a\lSECRET BASE?$")
}

text Route119_Text_MayPresentForYou {
    format("MAY: But I had absolutely nothing to\nworry about! Keep it up!\pAnd, here! I have a present for you.$")
}

text Route119_Text_MayIntro {
    format("MAY: {PLAYER}{KUN}!\nWhere were you? I was looking for you!\pHow much stronger have you gotten?\nLet me check for you!\pReady with your POKéMON?\nOf course you are! Go!$")
}
