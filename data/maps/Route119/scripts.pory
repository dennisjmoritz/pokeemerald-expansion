text Route119_Text_WeatherInstitute {
    format("WEATHER INSTITUTE")
}

text Route119_Text_RouteSignFortree {
    format("ROUTE 119 {RIGHT_ARROW} FORTREE CITY")
}

text Route119_Text_TrainerTipsDecoration {
    format("TRAINER TIPS\p Up to sixteen decorations and furniture items can be placed in\l a SECRET BASE.\p Pick your favorite items and create your very own SECRET BASE exactly the\l way you want.")
}


text Route119_Text_BrentDefeat {
    "Whoopsie!\nI lost!"
}

text Route119_Text_BrentIntro {
    "We're the MIMIC CIRCLE!\nWe MIMIC what you do!"
}

text Route119_Text_BrentPostBattle {
    "What's so good about mimicry?\pFufufu…\nYou'll never understand…"
}

text Route119_Text_CatherineDefeat {
    "Accidents happen when you're not\nprepared!"
}

text Route119_Text_CatherineIntro {
    "Oh? Look at you.\pFor someone on an adventure,\nyou're traveling awfully light."
}

text Route119_Text_CatherinePostBattle {
    "You're traveling light but you have\neverything you need.\pYou're on top of things mentally and\nphysically, too."
}

text Route119_Text_ChrisDefeat {
    "I don't have a clue about what it\ntakes to win."
}

text Route119_Text_ChrisIntro {
    "You spoke to me…\nSo you want to challenge me!\pSure! I'll try out the POKéMON I caught\nwhile SURFING!"
}

text Route119_Text_ChrisPostBattle {
    "Go for a SURF on my POKéMON…\pThen fish off its back…\pIt's an indescribably luxuriant moment!"
}

text Route119_Text_DaytonDefeat {
    "You're pretty amazing!\nHohoho!"
}

text Route119_Text_DaytonIntro {
    "Hohoho!\nI like kid TRAINERS!\nLet's have a good one!"
}

text Route119_Text_DaytonPostBattle {
    "Hohoho!\nI'll try emulating the pep of kid\nTRAINERS like you!"
}

text Route119_Text_DonaldDefeat {
    "I wish we'd never met…"
}

text Route119_Text_DonaldIntro {
    "So, we finally meet!\nMy BUG POKéMON will keep you company!"
}

text Route119_Text_DonaldPostBattle {
    "I want to MIMIC you some more.\nCan you hurry up and move?"
}

text Route119_Text_DougDefeat {
    "Whoop, that was a great match!"
}

text Route119_Text_DougIntro {
    "Yep, you've finally caught me!\nOr were you trying to avoid me?"
}

text Route119_Text_DougPostBattle {
    "We're the MIMIC CIRCLE!\nI hope you enjoyed our performance."
}

text Route119_Text_FabianDefeat {
    "You showed me who's the boss!\nWe'll have to take the loss, oh, no!"
}

text Route119_Text_FabianIntro {
    "Hit me with a power chord!\nVictory is mine!\nIt's our time to shine, whoa, yeah!"
}

text Route119_Text_FabianPostBattle {
    "Hit me with another power chord!\nLeave me alone!\nYour win you have to atone!"
}

text Route119_Text_GregDefeat {
    "You're pretty strong!"
}

text Route119_Text_GregIntro {
    "You don't know who I am, do you?\pBut, I also don't know you.\nSo, we'll battle!"
}

text Route119_Text_GregPostBattle {
    "Until you go away somewhere, we'll\nkeep on mimicking your every move."
}

text Route119_Text_HideoDefeat {
    "I bow to your superiority."
}

text Route119_Text_HideoIntro {
    "To hide a tree, use a forest!"
}

text Route119_Text_HideoPostBattle {
    "To hide a tree, use a forest!\nTo hide a POKéMON, use a POKéMON!\pThere is no deep, hidden meaning\nto that."
}

text Route119_Text_HughDefeat {
    "Down and out!"
}

text Route119_Text_HughIntro {
    "The vast sky holds untold promise!\pNothing can compare to the sheer\nexhilaration of flight!"
}

text Route119_Text_HughPostBattle {
    "My BIRD POKéMON made my dreams of\nflying come true!"
}

text Route119_Text_JacksonDefeat {
    "I didn't have enough POKéMON\nknow-how…"
}

text Route119_Text_JacksonIntro {
    "Who has the knowledge and\nthe technique for survival?\pPOKéMON RANGERS, that's who!"
}

text Route119_Text_JacksonPostBattle {
    "To break away from civilization and\nawaken the wild spirit within!\pThat's our vision."
}

text Route119_Text_KentDefeat {
    "I give up!"
}

text Route119_Text_KentIntro {
    "The MIMIC CIRCLE was formed by people\nwho like to MIMIC.\pA battle starts the instant we meet!"
}

text Route119_Text_KentPostBattle {
    "Won't you join our MIMIC CIRCLE?"
}

text Route119_Text_PhilDefeat {
    "We lacked potential…"
}

text Route119_Text_PhilIntro {
    "I'll show you the true potential of me\nand my BIRD POKéMON!"
}

text Route119_Text_PhilPostBattle {
    "Ever since I was a little kid, I always\nadmired BIRD POKéMON…"
}

text Route119_Text_RachelDefeat {
    "Oh, but…\nThat's not fair."
}

text Route119_Text_RachelIntro {
    "Wherever and whenever I may be,\nI always have my parasol in hand."
}

text Route119_Text_RachelPostBattle {
    "You're asking if my parasol is heavy?\nYour BAG is filled with more junk than\nI ever carry around."
}

text Route119_Text_TakashiDefeat {
    "You're surprisingly good!"
}

text Route119_Text_TakashiIntro {
    "If you're not on your guard,\nyou're in for some pain!"
}

text Route119_Text_TakashiPostBattle {
    "My surprise attack ended in\nfailure…"
}

text Route119_Text_TaylorDefeat {
    "But if you win, I lose…"
}

text Route119_Text_TaylorIntro {
    "If you step forward, we step forward.\pIf you turn right, we turn, too…"
}

text Route119_Text_TaylorPostBattle {
    "I can't MIMIC you winning the match.\nThat's just impossible…\nIt's burning me up…"
}

text Route119_Text_YasuDefeat {
    "I admit defeat!"
}

text Route119_Text_YasuIntro {
    "To lurk in shadows, and live in\ndarkness… That is my destiny.\pI emerge to challenge you!"
}

text Route119_Text_YasuPostBattle {
    "Those defeated in battle withdraw\nquietly back into the shadows.\nThat, too, is destiny…"
}