text FourIsland_Mart_Text_IcefallCaveIsFrigid {
    format("The SEVII ISLANDS are in a warm\nregion overall.\pBut there is one exception you\nneed to know about.\pThe ICEFALL CAVE is frigid because\nof the POKéMON that live in it.$")
}
