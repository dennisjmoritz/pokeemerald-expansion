text Route110_Text_MauvilleCitySign {
    format("ROUTE 110 {UP_ARROW} MAUVILLE CITY")
}

text Route110_Text_TrainerTipsPrlzSleep {
    format("TRAINER TIPS\p The foe can be made helpless by paralyzing it or causing it to sleep.\p It is an important technique for POKéMON battles.")
}

text Route110_Text_TrickHouseSign {
    format("“Three steps {RIGHT_ARROW} and two steps {UP_ARROW} to reach the wondrous TRICK HOUSE.”")
}

text Route110_Text_BestRecord {
    format("THE BEST RECORD TO DATE…\p No. of collisions: {STR_VAR_1}\p Elapsed time: {STR_VAR_2}")
}

text Route110_Text_AquaWasHere {
    format("“TEAM AQUA was here!”\p Someone painted that onto this sign, but then someone else painted over it.\p “TEAM MAGMA rules!” is what it says now.")
}

text Route110_Text_CyclingRoadSign {
    format("SEASIDE CYCLING ROAD")
}

text Route110_Text_SlateportCitySign {
    format("ROUTE 110 {DOWN_ARROW} SLATEPORT CITY")
}

text Route110_Text_SeasideParkingSign {
    format("SEASIDE PARKING")
}

text Route110_Text_TrainerTipsRegisterItems {
    format("TRAINER TIPS\p The items in the BAG can be reorganized by pressing SELECT.")
}

text Route110_Text_Route103Sign {
    format("ROUTE 110 {LEFT_ARROW} ROUTE 103")
}
