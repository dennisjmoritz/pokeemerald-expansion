text Route110_Text_MauvilleCitySign {
    format("ROUTE 110 {UP_ARROW} MAUVILLE CITY")
}

text Route110_Text_TrainerTipsPrlzSleep {
    format("TRAINER TIPS\p The foe can be made helpless by paralyzing it or causing it to sleep.\p It is an important technique for POKéMON battles.")
}

text Route110_Text_TrickHouseSign {
    format("“Three steps {RIGHT_ARROW} and two steps {UP_ARROW} to reach the wondrous TRICK HOUSE.”")
}

text Route110_Text_BestRecord {
    format("THE BEST RECORD TO DATE…\p No. of collisions: {STR_VAR_1}\p Elapsed time: {STR_VAR_2}")
}

text Route110_Text_AquaWasHere {
    format("“TEAM AQUA was here!”\p Someone painted that onto this sign, but then someone else painted over it.\p “TEAM MAGMA rules!” is what it says now.")
}

text Route110_Text_CyclingRoadSign {
    format("SEASIDE CYCLING ROAD")
}

text Route110_Text_SlateportCitySign {
    format("ROUTE 110 {DOWN_ARROW} SLATEPORT CITY")
}

text Route110_Text_SeasideParkingSign {
    format("SEASIDE PARKING")
}

text Route110_Text_TrainerTipsRegisterItems {
    format("TRAINER TIPS\p The items in the BAG can be reorganized by pressing SELECT.")
}

text Route110_Text_Route103Sign {
    format("ROUTE 110 {LEFT_ARROW} ROUTE 103")
}


text Route110_Text_AbigailDefeated {
    format("POKéMON battles are hard, too!")
}

text Route110_Text_AbigailIntro {
    format("The triathlon is hard in the extreme.\pYou have to complete the three events of swimming, cycling, and running.")
}

text Route110_Text_AbigailPostBattle {
    format("I'm exhausted, so I need a break. It's important to get proper rest.")
}

text Route110_Text_AlyssaDefeated {
    format("Oops! I ended up losing!")
}

text Route110_Text_AlyssaIntro {
    format("I fell off CYCLING ROAD…\pI'll get over my embarrassment by battling with you!")
}

text Route110_Text_AlyssaPostBattle {
    format("Falling… Losing… This is so humiliating for me!")
}

text Route110_Text_AnthonyDefeated {
    format("Crash and burn!")
}

text Route110_Text_AnthonyIntro {
    format("Yo, you! Can you keep up with my speed?")
}

text Route110_Text_AnthonyPostBattle {
    format("Speed alone won't let me win at POKéMON. I need to reconsider this…")
}

text Route110_Text_BenjaminDefeated {
    format("I shouldn't panic during POKéMON battles…")
}

text Route110_Text_BenjaminIntro {
    format("Don't panic if your BIKE's going fast!")
}

text Route110_Text_BenjaminPostBattle {
    format("There's no need to panic or stress. Take it easy. There's plenty of time.")
}

text Route110_Text_DaleDefeated {
    format("I lost! Drat!")
}

text Route110_Text_DaleIntro {
    format("Hey! Don't sneak up behind me like that!")
}

text Route110_Text_DalePostBattle {
    format("Fishing is all about concentration. You have to focus on the floater.")
}

text Route110_Text_EdwardDefeated {
    format("I failed to prophesize my own demise!")
}

text Route110_Text_EdwardIntro {
    format("I have foreseen your intentions! I cannot possibly lose!")
}

text Route110_Text_EdwardPostBattle {
    format("I see your future…\pHmm… I see a shining light…")
}

text Route110_Text_EdwinDefeated {
    format("I wanted to complete my collection…")
}

text Route110_Text_EdwinIntro {
    format("Could I see your POKéMON? Just one look, please?")
}

text Route110_Text_EdwinPostBattle {
    format("When I see a POKéMON that I don't know, my passion as a collector is ignited!")
}

text Route110_Text_IsabelDefeated {
    format("Oh, dear, this won't do.")
}

text Route110_Text_IsabelIntro {
    format("Ahahaha! I would go anywhere to show off my delightful POKéMON.")
}

text Route110_Text_IsabelPostBattle {
    format("Rather than battling, perhaps I should show off my POKéMON at the FAN CLUB.")
}

text Route110_Text_JaclynDefeated {
    format("I wondrously lost!")
}

text Route110_Text_JaclynIntro {
    format("Ahahahaha! I'll dazzle you with my wonders!")
}

text Route110_Text_JaclynPostBattle {
    format("You managed to win only because it was a wonder! Yes, a wonder! Don't think you can win all the time!")
}

text Route110_Text_JacobDefeated {
    format("Whoa! My brakes failed!")
}

text Route110_Text_JacobIntro {
    format("Whoa! Watch it! I guess you're not used to BIKE racing.")
}

text Route110_Text_JacobPostBattle {
    format("Flat tires and brake problems can cause serious injury! Inspect your BIKE for problems!")
}

text Route110_Text_JasmineDefeated {
    format("I'm worried about muscle cramps…")
}

text Route110_Text_JasmineIntro {
    format("I've been riding without stopping. My thighs are like rocks!")
}

text Route110_Text_JasminePostBattle {
    format("Oh, you have some GYM BADGES? No wonder you're so strong!")
}

text Route110_Text_JosephDefeated {
    format("You got into the groove all right…")
}

text Route110_Text_JosephIntro {
    format("Okay! Full-throttle time! If you can't groove, you get left behind!")
}

text Route110_Text_JosephPostBattle {
    format("This isn't going to bring me down! Losing has made me a better man!")
}

text Route110_Text_KalebDefeated {
    format("Have you no compassion or pity?")
}

text Route110_Text_KalebIntro {
    format("When cute POKéMON help each other… You won't see a more adorable sight!")
}

text Route110_Text_KalebPostBattle {
    format("Okay, okay, you've done the best you could, my pretties.")
}

text Route110_Text_TimmyDefeated {
    format("Being cool isn't enough to win…")
}

text Route110_Text_TimmyIntro {
    format("I found some cool POKéMON in the grass around here!")
}

text Route110_Text_TimmyPostBattle {
    format("It's hard to battle with POKéMON you just caught.")
}

text Route110_Text_ChallengeReactionWorst {
    format("…I am aghast…\pYou're perhaps not cut out for this\nunfortunate cycling business.\pYou ought to give serious thought to\nreturning that BIKE to RYDEL.$")
}

text Route110_Text_WalkOnTheLowRoad {
    format("I don't have a BIKE, so I'll take\na leisurely walk on the low road.$")
}

text Route110_Text_ChallengeReactionBest {
    format("Bravo! Splendid showing!\pYour love of cycling comes from deep\nwithin your heart.\lYou've shaken me to my very soul!$")
}

text Route110_Text_WeCantTalkAboutAquaActivities {
    format("TEAM AQUA's activities…\nWe can't talk about them yet.$")
}

text Route110_Text_BrendanTakeThis {
    format("BRENDAN: {PLAYER}, you've trained\nwithout me noticing…\pGood enough!\nHere, take this.$")
}

text Route110_Text_HairStreamsBehindMe {
    format("How do you like the way my raven-\ncolored hair streams behind me?\pI grew my hair out just for that.$")
}

text Route110_Text_ChallengeReactionGood {
    format("Your technique is remarkable.\pI suggest you speed up a bit while\nstill avoiding collisions.$")
}

text Route110_Text_AquaActionsBringSmiles {
    format("TEAM AQUA's actions should bring\nsmiles to people's faces!$")
}

text Route110_Text_TwoRoads {
    format("The two roads, one above, one below…\pA road each for people and POKéMON.\nPerhaps that is right and fair.$")
}

text Route110_Text_KickUpARuckus {
    format("I want to get going to SLATEPORT and\nkick up a ruckus!$")
}

text Route110_Text_RatedForNumberOfCollisions {
    format("This is CYCLING ROAD.\pIf you were to ride from MAUVILLE to\nSLATEPORT on a MACH BIKE, you would\lbe rated for the number of collisions\land your total time.$")
}

text Route110_Text_MayLetsBattle {
    format("MAY: Hi, {PLAYER}{KUN}, long time no see!\pWhile I was searching for other\nPOKéMON, my POKéMON grew stronger.\pSo…\nHow about a little battle?$")
}

text Route110_Text_AcroBikesDoNotQualify {
    format("On this CYCLING ROAD, those riding\nMACH BIKES are rated for their number\lof collisions and their total times.\pACRO BIKES do not qualify for rating.\nThey are easy to turn, so it's not fair.$")
}

text Route110_Text_BrendanLetsBattle {
    format("BRENDAN: Hey, {PLAYER}.\nSo this is where you were.\lHow's it going?\pHave you been raising your POKéMON?\nI'll check for you.$")
}

text Route110_Text_MyFirstJobInAqua {
    format("This is my first job after joining\nTEAM AQUA. It's a little scary.$")
}

text Route110_Text_ChallengeReactionBad {
    format("My word… Your cycling skills border\non terrifying.\pMost certainly, you need much more\npractice riding.$")
}

text Route110_Text_RideBikeAtFullSpeed {
    format("Wouldn't it be great to ride a BIKE\nat full speed on CYCLING ROAD?$")
}

text Route110_Text_YouGotBikeFromRydel {
    format("Oh, hey, you got that BIKE from RYDEL!\pOh, it's glaringly obvious.\nIt says right on your bike…\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL…\nThat name's everywhere.\pYou should ride it around all over\nthe place--it's good advertising!$")
}

text Route110_Text_ChallengeReactionOk {
    format("I would consider you a work in\nprogress.\pStill, I hope you don't forget the\nsheer pleasure of cycling.$")
}

text Route110_Text_WhichShouldIChoose {
    format("Which should I choose?\pMake a beeline for MAUVILLE on\nCYCLING ROAD, or take the low road\land look for POKéMON?$")
}

text Route110_Text_CyclingChallengeResultSummary {
    format("Number of collisions:\n… … {STR_VAR_1}!\pTotal time:\n… … {STR_VAR_2}!$")
}

text Route110_Text_BikeTechniques {
    format("Learning techniques will make BIKE\nriding even more fun.\pThere are some places that you can\nreach only by using a BIKE technique.$")
}

text Route110_Text_MayTakeThis {
    format("MAY: {PLAYER}{KUN}, you've been busy\ntraining, too, haven't you?\pI think you deserve a reward!\nThis is from me!$")
}

text Route110_Text_ThereIsNoRecord {
    format("THE BEST RECORD TO DATE…\pNo one seems to have taken the\nchallenge. There is no record…$")
}
