text MtPyre_2F_Text_LukePostBattle {
    format("LUKE: Well, we lost but that's okay!\nI'm right here by your side.\lWe'll make it through this dare!$")
}

text MtPyre_2F_Text_DezPostBattle {
    format("DEZ: We're lovey-dovey, so we don't\ncare if we lose!$")
}

text MtPyre_2F_Text_TumbledFromFloorAbove {
    format("Ooch, ouch… There are holes in the\nground here and there.\pI didn't notice and took a tumble from\nthe floor above.$")
}

text MtPyre_2F_Text_MemoriesOfSkitty {
    format("Memories of my darling SKITTY…\nMy eyes overflow thinking about it.$")
}
