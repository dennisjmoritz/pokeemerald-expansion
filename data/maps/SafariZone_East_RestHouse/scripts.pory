    end
}


text SafariZone_East_Text_TiredFromAllTheFun {
    format("Whew!\nI'm tired from all the fun!$")
}

text SafariZone_East_Text_CaughtChanseyAllWorthwhile {
    format("I caught a CHANSEY!\pThat makes this all worthwhile.$")
}

text SafariZone_East_Text_HowManyDidYouCatch {
    format("How many did you catch?\nI'm bushed from the effort!$")
}
