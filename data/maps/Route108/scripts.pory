    trainerbattle_double(TRAINER_MATTHEW, Route108_Text_MatthewIntro, Route108_Text_MatthewDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route108_Text_MatthewPostBattle)
