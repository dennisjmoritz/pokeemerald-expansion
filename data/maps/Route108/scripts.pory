text Route108_Text_CarolinaDefeated {
    format("That wasn't cute at all.")
}

text Route108_Text_CarolinaIntro {
    format("I take huge pride in my POKéMON. We'll show you one speedy battle!")
}

text Route108_Text_CarolinaPostBattle {
    format("Since I'm at sea like this, I wouldn't mind putting on a pink, frilly swimsuit…")
}

text Route108_Text_CoryDefeated {
    format("Waaah! I lost! Waaah! Waaah!")
}

text Route108_Text_CoryIntro {
    format("I love WATER-type POKéMON. I love other POKéMON, too!")
}

text Route108_Text_CoryPostBattle {
    format("Shouting is good for me! It uplifts me!")
}

text Route108_Text_JeromeDefeated {
    format("I won't be able to swim the seven seas like this…")
}

text Route108_Text_JeromeIntro {
    format("My dream is to swim the world's seven seas!")
}

text Route108_Text_JeromePostBattle {
    format("Playing with marine POKéMON is one of the pleasures of swimming!")
}

text Route108_Text_MatthewDefeated {
    format("I'm sinking! Glub… Glub…")
}

text Route108_Text_MatthewIntro {
    format("Ahoy, there! Are you going out to the ABANDONED SHIP, too?")
}

text Route108_Text_MatthewPostBattle {
    format("Some people even go inside that ABANDONED SHIP.")
}

text Route108_Text_MissyDefeated {
    format("When I lose a battle, I get all stressed out!")
}

text Route108_Text_MissyIntro {
    format("I love the sea! I forget all my worries when I swim!")
}

text Route108_Text_MissyPostBattle {
    format("Work off your stress by swimming! It's so healthy!")
}

text Route108_Text_TaraDefeated {
    format("Oh, boo!")
}

text Route108_Text_TaraIntro {
    format("My liar of a boyfriend told me that I look great in a bikini…")
}

text Route108_Text_TaraPostBattle {
    format("Even if it's a lie, I love being told I look great… We girls are so complex…")
}