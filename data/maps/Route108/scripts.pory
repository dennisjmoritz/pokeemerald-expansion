mapscripts Route108_MapScripts {
}

script Route108_EventScript_Carolina {
    trainerbattle_double(TRAINER_CAROLINA, Route108_Text_CarolinaIntro, Route108_Text_CarolinaDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route108_Text_CarolinaPostBattle)
}

