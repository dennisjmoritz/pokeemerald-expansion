text Route112_Text_RouteSignLavaridge {
    format("ROUTE 112 {LEFT_ARROW} LAVARIDGE TOWN")
}

text Route112_Text_MtChimneyCableCarSign {
    format("MT. CHIMNEY CABLE CAR “A short walk {UP_ARROW} way!”")
}

text Route112_Text_MtChimneySign {
    format("MT. CHIMNEY\p “For LAVARIDGE TOWN or the summit, please take the CABLE CAR.”")
}


text Route112_Text_BriceDefeat {
    format("I lost! Hahahaha!")
}

text Route112_Text_BriceIntro {
    format("Hahahaha! How about we have a battle? You and me! Hahahaha!")
}

text Route112_Text_BricePostBattle {
    format("Hahahahaha! Something flew up my nose! Hahahaha-hatchoo!")
}

text Route112_Text_BryantDefeat {
    format("What a bumpy ride that was!")
}

text Route112_Text_BryantIntro {
    format("I caught hot POKéMON in FIERY PATH! Take a look!")
}

text Route112_Text_BryantPostBattle {
    format("I like the way you battle. It has a certain flair to it.")
}

text Route112_Text_CarolDefeat {
    format("Oh, you're so strong!")
}

text Route112_Text_CarolIntro {
    format("When you're out on a picnic, why, you simply have to sing! Come on, sing with me!")
}

text Route112_Text_CarolPostBattle {
    format("It doesn't matter if you're good or bad at singing or POKéMON.\pIf you have the most fun, you win!")
}

text Route112_Text_LarryDefeat {
    format("Waaaah!")
}

text Route112_Text_LarryIntro {
    format("I'm strong. I won't cry if I lose.")
}

text Route112_Text_LarryPostBattle {
    format("I'm not crying because I miss my mommy! Snivel…")
}

text Route112_Text_ShaylaDefeat {
    format("Oh, how strong you are! You've given me quite a shock!")
}

text Route112_Text_ShaylaIntro {
    format("Oh, aren't you an adorable TRAINER! Please, I need a romantic battle! I'm somewhat decent!")
}

text Route112_Text_ShaylaPostBattle {
    format("Are you busy right now? I was thinking that maybe we can have a rematch right now… But it's all right if you're busy.")
}

text Route112_Text_TrentDefeat {
    format("Ouch! My legs cramped up!")
}

text Route112_Text_TrentIntro {
    format("My legs are solid from pounding up and down the mountains.\pThey're not going to buckle easily, friend!")
}

text Route112_Text_TrentPostBattle {
    format("Try hiking, and I mean really pounding, on these mountain trails with a heavy pack weighing dozens of pounds.\pThat, my friend, will get your body into serious shape.")
}

text Route112_Text_NotEasyToGetBackToLavaridge {
    format("Eh, I'd like to get to MAUVILLE, but if\nI went down these ledges, it'd be no\leasy matter to get back to LAVARIDGE.$")
}

text Route112_Text_LeaderGoingToAwakenThing {
    format("Hey, man, is our leader really going\nto awaken that thing?$")
}
