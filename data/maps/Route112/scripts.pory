text Route112_Text_RouteSignLavaridge {
    format("ROUTE 112 {LEFT_ARROW} LAVARIDGE TOWN")
}

text Route112_Text_MtChimneyCableCarSign {
    format("MT. CHIMNEY CABLE CAR “A short walk {UP_ARROW} way!”")
}

text Route112_Text_MtChimneySign {
    format("MT. CHIMNEY\p “For LAVARIDGE TOWN or the summit, please take the CABLE CAR.”")
}


text Route112_Text_BriceDefeat {
    "I lost!\nHahahaha!"
}

text Route112_Text_BriceIntro {
    "Hahahaha!\nHow about we have a battle?\nYou and me!\nHahahaha!"
}

text Route112_Text_BricePostBattle {
    "Hahahahaha! Something flew up my nose!\nHahahaha-hatchoo!"
}

text Route112_Text_BryantDefeat {
    "What a bumpy ride that was!"
}

text Route112_Text_BryantIntro {
    "I caught hot POKéMON in FIERY PATH!\nTake a look!"
}

text Route112_Text_BryantPostBattle {
    "I like the way you battle.\nIt has a certain flair to it."
}

text Route112_Text_CarolDefeat {
    "Oh, you're so strong!"
}

text Route112_Text_CarolIntro {
    "When you're out on a picnic, why,\nyou simply have to sing!\nCome on, sing with me!"
}

text Route112_Text_CarolPostBattle {
    "It doesn't matter if you're good or bad\nat singing or POKéMON.\pIf you have the most fun, you win!"
}

text Route112_Text_LarryDefeat {
    "Waaaah!"
}

text Route112_Text_LarryIntro {
    "I'm strong.\nI won't cry if I lose."
}

text Route112_Text_LarryPostBattle {
    "I'm not crying because I miss my mommy!\nSnivel…"
}

text Route112_Text_ShaylaDefeat {
    "Oh, how strong you are!\nYou've given me quite a shock!"
}

text Route112_Text_ShaylaIntro {
    "Oh, aren't you an adorable TRAINER!\nPlease, I need a romantic battle!\nI'm somewhat decent!"
}

text Route112_Text_ShaylaPostBattle {
    "Are you busy right now?\nI was thinking that maybe we can have\na rematch right now…\nBut it's all right if you're busy."
}

text Route112_Text_TrentDefeat {
    "Ouch! My legs cramped up!"
}

text Route112_Text_TrentIntro {
    "My legs are solid from pounding up\nand down the mountains.\pThey're not going to buckle easily,\nfriend!"
}

text Route112_Text_TrentPostBattle {
    "Try hiking, and I mean really\npounding, on these mountain trails\nwith a heavy pack weighing dozens of\npounds.\pThat, my friend, will get your body\ninto serious shape."
}