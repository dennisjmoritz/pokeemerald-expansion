text RustboroCity_PokemonCenter_1F_Text_MaleAndFemalePokemon {
    format("Just like people, there are male and\nfemale POKéMON.\pBut no one seems to have any idea how\nthey're different.$")
}

text RustboroCity_PokemonCenter_1F_Text_PokemonHavePersonalities {
    format("My POKéMON has a NAIVE nature, and my\nfriend's has a JOLLY nature.\pIt's fascinating how POKéMON have\npersonalities!$")
}

text RustboroCity_PokemonCenter_1F_Text_HMCutNextDoor {
    format("The man next door gave me an HM!\pI used it to teach my POKéMON how to\nCUT down skinny trees.$")
}
