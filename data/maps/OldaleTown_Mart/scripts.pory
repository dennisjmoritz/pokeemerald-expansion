text OldaleTown_Mart_Text_ImGoingToBuyPokeBalls {
    format("I'm going to buy a bunch of POKé BALLS\nand catch a bunch of POKéMON!$")
}

text OldaleTown_Mart_Text_RestoreHPWithPotion {
    format("If a POKéMON gets hurt and loses its HP\nand faints, it won't be able to battle.\pTo prevent your POKéMON from fainting,\nrestore its HP with a POTION.$")
}
