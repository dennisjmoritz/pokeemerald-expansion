mapscripts RustboroCity_DevonCorp_3F_MapScripts {
}

script RustboroCity_DevonCorp_3F_EventScript_Employee {
    end
}

script RustboroCity_DevonCorp_3F_EventScript_MrStone {
    end
}

script RustboroCity_DevonCorp_3F_EventScript_RareRocksDisplay {
    msgbox(RustboroCity_DevonCorp_3F_Text_RareRocksDisplay, MSGBOX_SIGN)
    end
}


text RustboroCity_DevonCorp_3F_Text_RareRocksDisplay {
    format("It's a collection of rare rocks and stones assembled by the PRESIDENT.")
}

text RustboroCity_DevonCorp_3F_Text_ThankYouForDeliveringLetter {
    format("MR. STONE: You delivered my LETTER?\nThank you kindly!\pThis is my way of thanking you.\nIt should help you, a TRAINER.$")
}

text RustboroCity_DevonCorp_3F_Text_NotFamiliarWithTrends {
    format("MR. STONE: Since my youth, I've immersed\nmyself in work.\pConsequently, I'm not familiar with\ntrends and that sort of thing.\pBut do young people all want to be\nTRAINERS in the POKéMON LEAGUE?$")
}

text RustboroCity_DevonCorp_3F_Text_ThisIs3rdFloorWaitHere {
    format("This is the DEVON CORPORATION's\nthird floor.\pOur PRESIDENT's OFFICE is on\nthis floor.\pAnyway, I can't tell you how much I'm\ngrateful for what you've done.\pUm… By the way, that parcel\nyou got back for us…\pCould I get you to deliver that to\nthe SHIPYARD in SLATEPORT?\pIt would be awful if those robbers\ntried to take it again.\pUh… Hehehe, so, uh, could I count\non you to do that for me?\pOh, that's right.\nCould you wait here a second?$")
}

text RustboroCity_DevonCorp_3F_Text_RepeatAndTimerHugelyPopular {
    format("DEVON's new products, the REPEAT BALL\nand TIMER BALL, have become hugely\lpopular among TRAINERS.$")
}
