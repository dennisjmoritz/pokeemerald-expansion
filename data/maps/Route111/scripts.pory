text Route111_Text_TrainerHillSign {
    format("{RIGHT_ARROW} TRAINER HILL ENTRANCE\p “Scale the heights, you hot-blooded TRAINERS!”")
}

text Route111_Text_TrainerTipsSpAtkSpDef {
    format("TRAINER TIPS\p One of the indicators of a POKéMON's powerfulness is SP. ATK. It stands for\l “SPECIAL ATTACK.”\p Likewise, SP. DEF stands for “SPECIAL DEFENSE.”")
}

text Route111_Text_RouteSign112 {
    format("ROUTE 111 {LEFT_ARROW} ROUTE 112")
}

text Route111_Text_WinstrateHouseSign {
    format("“Our family's hearts beat as one!” THE WINSTRATE'S HOUSE")
}

text Route111_Text_OldLadysRestStopSign {
    format("OLD LADY'S REST STOP “Come in and rest your tired bones.”")
}

text Route111_Text_RouteSignMauville {
    format("ROUTE 111 {DOWN_ARROW} MAUVILLE CITY")
}

text Route111_Text_RouteSign113 {
    format("ROUTE 111 {LEFT_ARROW} ROUTE 113")
}


text Route111_Text_BeauDefeat {
    format("I can't win on spirit alone…")
}

text Route111_Text_BeauIntro {
    format("Wearing these GO-GOGGLES makes me feel like a superhero. Right now, nobody can beat me!")
}

text Route111_Text_BeauPostBattle {
    format("I'm going to be a real hero one day. I'm going to work harder to make me and my POKéMON stronger.")
}

text Route111_Text_BeckyDefeat {
    format("I came up short…")
}

text Route111_Text_BeckyIntro {
    format("I heard there are fossils to be found in the desert. Where could they be?")
}

text Route111_Text_BeckyPostBattle {
    format("If they can find fossils in the desert, it must have been a sea before.")
}

text Route111_Text_BiancaDefeat {
    format("Ooh lala! That's a lot to take!")
}

text Route111_Text_BiancaIntro {
    format("Did you come from MAUVILLE? Then you should be full of energy!")
}

text Route111_Text_BiancaPostBattle {
    format("This road here… You have quite a ways to travel.")
}

text Route111_Text_BrandenDefeat {
    format("Tch! I thought a sandwich would be enough of a bribe…")
}

text Route111_Text_BrandenIntro {
    format("I'll give you some of my sandwich if you'll lose.")
}

text Route111_Text_BrandenPostBattle {
    format("My SANDSHREW loves eating my sandwiches.")
}

text Route111_Text_BrookeDefeat {
    format("They didn't just look strong, they are strong!")
}

text Route111_Text_BrookeIntro {
    format("Oh, your POKéMON look like serious actors. I have to ask you for an engagement.")
}

text Route111_Text_BrookePostBattle {
    format("I thought I was raising my POKéMON diligently, but, oh no, there is still much to be done.")
}

text Route111_Text_BryanDefeat {
    format("Oh! Your strength! It is shrouded in mystery!")
}

text Route111_Text_BryanIntro {
    format("How tough are you? We shall expose that secret!")
}

text Route111_Text_BryanPostBattle {
    format("This desert hoards mysteries in its shifting sands!")
}

text Route111_Text_CeliaDefeat {
    format("Aww! I really shouldn't have come!")
}

text Route111_Text_CeliaIntro {
    format("I shouldn't have come to a place like this for a picnic!")
}

text Route111_Text_CeliaPostBattle {
    format("In a sandstorm like this, I can't set the places for a picnic even with my GO-GOGGLES on…")
}

text Route111_Text_CelinaDefeat {
    format("Oh… My… That was too much excitement.")
}

text Route111_Text_CelinaIntro {
    format("Show me how to put a little excitement into my life.")
}

text Route111_Text_CelinaPostBattle {
    format("My pulse is still racing. You're one fabulous TRAINER.")
}

text Route111_Text_DaisukeDefeat {
    format("Uncle! I give up!")
}

text Route111_Text_DaisukeIntro {
    format("To train myself, I challenge all whom I meet!")
}

text Route111_Text_DaisukePostBattle {
    format("All I can do is keep training until I can defeat strong TRAINERS such as yourself.")
}

text Route111_Text_DrewDefeat {
    format("I couldn't see what was happening at my sides because of the GO-GOGGLES.")
}

text Route111_Text_DrewIntro {
    format("Oh, hey! Those GO-GOGGLES suit you. But I think they look better on me.\pLet's decide who they look better on with a battle!")
}

text Route111_Text_DrewPostBattle {
    format("The GO-GOGGLES make it possible to get through sandstorms. That makes me happy!")
}

text Route111_Text_DustyDefeat {
    format("While I have searched for ruins, I've not searched for strong POKéMON.")
}

text Route111_Text_DustyIntro {
    format("For thirty years I have searched for ancient ruins! I am to be challenged?")
}

text Route111_Text_DustyPostBattle {
    format("For thirty years I have searched for ancient ruins!\pNo, wait, was that forty years? Which was it now?")
}

text Route111_Text_HaydenDefeat {
    format("Groan…")
}

text Route111_Text_HaydenIntro {
    format("When you're as famished as I am, there is no room for pity!")
}

text Route111_Text_HaydenPostBattle {
    format("My stomach is grumbling! Maybe I can grill some BERRIES…")
}

text Route111_Text_HeidiDefeat {
    format("Ohhh! You're mean!")
}

text Route111_Text_HeidiIntro {
    format("I'm having a picnic in the desert.\pYou can always find a TRAINER, so I can enjoy a battle here, too!")
}

text Route111_Text_HeidiPostBattle {
    format("When you're battling in a sandstorm, watch out for your POKéMON's HP.\pIt can faint if you don't keep an eye on it!")
}

text Route111_Text_IreneDefeat {
    format("Oh, you're disgustingly good!")
}

text Route111_Text_IreneIntro {
    format("I don't know where you're going, but would you like to battle?")
}

text Route111_Text_IrenePostBattle {
    format("I'm thinking that I should go to MT. CHIMNEY, but the view around here is very nice, too.")
}

text Route111_Text_TravisDefeat {
    format("My POKéMON lost its pep…")
}

text Route111_Text_TravisIntro {
    format("I'm full of pep! And my POKéMON is peppy, too!")
}

text Route111_Text_TravisPostBattle {
    format("When I see a TRAINER with a lot of pep, I can't help looking.")
}

text Route111_Text_TyronDefeat {
    format("Wait! Did you get a good look at my POKéMON?")
}

text Route111_Text_TyronIntro {
    format("This is my favorite kind of POKéMON!")
}

text Route111_Text_TyronPostBattle {
    format("When having a battle, I get a kick out of showing off my POKéMON.\pI bet everyone feels that way when they enter a battle!")
}

text Route111_Text_WiltonDefeat {
    format("I see, you've toughened them considerably.")
}

text Route111_Text_WiltonIntro {
    format("Show me how much you've toughened your POKéMON.")
}

text Route111_Text_WiltonPostBattle {
    format("POKéMON and TRAINERS learn much through battling.\pWhat's important is to never give up even if you lose.")
}

text Route111_Text_MirageTowerClearlyVisible {
    format("I see it!\nThe tower of sand!\pThe sand tower they called a mirage\nis clearly visible!\pBut it looks so fragile…\nIt could crumble away anytime…\pI want to go inside it, but I can't\nget my courage up for it…$")
}

text Route111_Text_ToughToKeepWinningUpTheRanks {
    format("If you don't raise your POKéMON some\nmore, it could be tough to keep winning\lup through the ranks.\pI've heard the POKéMON LEAGUE's\nELITE FOUR are far stronger than\lany GYM LEADER.$")
}

text Route111_Text_MauvilleUncleToldMeToTakeRockSmash {
    format("Oh, no!\pMy uncle in MAUVILLE told me to take\nROCK SMASH with me if I was going to\lROUTE 111!\pMy uncle? He lives across from\nthe bike shop in MAUVILLE.$")
}

text Route111_Text_MirageTowerHasntBeenSeenSince {
    format("Since I spoke to you, the tower of sand\nhasn't been seen.\pPerhaps it really was\nthe MIRAGE TOWER…$")
}

text Route111_Text_BattleOurFamily {
    format("Hello! I take it you're a traveler.\pHow's this? What do you say to taking\non our family of four in a series of\lPOKéMON battles?$")
}

text Route111_Text_WinstrateFamilyDestroyedMe {
    format("I challenged the WINSTRATE family,\nbut four matches in a row is tough\lgoing… They destroyed me.$")
}

text Route111_Text_VictorIntro {
    format("That's the spirit! I like you!$")
}

text Route111_Text_ThatWasShockingSandRainedDown {
    format("Whoa…\nThat was shocking.\pSand rained down in chunks all of\na sudden.\pWhat was it like inside?\nWere there sandy ghosts and such?$")
}

text Route111_Text_RootFossilDisappeared {
    format("The ROOT FOSSIL disappeared into\nthe sand…$")
}
