text Route111_Text_TrainerHillSign {
    format("{RIGHT_ARROW} TRAINER HILL ENTRANCE\p “Scale the heights, you hot-blooded TRAINERS!”")
}

text Route111_Text_TrainerTipsSpAtkSpDef {
    format("TRAINER TIPS\p One of the indicators of a POKéMON's powerfulness is SP. ATK. It stands for\l “SPECIAL ATTACK.”\p Likewise, SP. DEF stands for “SPECIAL DEFENSE.”")
}

text Route111_Text_RouteSign112 {
    format("ROUTE 111 {LEFT_ARROW} ROUTE 112")
}

text Route111_Text_WinstrateHouseSign {
    format("“Our family's hearts beat as one!” THE WINSTRATE'S HOUSE")
}

text Route111_Text_OldLadysRestStopSign {
    format("OLD LADY'S REST STOP “Come in and rest your tired bones.”")
}

text Route111_Text_RouteSignMauville {
    format("ROUTE 111 {DOWN_ARROW} MAUVILLE CITY")
}

text Route111_Text_RouteSign113 {
