text MossdeepCity_Gym_Text_ExplainCalmMind {
    format("TATE: That TM04 contains…\nLIZA: CALM MIND!\pTATE: It raises SP. ATK and…\nLIZA: It raises SP. DEF!\pTATE: It's a move that's perfect…\nLIZA: For PSYCHIC POKéMON!\p… … … … … …$")
}

text MossdeepCity_Gym_Text_TateAndLizaPostRematch {
    format("TATE: You can knock us down,\nbut we'll never stay down!\pLIZA: Because the two of us,\nwe always support each other!$")
}

text MossdeepCity_Gym_Text_GymStatue {
    format("MOSSDEEP CITY POKéMON GYM$")
}

text MossdeepCity_Gym_Text_GymStatueCertified {
    format("MOSSDEEP CITY POKéMON GYM\pLIZA AND TATE'S CERTIFIED TRAINERS:\n{PLAYER}$")
}

text MossdeepCity_Gym_Text_GymGuidePostVictory {
    format("Wow, you're astounding!\nYou're one great TRAINER!$")
}
