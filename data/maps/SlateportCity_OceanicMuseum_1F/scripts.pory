text SlateportCity_OceanicMuseum_1F_Text_WhirlpoolExperiment {
    format("A blue fluid is spiraling inside a glass vessel.\p “This is an experiment to create a WHIRLPOOL artificially using wind.”")
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact1 {
    format("“OCEANIC MINIFACT 1 Why is seawater blue?\p “Light is composed of many colors.\p “When light passes through water, most kinds of light lose color.\p “However, blue light retains its color, making the sea appear blue.”")
}

text SlateportCity_OceanicMuseum_1F_Text_WaterfallExperiment {
    format("A red ball is bobbing up and down inside a glass vessel.\p “This is an experiment simulating a WATERFALL using the ball's buoyancy.”")
}

text SlateportCity_OceanicMuseum_1F_Text_DepthMeasuringMachine {
    format("A strange machine is rotating under a glass dome.\p Maybe it's for measuring the depth of something…")
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact3 {
    format("“OCEANIC MINIFACT 3 Which is bigger? The sea or land?\p “The sea covers about 70% of the planet, and the rest is land.\p “The sea is therefore more than twice the size of land.”")
}

text SlateportCity_OceanicMuseum_1F_Text_BeachSandDisplay {
    format("It's a sample of beach sand.\p “Stones from mountains are washed down by rivers where they are\l chipped and ground down.\p “They are reduced to grains and end up as sand on beaches.”")
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact2 {
    format("“OCEANIC MINIFACT 2 Why is the sea salty?\p “Seawater contains dissolved salt in the form of sodium and chlorine ions.\p “These ions leech out of rocks and are carried out to sea by rain.\p “The concentration of dissolved salt makes the sea salty.”")
}

text SlateportCity_OceanicMuseum_1F_Text_OceanSoilDisplay {
    format("It's a sample of soil from the ocean floor.\p “Over many years, the remains of life-forms settle at the bottom of\l the sea, making sedimentary layers.\p “By analyzing these layers, the ancient past is revealed.”")
}

text SlateportCity_OceanicMuseum_1F_Text_FossilDisplay {
    format("It's a fossil with wavy ridges on it.\p “Soil on the ocean floor gets scoured by the tide.\p “The flowing seawater marks the soil with small ridges and valleys.\p “If this soil becomes fossilized, it is called a ripple mark.”")
}

text SlateportCity_OceanicMuseum_1F_Text_WantSeaPokemon {
    format("I want a sea POKéMON.\pI think it would feel cool and nice\nto hug.$")
}

text SlateportCity_OceanicMuseum_1F_Text_PleaseEnjoyYourself {
    format("Please enjoy yourself.$")
}

text SlateportCity_OceanicMuseum_1F_Text_RustboroBungled {
    format("If our goons didn't bungle things\nin RUSTBORO, we wouldn't be here!$")
}

text SlateportCity_OceanicMuseum_1F_Text_OurBossIsntHere {
    format("We were told to assemble here,\nso we did, but…\pOur BOSS, the linchpin, isn't here.$")
}

text SlateportCity_OceanicMuseum_1F_Text_LearnAboutSeaForBattling {
    format("I want to learn about the sea and\nuse that knowledge for battling.$")
}

text SlateportCity_OceanicMuseum_1F_Text_YouHaveToTakeThis {
    format("Awww, come on!\nYou have to take this and let me go!$")
}

text SlateportCity_OceanicMuseum_1F_Text_CanLearnForNefariousDeeds {
    format("What I learn here, I can put to use on\nnefarious deeds…$")
}

text SlateportCity_OceanicMuseum_1F_Text_MustBePokemonWeDontKnow {
    format("The sea is vast without end, and\ninfinitely deep…\pThere must be many POKéMON that\nwe don't know about.$")
}

text SlateportCity_OceanicMuseum_1F_Text_SternIsRoleModel {
    format("I get all giddy and gooey when\nI see the sea!\pFor me, CAPT. STERN is the number\none role model!$")
}

text SlateportCity_OceanicMuseum_1F_Text_WouldYouLikeToEnter {
    format("Welcome to the OCEANIC MUSEUM.\pThe entrance fee is ¥50.\nWould you like to enter?$")
}

text SlateportCity_OceanicMuseum_1F_Text_AquaExistForGoodOfAll {
    format("We, TEAM AQUA, exist for the good\nof all!$")
}

text SlateportCity_OceanicMuseum_1F_Text_CatchUpWithYourGroup {
    format("Oh? You're with that group that\nwent in earlier?\pYou're the only one who's late.\nYou'd better go catch up to them!$")
}

text SlateportCity_OceanicMuseum_1F_Text_DidntHaveMoney {
    format("I didn't have ¥50, so it took a long\ntime getting by the receptionist.$")
}

text SlateportCity_OceanicMuseum_1F_Text_RememberMeTakeThis {
    format("Aiyeeeh!\nWhat are you doing here?\pMe? I'm the TEAM AQUA member\nyou thumped before, remember?\lBack in RUSTURF TUNNEL?\pHere, take this!\nYou have to forgive me!$")
}

text SlateportCity_OceanicMuseum_1F_Text_WouldStuffHereMakeMeRich {
    format("If I ripped off the stuff here,\nwould it make me rich?$")
}
