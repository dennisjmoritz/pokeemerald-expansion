mapscripts Route102_MapScripts {
}

script Route102_EventScript_Allen {
    trainerbattle_double(TRAINER_ALLEN, Route102_Text_AllenIntro, Route102_Text_AllenDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route102_Text_AllenPostBattle)
}

script Route102_EventScript_Boy {
    msgbox(Route102_Text_CatchWholeBunchOfPokemon, MSGBOX_NPC)
    end
}

script Route102_EventScript_Calvin {
    trainerbattle_double(TRAINER_CALVIN, Route102_Text_CalvinIntro, Route102_Text_CalvinDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route102_Text_CalvinPostBattle)
}

script Route102_EventScript_LittleBoy {
    msgbox(Route102_Text_ImNotVeryTall, MSGBOX_NPC)
    end
}

script Route102_EventScript_Rick {
    trainerbattle_double(TRAINER_RICK, Route102_Text_RickIntro, Route102_Text_RickDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route102_Text_RickPostBattle)
}

script Route102_EventScript_RouteSignOldale {
    msgbox(Route102_Text_RouteSignOldale, MSGBOX_SIGN)
    end
}

script Route102_EventScript_RouteSignPetalburg {
    msgbox(Route102_Text_RouteSignPetalburg, MSGBOX_SIGN)
    end
}

script Route102_EventScript_Tiana {
    trainerbattle_double(TRAINER_TIANA, Route102_Text_TianaIntro, Route102_Text_TianaDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route102_Text_TianaPostBattle)
}


text Route102_Text_RouteSignPetalburg {
    format("ROUTE 102 {LEFT_ARROW} PETALBURG CITY")
}

text Route102_Text_RouteSignOldale {
    format("ROUTE 102 {RIGHT_ARROW} OLDALE TOWN")
}


text Route102_Text_AllenDefeated {
    format("I called you because I thought I could beat you…")
}

text Route102_Text_AllenIntro {
    format("Did you just become a TRAINER? We're both beginners!")
}

text Route102_Text_AllenPostBattle {
    format("I haven't won once yet… I wish I would win soon…")
}

text Route102_Text_CalvinDefeated {
    format("Arrgh, I lost… I should have trained mine more…")
}

text Route102_Text_CalvinIntro {
    format("If you have POKéMON with you, then you're an official POKéMON TRAINER! You can't say no to my challenge!")
}

text Route102_Text_CalvinPostBattle {
    format("Listen, you. If you're strong, you should have told me before!")
}

text Route102_Text_RickDefeated {
    format("Ow! Down and out!")
}

text Route102_Text_RickIntro {
    format("Hahah! Our eyes met! I'll take you on with my BUG POKéMON!")
}

text Route102_Text_RickPostBattle {
    format("If you lock eyes with a TRAINER, you have to challenge! It's a rule!")
}

text Route102_Text_TianaDefeated {
    format("I ended up furthering your career…")
}

text Route102_Text_TianaIntro {
    format("I'm going to keep winning and aim to be the best TRAINER.\pHelp me further my career!")
}

text Route102_Text_TianaPostBattle {
    format("To keep winning my way up, I see that I have to catch more POKéMON.")
}

text Route102_Text_ImNotVeryTall {
    format("I'm…not very tall, so I sink right\ninto tall grass.\pThe grass goes up my nose and…\nFwafwafwafwafwa…\pFwatchoo!$")
}

text Route102_Text_CatchWholeBunchOfPokemon {
    format("I'm going to catch a whole bunch of\nPOKéMON!$")
}
