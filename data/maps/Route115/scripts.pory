text Route115_Text_RouteSignRustboro {
    format("ROUTE 115 {DOWN_ARROW} RUSTBORO CITY")
}

text Route115_Text_MeteorFallsSign {
    format("METEOR FALLS FALLARBOR TOWN THROUGH HERE")
}


text Route115_Text_AlixDefeat {
    format("Gah! Not bad!")
}

text Route115_Text_AlixIntro {
    format("Our eyes met! There's no getting away now!")
}

text Route115_Text_AlixPostBattle {
    format("Oh, well. I think I will TELEPORT home.")
}

text Route115_Text_CyndyDefeat {
    format("I haven't trained enough!")
}

text Route115_Text_CyndyIntro {
    format("This beach is my secret training spot! Don't come butting in!")
}

text Route115_Text_CyndyPostBattle {
    format("The sand acts as a cushion to reduce impact and prevent injury. This is the perfect place to train.")
}

text Route115_Text_HectorDefeat {
    format("You… You want my POKéMON, don't you?")
}

text Route115_Text_HectorIntro {
    format("I have a rare POKéMON! Would you like me to show you?")
}

text Route115_Text_HectorPostBattle {
    format("I have this rare POKéMON. It's enough to keep me satisfied.")
}

text Route115_Text_HeleneDefeat {
    format("This is too humiliating!")
}

text Route115_Text_HeleneIntro {
    format("My POKéMON have black belt-level strength!")
}

text Route115_Text_HelenePostBattle {
    format("I rarely meet anyone who's better than me…\pI get it now! You're a GYM LEADER, aren't you?")
}

text Route115_Text_JaidenDefeat {
    format("Waaah! Our strategy failed!")
}

text Route115_Text_JaidenIntro {
    format("Take that! Ultra POKéMON ninja attack!")
}

text Route115_Text_JaidenPostBattle {
    format("But my POKéMON were ultra, weren't they?")
}

text Route115_Text_KoichiDefeat {
    format("Ouch, ouch, ouch!")
}

text Route115_Text_KoichiIntro {
    format("You!\pMy MACHOP!\pDemand a battle!")
}

text Route115_Text_KoichiPostBattle {
    format("My MACHOP crew!\pSo long as they seek power, I will grow strong with them!")
}

text Route115_Text_KyraDefeat {
    format("Gasp, gasp…")
}

text Route115_Text_KyraIntro {
    format("I'll battle while I'm running! Try to keep up with me!")
}

text Route115_Text_KyraPostBattle {
    format("I made the mistake of trying to battle while running!\pI should take a run to calm down…")
}

text Route115_Text_MarleneDefeat {
    format("You've broken my concentration!")
}

text Route115_Text_MarleneIntro {
    format("You've disturbed my meditation… You'll be punished for it.")
}

text Route115_Text_MarlenePostBattle {
    format("I was meditating with my POKéMON. But this place isn't very peaceful…")
}

text Route115_Text_NobDefeat {
    format("Ugwaaaah! My head is busted!")
}

text Route115_Text_NobIntro {
    format("My strongest skill is busting bricks with my forehead!")
}

text Route115_Text_NobPostBattle {
    format("I've been teaching my POKéMON karate.\pIt looks like they'll get a lot better than me. I'm excited about that.")
}

text Route115_Text_TimothyDefeat {
    format("You're much stronger than I'd imagined!")
}

text Route115_Text_TimothyIntro {
    format("Hm… You seem rather capable… Let me keep you company!")
}

text Route115_Text_TimothyPostBattle {
    format("There is no such thing as a born genius. It all depends on effort! That is what I believe…")
}

text Route115_Text_NeverKnowWhenCavePokemonWillAppear {
    format("Exploring a cave isn't like walking\non a road.\pYou never know when wild POKéMON will\nappear. It's full of suspense.$")
}
