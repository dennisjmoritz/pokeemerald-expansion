text PetalburgCity_PokemonCenter_1F_Text_TreeckoIsGrassType {
    format("For example, your TREECKO\nis a GRASS type.\pIt's strong against the WATER and\nGROUND types.\pBut, it's weak against FIRE-type\nPOKéMON.$")
}

text PetalburgCity_PokemonCenter_1F_Text_ManyTypesOfPokemon {
    format("There are many types of POKéMON.\pAll types have their strengths and\nweaknesses against other types.\pDepending on the types of POKéMON,\na battle could be easy or hard.$")
}

text PetalburgCity_PokemonCenter_1F_Text_TorchicIsFireType {
    format("For example, your TORCHIC\nis a FIRE type.\pIt's strong against the GRASS and\nBUG types.\pBut, it's weak against WATER-type\nPOKéMON.$")
}

text PetalburgCity_PokemonCenter_1F_Text_PCStorageSystem {
    format("That PC-based POKéMON Storage\nSystem…\pWhoever made it must be some kind\nof a scientific wizard!$")
}

text PetalburgCity_PokemonCenter_1F_Text_OranBerryRegainedHP {
    format("When my POKéMON ate an\nORAN BERRY, it regained HP!$")
}

text PetalburgCity_PokemonCenter_1F_Text_MudkipIsWaterType {
    format("For example, your MUDKIP\nis a WATER type.\pIt's strong against the FIRE type.\pBut, it's weak against GRASS-type\nand ELECTRIC-type POKéMON.$")
}
