text MtChimney_Text_SawyerRegister {
    format("I like little fireballs like you.\nLet me register you in my POKéNAV.$")
}

text MtChimney_Text_MagmasNameSimilar {
    format("We're TEAM AQUA!\pThey're TEAM MAGMA!\pIt burns me up that they'd use such\na confusing name!$")
}

text MtChimney_Text_DouseThemInFire {
    format("Yeah!\nDouse them in fire!$")
}

text MtChimney_Text_PlayerLeftMeteorite {
    format("{PLAYER} left the METEORITE where\nit was.$")
}

text MtChimney_Text_MeteoriteWillActivateVolcano {
    format("The power contained in the METEORITE…\pBy amplifying its power with this\nmachine, MT. CHIMNEY's volcanic\lactivity will instantly intensify…\pIts energy will grow deep inside\nthe crater and…\lFufufu…$")
}

text MtChimney_Text_ArchieGoStopTeamMagma {
    format("ARCHIE: Grr, {PLAYER}!\nI should've guessed you'd show up!\pSee for yourself what the fanatics\nof TEAM MAGMA are up to!\pThey're trying to inject the stolen\nMETEORITE's power into the volcano!\pDoing something like that will cause\nthe volcano's eruption!$")
}

text MtChimney_Text_MagmaOutnumbersUs {
    format("Darn… TEAM MAGMA outnumbers us!\nWe can't keep up with them!$")
}

text MtChimney_Text_MetoriteFittedOnMachine {
    format("A METEORITE is fitted on a mysterious\nmachine…\pThe machine seems to be storing\nenergy in the METEORITE.$")
}

text MtChimney_Text_OhFineThen {
    format("Oh, fine then.$")
}

text MtChimney_Text_Bushaa {
    format("Bushaa!$")
}

text MtChimney_Text_MachineMakesNoResponse {
    format("This mysterious machine…\nIt makes no response whatsoever.$")
}

text MtChimney_Text_AquasNameSimilar {
    format("We're TEAM MAGMA!\pThey're TEAM AQUA!\pIt totally annoys me that they'd\nuse a name like ours!$")
}

text MtChimney_Text_MeteoritesPackAmazingPower {
    format("METEORITES pack amazing power!$")
}

text MtChimney_Text_LavaCookiesJust200 {
    format("LAVA COOKIES are MT. CHIMNEY's local\nspecialty.\pTry one. It's just ¥200.$")
}

text MtChimney_Text_LessHabitatForWaterPokemon {
    format("If they expand the land, there'll be\nless habitats for WATER POKéMON!$")
}

text MtChimney_Text_ArchieIHaveMyHandsFull {
    format("ARCHIE: Grrr…\pI want to stop that MAXIE,\nbut I can't!\pNot when I have my hands full battling\nthree opponents at once!$")
}

text MtChimney_Text_TeamAquaAlwaysMessingWithPlans {
    format("That annoying TEAM AQUA…\nThey always mess with our plans!$")
}

text MtChimney_Text_ShelbyRegister {
    format("Thank you, child. It was fun, as if\nI were battling my own grandchild.\pPlease, come see me again for\na rematch.$")
}

text MtChimney_Text_ShelbyPostRematch {
    format("Perhaps your heart has become one\nwith the hearts of your POKéMON.$")
}

text MtChimney_Text_SawyerPostRematch {
    format("Actually, it really is hot here.\nI'm overdressed for these parts.$")
}

text MtChimney_Text_YouBetterNotMessWithUs {
    format("You'd better not mess with us!\pWe're trying to awaken that thing\nfor the benefit of everyone!$")
}

text MtChimney_Text_KeepMakingMoreLand {
    format("We're going to keep making more land!$")
}

text MtChimney_Text_Bufoh {
    format("Bufoh!$")
}

text MtChimney_Text_YouveNotGotTheMoney {
    format("Oh, dear. You can't buy a thing if\nyou've not got the money.$")
}
