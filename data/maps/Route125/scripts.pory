text Route125_Text_AuronDefeat {
    format("Oh, you weren't throwing trash into the sea.")
}

text Route125_Text_AuronIntro {
    format("Hey! Was it you throwing garbage into the sea?")
}

text Route125_Text_AuronPostBattle {
    format("I found an unsightly bottle bobbing in the waves earlier.\pIt angers me that someone would pollute the sea!")
}

text Route125_Text_ErnestDefeat {
    format("Gwrroooar! I couldn't win!")
}

text Route125_Text_ErnestIntro {
    format("Ahoy! I'm a buff, tough SAILOR! I've braved the world's seas!")
}

text Route125_Text_ErnestPostBattle {
    format("The tide ebbs and flows inside the SHOAL CAVE.\pBy the way, it's about six hours from high tide to low tide. Did you know?")
}

text Route125_Text_NolenDefeat {
    format("I surrender!")
}

text Route125_Text_NolenIntro {
    format("I heard you approaching, so I hung around for you!")
}

text Route125_Text_NolenPostBattle {
    format("Sound travels faster in water than it does through air.")
}

text Route125_Text_PresleyDefeat {
    format("Okay. I'll tell you why I'm here.")
}

text Route125_Text_PresleyIntro {
    format("Why would a BIRDKEEPER like me come out to the sea?")
}

text Route125_Text_PresleyPostBattle {
    format("I put a message in a bottle and put it out to sea.\pI'm sure that a girl SWIMMER will find it!")
}

text Route125_Text_SharonDefeat {
    format("Lost it…")
}

text Route125_Text_SharonIntro {
    format("How would you like to take on the WATER-type POKéMON I raised?")
}

text Route125_Text_SharonPostBattle {
    format("Your power… You're the real deal. I'm amazed!")
}

text Route125_Text_StanDefeat {
    format("I floundered…")
}

text Route125_Text_StanIntro {
    format("Hey, there! Check out my sweet POKéMON!")
}

text Route125_Text_StanPostBattle {
    format("I was blown away by HORSEA's charm, so I started swimming, too.")
}

text Route125_Text_TanyaDefeat {
    format("You're too much!")
}

text Route125_Text_TanyaIntro {
    format("I'm tired of swimming. Are you up for a battle with me?")
}

text Route125_Text_TanyaPostBattle {
    format("Whew… Which way is it to MOSSDEEP CITY?")
}
text Route125_Text_IrisPostBattle {
    format("IRIS: KIM, are we really going into the SHOAL CAVE? We'll get all wet.")
}

text Route125_Text_KimPostBattle {
    format("KIM: A funny old man lives in the SHOAL CAVE, doesn't he?\pLet's go see him, IRIS!")
}
