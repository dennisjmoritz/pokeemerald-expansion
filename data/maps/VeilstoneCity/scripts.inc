VeilstoneCity_Text_SmithNPC1::
# 28 "data/maps/VeilstoneCity/scripts.pory"
	.string "I've been expecting you, Mr. Anderson.$"

VeilstoneCity_Text_SmithNPC2::
# 37 "data/maps/VeilstoneCity/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

VeilstoneCity_Text_SmithNPC3::
# 46 "data/maps/VeilstoneCity/scripts.pory"
