	.string "sound of inevitability.$"

VeilstoneCity_Text_SmithNPC5::
# 64 "data/maps/VeilstoneCity/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

VeilstoneCity_Text_SmithNPC6::
# 73 "data/maps/VeilstoneCity/scripts.pory"
	.string "It's the question that drives us, Neo.$"

VeilstoneCity_Text_SmithNPC7::
# 82 "data/maps/VeilstoneCity/scripts.pory"
	.string "Unfortunately, no one can be told what\n"
	.string "the Matrix is.$"

VeilstoneCity_Text_SmithNPC8::
# 91 "data/maps/VeilstoneCity/scripts.pory"
	.string "I know kung fu.$"
