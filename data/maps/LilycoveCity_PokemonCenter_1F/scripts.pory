text LilycoveCity_PokemonCenter_1F_Text_HaventSeenRottenScoundrels {
    format("Those rotten scoundrels who steal\nPOKéMON and rip off METEORITES…\pI haven't seen them around recently.$")
}

text LilycoveCity_PokemonCenter_1F_Text_HowManyKindsOfPokemon {
    format("I wonder how many kinds of POKéMON\nthere are in the world.\pIt'd be great to cross seas and\ntrade POKéMON with people far away.$")
}
