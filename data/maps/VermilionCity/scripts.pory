text VermilionCity_Text_PokemonFanClubSign {
    format("POKéMON FAN CLUB All POKéMON fans welcome!")
}

text VermilionCity_Text_VermilionHarbor {
    format("VERMILION HARBOR")
}

text VermilionCity_Text_GymSign {
    format("VERMILION CITY POKéMON GYM LEADER: LT. SURGE\l The Lightning American!")
}

text VermilionCity_Text_SnorlaxBlockingRoute12 {
    format("NOTICE!\p ROUTE 12 may be blocked off by a sleeping POKéMON.\p Detour through ROCK TUNNEL to LAVENDER TOWN.\p VERMILION POLICE")
}

text VermilionCity_Text_CitySign {
    format("VERMILION CITY The Port of Exquisite Sunsets")
}

text VermilionCity_Text_BuildingOnThisLand {
    format("I'm putting up a building on this\nplot of land. I own it all.\pMy POKéMON is tamping the land\nto lay the foundation.$")
}

text VermilionCity_Text_SSAnneVisitsOnceAYear {
    format("The S.S. ANNE is a famous luxury\ncruise ship.\pIt visits VERMILION once a year.$")
}

text VermilionCity_Text_GrimerMultipliesInSludge {
    format("We're careful about pollution here.\pWe've heard GRIMER multiplies in\ntoxic sludge.$")
}
