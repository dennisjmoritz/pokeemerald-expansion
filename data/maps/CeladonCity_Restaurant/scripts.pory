text CeladonCity_Restaurant_Text_TakingBreakRightNow {
    format("Hi!\pSorry, but we're taking a break\nright now.$")
}

text CeladonCity_Restaurant_Text_ManLostItAllAtSlots {
    format("Munch…\pThe man at that table lost it all\nat the slots.$")
}

text CeladonCity_Restaurant_Text_OftenGoToDrugstore {
    format("My POKéMON are weak, so I often\nhave to go to the DRUGSTORE.$")
}

text CeladonCity_Restaurant_Text_PsstBasementUnderGameCorner {
    format("Psst! There's a basement under the\nGAME CORNER, I hear.$")
}
