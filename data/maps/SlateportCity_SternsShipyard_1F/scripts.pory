mapscripts SlateportCity_SternsShipyard_1F_MapScripts {
}

script SlateportCity_SternsShipyard_1F_EventScript_Briney {
    msgbox(SlateportCity_SternsShipyard_1F_Text_DecidedToHelpDock, MSGBOX_NPC)
    end
}

script SlateportCity_SternsShipyard_1F_EventScript_Dock {
    end
}

script SlateportCity_SternsShipyard_1F_EventScript_Scientist1 {
    msgbox(SlateportCity_SternsShipyard_1F_Text_SeaIsLikeLivingThing, MSGBOX_NPC)
    end
}

script SlateportCity_SternsShipyard_1F_EventScript_Scientist2 {
    msgbox(SlateportCity_SternsShipyard_1F_Text_GetSeasickEasily, MSGBOX_NPC)
    end
}

text SlateportCity_SternsShipyard_1F_Text_GetSeasickEasily {
    format("I get seasick real easily.\nSo I get to help out here instead.$")
}

text SlateportCity_SternsShipyard_1F_Text_BrineyJoinedUs {
    format("DOCK: Hi! MR. BRINEY's joined us to\nlend us his help.\pThanks to the veteran sailor, the\nferry is steadily coming together.$")
}

text SlateportCity_SternsShipyard_1F_Text_CouldUseAdviceFromVeteran {
    format("DOCK: Shipbuilding is an art.\pA lot of things can't be figured out\njust by calculating.\pI really could use advice from a veteran\nwho knows the seas…$")
}

text SlateportCity_SternsShipyard_1F_Text_FerryIsReady {
    format("DOCK: The ferry is finally ready!\pThe new S.S. TIDAL is truly a marvel\nof technology!\pBut, I get the feeling that we can\nmake something even better.\pYou know, there's never an end to\ntechnology's march.$")
}

text SlateportCity_SternsShipyard_1F_Text_DecidedToHelpDock {
    format("MR. BRINEY: Ah, {PLAYER}{KUN}!\nIt's been too long!\pAye, since I met you, this old sea dog's\nbeen feeling frisky!\pSo I've decided to help DOCK make\na ferry.\pAye, after all, a ferry would be able\nto carry a lot of people.\pBut, you know, that DOCK is really\nsomething special.\pWith his knack for technology and\nmy experience, I'm sure that we can\lbuild one great ship, aye!$")
}

text SlateportCity_SternsShipyard_1F_Text_CouldYouFindStern {
    format("DOCK: Where could CAPT. STERN have\ngone off to?\pCould you go find CAPT. STERN and\ndeliver that parcel to him?$")
}

text SlateportCity_SternsShipyard_1F_Text_SeaIsLikeLivingThing {
    format("The seasons, the weather, where\nthe moon sits in the sky…\pThese and other conditions make\nthe sea change its expression.\pThat's right!\nThe sea is like a living thing!$")
}
