text Route132_Text_DanaDefeat {
    format("Oh, please, no!")
}

text Route132_Text_DanaIntro {
    format("I try not to swim where the currents are too strong.")
}

text Route132_Text_DanaPostBattle {
    format("If I get swept away, I'll lose all my sense of place…")
}

text Route132_Text_DarcyDefeat {
    format("Okay! I won't complain about other people being here.")
}

text Route132_Text_DarcyIntro {
    format("I liked training here by myself. It's awful that all these people came!")
}

text Route132_Text_DarcyPostBattle {
    format("I suppose I can partner up with that old man and challenge that other team.")
}

text Route132_Text_GilbertDefeat {
    format("I crave more power…")
}

text Route132_Text_GilbertIntro {
    format("I used to catch colds all the time as a kid, but I became totally fit after I started swimming.")
}

text Route132_Text_GilbertPostBattle {
    format("TRAINERS travel the fields and mountains, so they must be fit, too.")
}

text Route132_Text_JonathanDefeat {
    format("Wow! That's pretty strong, all right!")
}

text Route132_Text_JonathanIntro {
    format("Someone's been watching me intently. Was it you?")
}

text Route132_Text_JonathanPostBattle {
    format("I can't shake this feeling that someone's watching me.\pI can't concentrate!")
}

text Route132_Text_KiyoDefeat {
    format("I lose. I will concede defeat.")
}

text Route132_Text_KiyoIntro {
    format("I contemplate POKéMON 24 hours a day. How could you possibly beat me?")
}

text Route132_Text_KiyoPostBattle {
    format("Urggh… You're a POKéMON fanatic, aren't you?\pYou must contemplate POKéMON 24 hours a day, don't you?")
}

text Route132_Text_MakaylaDefeat {
    format("Oh, I guess I wasn't good enough.")
}

text Route132_Text_MakaylaIntro {
    format("I'm always with my husband, but I can win even without him.")
}

text Route132_Text_MakaylaPostBattle {
    format("That young man over there looks just like my husband when he was young.\pHe's making me blush!")
}

text Route132_Text_PaxtonDefeat {
    format("Ah, I see that I couldn't manage to win on my own after all.")
}

text Route132_Text_PaxtonIntro {
    format("Now where could my wife have gone? I'm always with her. I wonder if I can win on my own.")
}

text Route132_Text_PaxtonPostBattle {
    format("My wife must be looking for me. I'd best go find her right away.")
}

text Route132_Text_RonaldDefeat {
    format("Waah! I sank in defeat!")
}

text Route132_Text_RonaldIntro {
    format("Win or lose, you'll never know until you try!")
}

text Route132_Text_RonaldPostBattle {
    format("I never battle when I know I'll win. I like to battle at the razor's edge of victory and defeat!")
}