mapscripts Route132_MapScripts {
}

script Route132_EventScript_Dana {
    trainerbattle_double(TRAINER_DANA, Route132_Text_DanaIntro, Route132_Text_DanaDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route132_Text_DanaPostBattle)
}

