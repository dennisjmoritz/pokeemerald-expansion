mapscripts Route127_MapScripts {
}

script Route127_EventScript_Aidan {
    trainerbattle_double(TRAINER_AIDAN, Route127_Text_AidanIntro, Route127_Text_AidanDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route127_Text_AidanPostBattle)
}

