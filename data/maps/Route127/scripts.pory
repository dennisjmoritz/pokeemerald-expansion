text Route127_Text_AidanDefeat {
    format("Whew… I give up.")
}

text Route127_Text_AidanIntro {
    format("BIRD POKéMON have excellent vision. They spot prey from great heights.")
}

text Route127_Text_AidanPostBattle {
    format("There're lots of diving spots in the sea around here.\pYou can spot them easily from the sky because of their darker color.")
}

text Route127_Text_AthenaDefeat {
    format("You didn't give me the chance to do any strategizing.")
}

text Route127_Text_AthenaIntro {
    format("We should have a slow and methodical match.")
}

text Route127_Text_AthenaPostBattle {
    format("When I'm surrounded by the blue sea and sky, it feels as if time slows down.")
}

text Route127_Text_CamdenDefeat {
    format("Awawawawawa…")
}

text Route127_Text_CamdenIntro {
    format("I can see it in your face. You want to challenge me.")
}

text Route127_Text_CamdenPostBattle {
    format("A well-played match leaves me feeling refreshed and serene.")
}

text Route127_Text_DonnyDefeat {
    format("Arrrgh! I hate losing!")
}

text Route127_Text_DonnyIntro {
    format("Do you have a rival whom you just hate to lose against?")
}

text Route127_Text_DonnyPostBattle {
    format("If you have a rival, don't you get the feeling that you have to keep getting better?")
}

text Route127_Text_HenryDefeat {
    format("I can't keep up!")
}

text Route127_Text_HenryIntro {
    format("Whoops! Don't tell me I snagged a SURFING POKéMON?")
}

text Route127_Text_HenryPostBattle {
    format("It'd be a handful if I hooked your tough POKéMON!")
}

text Route127_Text_JonahDefeat {
    format("Though I have lost, my heart remains calm…")
}

text Route127_Text_JonahIntro {
    format("Through fishing, I have attained a state of becalmed serenity…\pPlease, allow me to demonstrate…")
}

text Route127_Text_JonahPostBattle {
    format("It matters not that I catch nothing. The line remains in the water…")
}

text Route127_Text_KojiDefeat {
    format("Yowch! I got a pebble under a toenail!")
}

text Route127_Text_KojiIntro {
    format("Run in your bare feet. That will toughen up your soles!")
}

text Route127_Text_KojiPostBattle {
    format("Going barefoot feels great. But your RUNNING SHOES are cool, too.")
}

text Route127_Text_RogerDefeat {
    format("No! My line's all tangled! The party's over!")
}

text Route127_Text_RogerIntro {
    format("Well, hey! This is a match between a POKéMON fan and a fishing buff!")
}

text Route127_Text_RogerPostBattle {
    format("My fishing line's doing a dance! The tangle tango! Hahaha, snarl!")
}