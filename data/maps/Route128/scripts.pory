text Route128_Text_AlexaDefeat {
    format("Oh! How could this happen?!")
}

text Route128_Text_AlexaIntro {
    format("We've been working so hard to mount a POKéMON LEAGUE challenge…\pWe can't afford to lose now!")
}

text Route128_Text_AlexaPostBattle {
    format("After all I've done to get here, I won't give up after one setback.")
}

text Route128_Text_CarleeDefeat {
    format("I couldn't see very well because of the sun's glare.")
}

text Route128_Text_CarleeIntro {
    format("The sunlight seems to be more harsh in this area.")
}

text Route128_Text_CarleePostBattle {
    format("I should go back soon. I need to reapply my sunscreen.")
}

text Route128_Text_HarrisonDefeat {
    format("Ouch! I guess it was impossible to win.")
}

text Route128_Text_HarrisonIntro {
    format("You're looking awfully tough. I wonder if I can win?")
}

text Route128_Text_HarrisonPostBattle {
    format("There are tough TRAINERS galore around EVER GRANDE.\pDo you think I may be out of my league?")
}

text Route128_Text_IsaiahDefeat {
    format("My first victory seems to be far away, too…")
}

text Route128_Text_IsaiahIntro {
    format("EVER GRANDE CITY is still a long ways away…")
}

text Route128_Text_IsaiahPostBattle {
    format("My whole life has been about losing, but I will never give up!")
}

text Route128_Text_KatelynDefeat {
    format("A POKéMON battle is grueling, too…")
}

text Route128_Text_KatelynIntro {
    format("You have to swim, cycle, and then run a marathon in a triathlon.\pIt's a grueling race that consists of three events.")
}

text Route128_Text_KatelynPostBattle {
    format("I have to ride a BIKE next, but… I'm about to throw in the towel…")
}

text Route128_Text_RubenDefeat {
    format("This can't be!")
}

text Route128_Text_RubenIntro {
    format("There is no stronger TRAINER than I!")
}

text Route128_Text_RubenPostBattle {
    format("There probably is no stronger TRAINER than you!")
}

text Route128_Text_WayneDefeat {
    format("I'm crestfallen!")
}

text Route128_Text_WayneIntro {
    format("I want to visit EVER GRANDE, so I caught myself a POKéMON that knows the move WATERFALL to crest the falls.")
}

text Route128_Text_WaynePostBattle {
    format("Awww, phooey!\pMy POKéMON knows WATERFALL, but I don't have the SOOTOPOLIS GYM BADGE!")
}

text Route128_Text_ArchieWhatHappened {
    format("ARCHIE: What happened…\nWhat is this wretched scene…\pDid I…make a horrible mistake?$")
}
