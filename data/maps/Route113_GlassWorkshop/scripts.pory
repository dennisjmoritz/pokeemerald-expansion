mapscripts Route113_GlassWorkshop_MapScripts {
}

script Route113_GlassWorkshop_EventScript_GlassWorker {
    end
}

script Route113_GlassWorkshop_EventScript_NinjaBoy {
    msgbox(Route113_GlassWorkshop_Text_FunToBlowGlassFlute, MSGBOX_NPC)
    end
}

text Route113_GlassWorkshop_Text_IveFinishedGlassItem {
    format("Ah, I've finished your {STR_VAR_1}.\nTake it, huff-puff.$")
}

text Route113_GlassWorkshop_Text_NotEnoughAshNeedX {
    format("Hmmm…\nThere's not enough ash here, huff-puff.\lI can't make glass with this, huff-puff.\pLet's see… {STR_VAR_1} is the number of steps\nyou'll need to walk for me to make you\la BLUE FLUTE, huff-puff.$")
}

text Route113_GlassWorkshop_Text_IllMakeItemForYou {
    format("A {STR_VAR_1} it is, then, huff-puff!\pOkay! I'll make it for you, huff-puff.\nJust wait a little while, huff-puff.$")
}

text Route113_GlassWorkshop_Text_NoRoomInBag {
    format("Oh?\nYou've no room in your BAG, huff-puff.\pI'll hold on to it, so come back later,\nhuff-puff.$")
}

text Route113_GlassWorkshop_Text_ExplainSootSack {
    format("Just take that SOOT SACK and walk\nthrough piles of ash, huff-puff.\pAnd it will fill up with the volcanic ash,\nhuff-puff.\pOnce you think you've collected a good\namount, come see me, huff-puff.$")
}

text Route113_GlassWorkshop_Text_AllThatAshButDontWantAnything {
    format("You've collected all that ash, but you\ndon't want anything, huff-puff?$")
}

text Route113_GlassWorkshop_Text_FunToBlowGlassFlute {
    format("It's fun to blow a glass flute while\nmy boss is talking.\pHuff-huff! Puff-puff!$")
}

text Route113_GlassWorkshop_Text_HaventGotYourSootSack {
    format("Hah? You haven't got your SOOT SACK\nwith you, huff-puff.\pYou have to keep it with you to collect\nvolcanic ash, huff-puff.$")
}
