text RivalsHouse_1F_Text_WentOutToRoute103 {
    format("Oh, {RIVAL} went out to ROUTE 103\njust a little while ago.\pLike father, like child.\n{RIVAL} can't stay quietly at home.$")
}

text RivalsHouse_1F_Text_TooBusyToNoticeVisit {
    format("That {RIVAL}!\pI guess our child is too busy with\nPOKéMON to notice that you came\lto visit, {PLAYER}{KUN}.$")
}

text RivalsHouse_1F_Text_ShouldGoHomeEverySoOften {
    format("I think it's wonderful for people to\ntravel with POKéMON.\pBut you should go home every so often\nto let your mother know you're okay.\pShe might not say it, but I'm sure she\nworries about you, {PLAYER}{KUN}.$")
}

text RivalsHouse_1F_Text_DoYouHavePokemon {
    format("Hi, neighbor!\pDo you already have your\nown POKéMON?$")
}

script LittlerootTown_MaysHouse_1F_EventScript_SmithNPC1 {
    msgbox(LittlerootTown_MaysHouse_1F_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text LittlerootTown_MaysHouse_1F_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script LittlerootTown_MaysHouse_1F_EventScript_SmithNPC2 {
