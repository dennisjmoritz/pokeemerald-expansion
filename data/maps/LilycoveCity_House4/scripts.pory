text LilycoveCity_House4_Text_UnderwaterTrenchMossdeepSootopolis {
    format("There's a deep underwater trench\nbetween MOSSDEEP and SOOTOPOLIS.\pThat's what someone told me, anyway.$")
}

text LilycoveCity_House4_Text_MysteriesAtBottomOfSea {
    format("This planet's biggest mysteries are\nat the bottom of the sea.\pSomebody said that, but I don't know…$")
}
