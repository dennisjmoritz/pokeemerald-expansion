text VerdanturfTown_Mart_Text_XSpecialIsCrucial {
    format("For any POKéMON match, X SPECIAL\nis crucial.\pIt jacks up the power of some moves\neven though it's only for one battle.$")
}

text VerdanturfTown_Mart_Text_NestBallOnWeakenedPokemon {
    format("The NEST BALL works better on\nweakened POKéMON.\pVERDANTURF is the only place you can\nbuy it.$")
}

text VerdanturfTown_Mart_Text_NoStrategyGuidesForBattleTent {
    format("They don't seem to sell any winning\nstrategy guides for the BATTLE TENT…\pIt seems one must rely on one's\nown wits after all…$")
}
