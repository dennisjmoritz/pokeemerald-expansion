mapscripts SootopolisCity_House7_MapScripts {
}

script SootopolisCity_House7_EventScript_OldMan {
    msgbox(SootopolisCity_House7_Text_CityFromEruptedVolcano, MSGBOX_NPC)
    end
}

script SootopolisCity_House7_EventScript_PokefanF {
    msgbox(SootopolisCity_House7_Text_CaveMadeToKeepSomething, MSGBOX_NPC)
    end
}

text SootopolisCity_House7_Text_CityFromEruptedVolcano {
    format("An underwater volcano erupted and\nforced itself up from the depths.\pIts crater emerged from the sea and\nbecame filled with rainwater.\pThat's how SOOTOPOLIS CITY came into\nbeing.$")
}

text SootopolisCity_House7_Text_CaveMadeToKeepSomething {
    format("The cave that links SOOTOPOLIS and\nthe outside world…\pIt seems as if the cave was made to\nkeep something from getting out.\pOr am I just imagining things?$")
}
