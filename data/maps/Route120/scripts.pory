script Route120_EventScript_Steven {
    end
}


text Route120_Text_RouteSign121 {
    format("{RIGHT_ARROW} ROUTE 121 {LEFT_ARROW} ROUTE 120")
}

text Route120_Text_RouteSignFortree {
    format("ROUTE 120 {LEFT_ARROW} FORTREE CITY")
}


text Route120_Text_AngelicaDefeat {
    format("You've completely ruined my beauty…")
}

text Route120_Text_AngelicaIntro {
    format("Me, POKéMON, and my parasol…\pIf any one of them is missing, the picture of beauty will be ruined.")
}

text Route120_Text_AngelicaPostBattle {
    format("A parasol wouldn't suit you at all.\pWhy, something like this would only get in your way.")
}

text Route120_Text_CallieDefeat {
    format("Ouch! I was the one to get hurt.")
}

text Route120_Text_CallieIntro {
    format("If you don't pay attention, you could get hurt!")
}

text Route120_Text_CalliePostBattle {
    format("I wonder… Should I evolve my POKéMON? They're cute the way they are, though.")
}

text Route120_Text_ChipDefeat {
    format("What a disgraceful setback…")
}

text Route120_Text_ChipIntro {
    format("Who might you be?\pAre you perhaps searching for ancient ruins that are rumored to possibly exist according to legend?")
}

text Route120_Text_ChipPostBattle {
    format("That giant rock… I would like to believe it may indeed contain ancient ruins. But I see no entrance.")
}

text Route120_Text_ClarissaDefeat {
    format("A parasol can't ward off POKéMON attacks…")
}

text Route120_Text_ClarissaIntro {
    format("Why am I carrying this parasol?\pI'll tell you if you can win against me.")
}

text Route120_Text_ClarissaPostBattle {
    format("I don't think strong sunlight is good for my POKéMON. So I shield them with my parasol.")
}

text Route120_Text_ColinDefeat {
    format("You soared above me!")
}

text Route120_Text_ColinIntro {
    format("Do you have any moves that can strike a flying POKéMON?")
}

text Route120_Text_ColinPostBattle {
    format("The move FLY is convenient, don't you think?\pWhile the POKéMON is flying, almost no moves can strike it.")
}

text Route120_Text_JeffreyDefeat {
    format("Lost it…")
}

text Route120_Text_JeffreyIntro {
    format("… … … … … … … … … … … … Want to battle?")
}

text Route120_Text_JeffreyPostBattle {
    format("… … … … … … … … … … … … I'll try harder…")
}

text Route120_Text_JennaDefeat {
    format("I'm totally fit, but…")
}

text Route120_Text_JennaIntro {
    format("How's your physical fitness? If you're not fit, you could have a rough time in critical situations.")
}

text Route120_Text_JennaPostBattle {
    format("Fitness training is in my routine. I always run with my POKéMON.")
}

text Route120_Text_JenniferDefeat {
    format("You're obviously thinking.")
}

text Route120_Text_JenniferIntro {
    format("POKéMON have many special abilities. If you want to become a first-class TRAINER, learn about them.")
}

text Route120_Text_JenniferPostBattle {
    format("The special abilities of POKéMON will make battle styles change.")
}

text Route120_Text_KeigoDefeat {
    format("The creation of new ninja techniques is but a distant dream…")
}

text Route120_Text_KeigoIntro {
    format("I will adopt the movements of POKéMON and create new ninja techniques.")
}

text Route120_Text_KeigoPostBattle {
    format("Perhaps I ought to apprentice under a ninja sensei.")
}

text Route120_Text_LeonelDefeat {
    format("I've seen your policy in action!")
}

text Route120_Text_LeonelIntro {
    format("Your party POKéMON… Do you have different types?")
}

text Route120_Text_LeonelPostBattle {
    format("I think it's awesome you're so strong battling with your favorite POKéMON.")
}

text Route120_Text_LorenzoDefeat {
    format("With POKéMON that strong, you're in no danger of needing rescue!")
}

text Route120_Text_LorenzoIntro {
    format("I'll check your POKéMON and see if they're fit for the outdoors.")
}

text Route120_Text_LorenzoPostBattle {
    format("To travel wherever your heart desires with POKéMON… That's the joy of being a TRAINER.")
}

text Route120_Text_RileyDefeat {
    format("I lost! I should camouflage my shame!")
}

text Route120_Text_RileyIntro {
    format("We ninja conceal ourselves under our camouflage cloaks. I bet you didn't know where I was!")
}

text Route120_Text_RileyPostBattle {
    format("Our camouflage cloaks are all handmade.")
}

text Route120_Text_RobertDefeat {
    format("Your POKéMON were stronger…")
}

text Route120_Text_RobertIntro {
    format("My POKéMON is strong! How about yours?")
}

text Route120_Text_RobertPostBattle {
    format("A POKéMON that grows steadily is one you can count on.")
}

text Route120_Text_StevenReadyForBattle {
    format("STEVEN: {PLAYER}{KUN}, are your POKéMON\nready for battle?$")
}

text Route120_Text_StevenIllWaitHere {
    format("STEVEN: No?\pI'll wait here, so you can get ready.$")
}

text Kecleon_Text_SomethingUnseeable {
    format("Something unseeable is in the way.$")
}

text Route120_Text_StevenGiveDevonScope {
    format("STEVEN: I see…\nYour battle style is intriguing.\pYour POKéMON have obviously grown\nsince I first met you in DEWFORD.\pI'd like you to have this\nDEVON SCOPE.\pWho knows, there may be other\nconcealed POKéMON.$")
}

text Route120_Text_StevenShowMeYourPower {
    format("STEVEN: {PLAYER}{KUN}, show me your true\npower as a TRAINER!$")
}
