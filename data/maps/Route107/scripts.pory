script Route107_EventScript_Lisa {
    end
}

script Route107_EventScript_Ray {
    end
}

script Route107_EventScript_Tony {
    trainerbattle_double(TRAINER_TONY, Route107_Text_TonyIntro, Route107_Text_TonyDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_TonyPostBattle)
}



text Route107_Text_BethDefeated {
    "I wasn't good enough for you."
}

text Route107_Text_BethIntro {
    "Did you want to battle me?\nSure, I'll go with you!"
}

text Route107_Text_BethPostBattle {
    "I think you're going to keep getting\nbetter. I'll go for it, too!"
}

text Route107_Text_CamronDefeated {
    "That exhausted me…"
}

text Route107_Text_CamronIntro {
    "I'm in the middle of a triathlon,\nbut I'm nowhere near tired!"
}

text Route107_Text_CamronPostBattle {
    "I still have swimming and running left\nto do after this.\pAm I going to be okay?"
}

text Route107_Text_DarrinDefeated {
    "Ahaha, I lost…\nI'll take a snooze, I think…"
}

text Route107_Text_DarrinIntro {
    "Yawn…\pI must have drifted off to sleep while\nI was drifting in the waves."
}

text Route107_Text_DarrinPostBattle {
    "Floating and being rocked by\nthe waves--it's like sleeping in\na plush, comfy bed."
}

text Route107_Text_DeniseDefeated {
    "I hate this!"
}

text Route107_Text_DeniseIntro {
    "Do you know a little town called\nDEWFORD?"
}

text Route107_Text_DenisePostBattle {
    "A weird saying is getting really\ntrendy at DEWFORD HALL."
}

text Route107_Text_TonyDefeated {
    "I lost on my home field…\nI'm in shock!"
}

text Route107_Text_TonyIntro {
    "The sea is like my backyard.\nLet's battle!"
}

text Route107_Text_TonyPostBattle {
    "I swim the seas with a heart full of\ndreams…\pIt's a song!\nAnyways, I'm swimming some more."
}