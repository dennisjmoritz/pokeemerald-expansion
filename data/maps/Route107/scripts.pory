mapscripts Route107_MapScripts {
}

script Route107_EventScript_Beth {
    trainerbattle_double(TRAINER_BETH, Route107_Text_BethIntro, Route107_Text_BethDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_BethPostBattle)
}

script Route107_EventScript_Camron {
    trainerbattle_double(TRAINER_CAMRON, Route107_Text_CamronIntro, Route107_Text_CamronDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_CamronPostBattle)
}

script Route107_EventScript_Darrin {
    trainerbattle_double(TRAINER_DARRIN, Route107_Text_DarrinIntro, Route107_Text_DarrinDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_DarrinPostBattle)
}

script Route107_EventScript_Denise {
    trainerbattle_double(TRAINER_DENISE, Route107_Text_DeniseIntro, Route107_Text_DeniseDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_DenisePostBattle)
}

script Route107_EventScript_Lisa {
    msgbox(Route107_Text_LisaPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route107_EventScript_Ray {
    msgbox(Route107_Text_RayPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route107_EventScript_Tony {
    trainerbattle_double(TRAINER_TONY, Route107_Text_TonyIntro, Route107_Text_TonyDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route107_Text_TonyPostBattle)
}



text Route107_Text_BethDefeated {
    format("I wasn't good enough for you.")
}

text Route107_Text_BethIntro {
    format("Did you want to battle me? Sure, I'll go with you!")
}

text Route107_Text_BethPostBattle {
    format("I think you're going to keep getting better. I'll go for it, too!")
}

text Route107_Text_CamronDefeated {
    format("That exhausted me…")
}

text Route107_Text_CamronIntro {
    format("I'm in the middle of a triathlon, but I'm nowhere near tired!")
}

text Route107_Text_CamronPostBattle {
    format("I still have swimming and running left to do after this.\pAm I going to be okay?")
}

text Route107_Text_DarrinDefeated {
    format("Ahaha, I lost… I'll take a snooze, I think…")
}

text Route107_Text_DarrinIntro {
    format("Yawn…\pI must have drifted off to sleep while I was drifting in the waves.")
}

text Route107_Text_DarrinPostBattle {
    format("Floating and being rocked by the waves--it's like sleeping in a plush, comfy bed.")
}

text Route107_Text_DeniseDefeated {
    format("I hate this!")
}

text Route107_Text_DeniseIntro {
    format("Do you know a little town called DEWFORD?")
}

text Route107_Text_DenisePostBattle {
    format("A weird saying is getting really trendy at DEWFORD HALL.")
}

text Route107_Text_TonyDefeated {
    format("I lost on my home field… I'm in shock!")
}

text Route107_Text_TonyIntro {
    format("The sea is like my backyard. Let's battle!")
}

text Route107_Text_TonyPostBattle {
    format("I swim the seas with a heart full of dreams…\pIt's a song! Anyways, I'm swimming some more.")
}
text Route107_Text_LisaPostBattle {
    format("LISA: Do you have any friends who would go to the beach with you?")
}

text Route107_Text_RayPostBattle {
    format("RAY: My sister gave me my POKéMON. I raised it, and now it's my important partner!")
}
