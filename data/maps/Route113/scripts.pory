text Route113_Text_RouteSign111 {
    format("ROUTE 113 {RIGHT_ARROW} ROUTE 111")
}

text Route113_Text_TrainerTipsRegisterKeyItems {
    format("TRAINER TIPS\p You may register one of the KEY ITEMS in your BAG as SELECT.\p Simply press SELECT to use the registered item conveniently.")
}

text Route113_Text_GlassWorkshopSign {
    format("GLASS WORKSHOP “Turning Volcanic Ash into Glass Items”")
}

text Route113_Text_RouteSignFallarbor {
    format("ROUTE 113 {LEFT_ARROW} FALLARBOR TOWN")
}


text Route113_Text_CobyDefeat {
    "A… What?"
}

text Route113_Text_CobyIntro {
    "Pfft, with these wings I can\nflick you away!"
}

text Route113_Text_CobyPostBattle {
    "I don't know what to say when I get\nbeaten so easily…"
}

text Route113_Text_DillonDefeat {
    "You're some kind of strong!"
}

text Route113_Text_DillonIntro {
    "The volcano's eruption is proof that\nthe earth is alive."
}

text Route113_Text_DillonPostBattle {
    "Ouch! Owww! I can't see!\nI got ashes in my eyelashes!\pGet it? Ashes and eyelashes?\pOkay, that was bad, sorry…"
}

text Route113_Text_JaylenDefeat {
    "Peeuuw!\nThat stinks!"
}

text Route113_Text_JaylenIntro {
    "Can you guess why it's so cool\naround here?"
}

text Route113_Text_JaylenPostBattle {
    "The volcanic ash blocks the sun,\nso it doesn't get very warm.\pThat's good for me--I can't stand heat!"
}

text Route113_Text_LaoDefeat {
    "With honor I admit defeat!"
}

text Route113_Text_LaoIntro {
    "From out of the ashes I leap! Hiyah!\nI challenge thee!"
}

text Route113_Text_LaoPostBattle {
    "I must refine the art of concealment.\nI bid thee farewell."
}

text Route113_Text_LawrenceDefeat {
    "Ehehe.\nWe got beaten cleanly."
}

text Route113_Text_LawrenceIntro {
    "Were you maybe in the middle\nof gathering volcanic ashes?"
}

text Route113_Text_LawrencePostBattle {
    "I ought to hide under the ashes, too."
}

text Route113_Text_LungDefeat {
    "I'll use my ninjutsu on you…\n“VOLCANIC ASH SWIRL CLOAK”!\p…What?\nIt's already over?"
}

text Route113_Text_LungIntro {
    "Thanks for finding me!\nBut we still have to battle!"
}

text Route113_Text_LungPostBattle {
    "You know what's crummy about hiding?\nIt's lonely if no one comes along."
}

text Route113_Text_MadelineDefeat {
    "Huff, huff…\nI am exhausted…"
}

text Route113_Text_MadelineIntro {
    "I use this parasol to ward off this\nfilthy, yucky volcanic ash from\nmy dear NUMEL."
}

text Route113_Text_MadelinePostBattle {
    "You're very good at this.\nI must say I'm impressed!"
}

text Route113_Text_SophieDefeat {
    "This is a dream.\nI'm sure of it…"
}

text Route113_Text_SophieIntro {
    "The warmth here is making me drowsy.\nBattle with me so I can stay awake."
}

text Route113_Text_SophiePostBattle {
    "Losing burns me up…\nI'm just going to sleep right here!\nZzz!"
}

text Route113_Text_WyattDefeat {
    "Y-you're all happy to win?\nEven though it's only me?"
}

text Route113_Text_WyattIntro {
    "Y-you want to battle with me?\nEven though I just caught my POKéMON?"
}

text Route113_Text_WyattPostBattle {
    "Oh, so now you want to say a word to\nthe loser?\pAren't you just the coolest?\nHumph!"
}