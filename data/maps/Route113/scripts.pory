text Route113_Text_RouteSign111 {
    format("ROUTE 113 {RIGHT_ARROW} ROUTE 111")
}

text Route113_Text_TrainerTipsRegisterKeyItems {
    format("TRAINER TIPS\p You may register one of the KEY ITEMS in your BAG as SELECT.\p Simply press SELECT to use the registered item conveniently.")
}

text Route113_Text_GlassWorkshopSign {
    format("GLASS WORKSHOP “Turning Volcanic Ash into Glass Items”")
}

text Route113_Text_RouteSignFallarbor {
    format("ROUTE 113 {LEFT_ARROW} FALLARBOR TOWN")
}


text Route113_Text_CobyDefeat {
    format("A… What?")
}

text Route113_Text_CobyIntro {
    format("Pfft, with these wings I can flick you away!")
}

text Route113_Text_CobyPostBattle {
    format("I don't know what to say when I get beaten so easily…")
}

text Route113_Text_DillonDefeat {
    format("You're some kind of strong!")
}

text Route113_Text_DillonIntro {
    format("The volcano's eruption is proof that the earth is alive.")
}

text Route113_Text_DillonPostBattle {
    format("Ouch! Owww! I can't see! I got ashes in my eyelashes!\pGet it? Ashes and eyelashes?\pOkay, that was bad, sorry…")
}

text Route113_Text_JaylenDefeat {
    format("Peeuuw! That stinks!")
}

text Route113_Text_JaylenIntro {
    format("Can you guess why it's so cool around here?")
}

text Route113_Text_JaylenPostBattle {
    format("The volcanic ash blocks the sun, so it doesn't get very warm.\pThat's good for me--I can't stand heat!")
}

text Route113_Text_LaoDefeat {
    format("With honor I admit defeat!")
}

text Route113_Text_LaoIntro {
    format("From out of the ashes I leap! Hiyah! I challenge thee!")
}

text Route113_Text_LaoPostBattle {
    format("I must refine the art of concealment. I bid thee farewell.")
}

text Route113_Text_LawrenceDefeat {
    format("Ehehe. We got beaten cleanly.")
}

text Route113_Text_LawrenceIntro {
    format("Were you maybe in the middle of gathering volcanic ashes?")
}

text Route113_Text_LawrencePostBattle {
    format("I ought to hide under the ashes, too.")
}

text Route113_Text_LungDefeat {
    format("I'll use my ninjutsu on you… “VOLCANIC ASH SWIRL CLOAK”!\p…What? It's already over?")
}

text Route113_Text_LungIntro {
    format("Thanks for finding me! But we still have to battle!")
}

text Route113_Text_LungPostBattle {
    format("You know what's crummy about hiding? It's lonely if no one comes along.")
}

text Route113_Text_MadelineDefeat {
    format("Huff, huff… I am exhausted…")
}

text Route113_Text_MadelineIntro {
    format("I use this parasol to ward off this filthy, yucky volcanic ash from my dear NUMEL.")
}

text Route113_Text_MadelinePostBattle {
    format("You're very good at this. I must say I'm impressed!")
}

text Route113_Text_SophieDefeat {
    format("This is a dream. I'm sure of it…")
}

text Route113_Text_SophieIntro {
    format("The warmth here is making me drowsy. Battle with me so I can stay awake.")
}

text Route113_Text_SophiePostBattle {
    format("Losing burns me up… I'm just going to sleep right here! Zzz!")
}

text Route113_Text_WyattDefeat {
    format("Y-you're all happy to win? Even though it's only me?")
}

text Route113_Text_WyattIntro {
    format("Y-you want to battle with me? Even though I just caught my POKéMON?")
}

text Route113_Text_WyattPostBattle {
    format("Oh, so now you want to say a word to the loser?\pAren't you just the coolest? Humph!")
}

text Route113_Text_FunWalkingThroughAsh {
    format("It's fun walking through the volcano's\nashes on the ground and grass.\pYou can see where you walked--it's\nreally neat!$")
}

text Route113_Text_AshCanBeFashionedIntoGlass {
    format("Wahahaha! Today's technology is a\nwondrous thing!\pTake this volcanic ash here.\nIt can be fashioned into glass.$")
}

text Route113_Text_TiaPostBattle {
    format("TIA: We have a lot of ashes! I think enough for a WHITE FLUTE!")
}

text Route113_Text_ToriPostBattle {
    format("TORI: How much ash do we have? Enough for a WHITE FLUTE, I hope.")
}
