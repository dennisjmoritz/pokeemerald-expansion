mapscripts LakeOfRage_MapScripts {
}


script LakeOfRage_EventScript_Sign1 {
    msgbox(LakeOfRage_Text_Sign1, MSGBOX_SIGN)
    end
}

text LakeOfRage_Text_Sign1 {
    format("LakeOfRage Sign 1")
}

script LakeOfRage_EventScript_SmithNPC1 {
    msgbox(LakeOfRage_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text LakeOfRage_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script LakeOfRage_EventScript_SmithNPC2 {
    msgbox(LakeOfRage_Text_SmithNPC2, MSGBOX_NPC)
    end
}

text LakeOfRage_Text_SmithNPC2 {
    format("Human beings are a disease; I'm the cure.$")
}

script LakeOfRage_EventScript_SmithNPC3 {
    msgbox(LakeOfRage_Text_SmithNPC3, MSGBOX_NPC)
    end
}

text LakeOfRage_Text_SmithNPC3 {
    format("Never send a human to do a machine's job.$")
}

script LakeOfRage_EventScript_SmithNPC4 {
    msgbox(LakeOfRage_Text_SmithNPC4, MSGBOX_NPC)
    end
}

text LakeOfRage_Text_SmithNPC4 {
    format("You hear that, Mr. Anderson? That is the sound of inevitability.$")
}

script LakeOfRage_EventScript_SmithNPC5 {
    msgbox(LakeOfRage_Text_SmithNPC5, MSGBOX_NPC)
    end
}

text LakeOfRage_Text_SmithNPC5 {
    format("We're not here because we're free; we're here because we're not free.$")
}
