text Route134_Text_AaronDefeat {
    format("I willingly concede defeat.")
}

text Route134_Text_AaronIntro {
    format("The savage tide in this area serves to make us stronger than ever.")
}

text Route134_Text_AaronPostBattle {
    format("We will return for more training at METEOR FALLS.\pIf you'd like, you should go, too. It will definitely toughen you up!")
}

text Route134_Text_AlexDefeat {
    format("Tuckered out again…")
}

text Route134_Text_AlexIntro {
    format("Okeydokey! That's enough rest, gang! It's time for a match!")
}

text Route134_Text_AlexPostBattle {
    format("My BIRD POKéMON get tired quickly after a long flight…")
}

text Route134_Text_HitoshiDefeat {
    format("… … … … … … … … … … … …")
}

text Route134_Text_HitoshiIntro {
    format("You're a POKéMON TRAINER. No need for words. We battle now.")
}

text Route134_Text_HitoshiPostBattle {
    format("It was I who challenged you, and yet I lost. I am deeply shamed…")
}

text Route134_Text_HudsonDefeat {
    format("Now, that's something!")
}

text Route134_Text_HudsonIntro {
    format("Listen, have you seen another SAILOR around here?")
}

text Route134_Text_HudsonPostBattle {
    format("Our boat drifted out to sea.\pMy buddy's a timid fellow, so I'm worried about him.")
}

text Route134_Text_JackDefeat {
    format("Aiyeeeeh!")
}

text Route134_Text_JackIntro {
    format("Even those POKéMON that can swim are carried along by the rapid currents.")
}

text Route134_Text_JackPostBattle {
    format("I think POKéMON enjoy the fast-running currents around these parts.")
}

text Route134_Text_KelvinDefeat {
    format("Awawawawah! Please, stop! Please!")
}

text Route134_Text_KelvinIntro {
    format("O-our boat! The tide carried it away!")
}

text Route134_Text_KelvinPostBattle {
    format("If we can't SURF, how are we supposed to get home?\pActually, I know a fainted POKéMON can still SURF, but it feels wrong.")
}

text Route134_Text_LaurelDefeat {
    format("Oopsie!")
}

text Route134_Text_LaurelIntro {
    format("My LUVDISC are looking for a fun match. Will you join us?")
}

text Route134_Text_LaurelPostBattle {
    format("There's a collector who's after the SCALES of LUVDISC.")
}

text Route134_Text_MarleyDefeat {
    format("I never knew such a technique existed! You've defeated us thoroughly.")
}

text Route134_Text_MarleyIntro {
    format("Can your POKéMON dodge our lightning-quick attacks?")
}

text Route134_Text_MarleyPostBattle {
    format("I haven't lost my passion for speed. I will try harder.")
}

text Route134_Text_ReynaDefeat {
    format("You're kidding! Explain how I lost!")
}

text Route134_Text_ReynaIntro {
    format("My POKéMON can't be taken down easily!")
}

text Route134_Text_ReynaPostBattle {
    format("Haha! You won, all right!\pI'll work my way back up by taking on TRAINERS I happen to meet!")
}