mapscripts Route134_MapScripts {
}

script Route134_EventScript_Aaron {
    trainerbattle_double(TRAINER_AARON, Route134_Text_AaronIntro, Route134_Text_AaronDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route134_Text_AaronPostBattle)
}

