text SootopolisCity_Text_GymSign {
    format("SOOTOPOLIS CITY POKéMON GYM LEADER: JUAN\p “The GYM LEADER with the beauty of pure water!”")
}

text SootopolisCity_Text_CitySign {
    format("SOOTOPOLIS CITY\p “The mystical city where history slumbers.”")
}

text SootopolisCity_Text_YouBroughtFlyingMon {
    format("Oh?\pIt was you who brought that flying\nPOKéMON here?\pWell, aren't you amazing!$")
}

text SootopolisCity_Text_TryingMeaninglessToPokemon {
    format("ARCHIE: KYOGRE and GROUDON both\nflew off to who knows where.\pThe weather in HOENN has returned\nto its normal state…\pHaha…\nHahaha…\pMaybe what we were trying to do was\nsomething small, even meaningless,\lto POKéMON…$")
}

text SootopolisCity_Text_PrettyMonCameFromSky {
    format("A pretty POKéMON came down from\nthe sky…$")
}

text SootopolisCity_Text_LeadSuperiorTrainerToCave {
    format("A person with a strong will and\nsuperior talent…\pA TRAINER who has knowledge and\nexperience of many kinds of POKéMON…\pIf such a person were to appear, I was\ninstructed by WALLACE to lead that\lTRAINER to this CAVE.$")
}

text SootopolisCity_Text_CaveOfOriginSleepsToo {
    format("This is the CAVE OF ORIGIN…\pWith the passing of the crisis,\nthe cave, too, shall sleep…$")
}

text SootopolisCity_Text_GreenOneSettlesThings {
    format("I was wondering which one would win,\nthe red one or the blue one, but, oh no,\lit's the green one that settles things!\pTalk about a huge turn of events!$")
}

text SootopolisCity_Text_SawLegendWithOwnEyes {
    format("There's an ancient legend that claims\nthe land and sea were shaped by\la colossal battle between POKéMON.\pWell, I saw that happen with\nmy very own eyes!\pWhoa! I never expected to be\nwitness to something this huge!$")
}

text SootopolisCity_Text_FearedWorstWhenPokemonFlewDown {
    format("When that third POKéMON flew down,\nI feared the worst.$")
}

text SootopolisCity_Text_DazzledByMentor {
    format("WALLACE: I'm sure that you will be\ndazzled by my mentor's breathtakingly\lelegant battle style.$")
}

text SootopolisCity_Text_PhysicallyFitLivingHere {
    format("Diving in the sea. Climbing up and\ndown stairs all the time…\pIf you live in this town, you end up\ngetting physically fit.$")
}

text SootopolisCity_Text_WonderWhatWorldIsLike {
    format("I… I've never been out of this city.\pI wonder what the world is like on\nthe other side of this round sky?$")
}

text SootopolisCity_Text_SootopolisDidntGetWrecked {
    format("SOOTOPOLIS CITY didn't get wrecked!$")
}

text SootopolisCity_Text_HaventYouScaledSkyPillar {
    format("WALLACE: Oh?\n{PLAYER}{KUN}?\pHaven't you scaled the SKY PILLAR\nyet?\pI'm sure that you can make it to\nthe top of the SKY PILLAR…$")
}

text SootopolisCity_Text_ThankYouForHelpAcceptThis {
    format("WALLACE: {PLAYER}{KUN}…\nMy eyes didn't deceive me.\pThanks to your help, SOOTOPOLIS…\nNo, all of HOENN was saved.\pOn behalf of the people, I thank you.\pThis is a gift from me.\nPlease accept it.$")
}

text SootopolisCity_Text_WhereDidLegendariesGo {
    format("GROUDON and KYOGRE…\nWhere did they go?\pWill they cause droughts or downpours\nsomewhere else?$")
}

text SootopolisCity_Text_FlyingMonStoppedRampage {
    format("That flying POKéMON came down from\nthe sky and stopped the rampaging\lPOKéMON…$")
}

text SootopolisCity_Text_WhatIsThatGreenPokemon {
    format("What? What? What?\nWhat is that green POKéMON?!$")
}

text SootopolisCity_Text_NightSkyFavoriteScenery {
    format("A circle of a night sky framed by\nthe crater of a volcano…\pAnd in that ring, stars flicker and\nblink as if they were alive…\lIt's my favorite scenery.$")
}

text SootopolisCity_Text_KnowWhatsNeededToHelpHim {
    format("STEVEN: I think you have what's\nneeded to help him…$")
}

text SootopolisCity_Text_NeverBeenToSkyPillar {
    format("STEVEN: The SKY PILLAR…\pI've never been there.\nI wonder where it could be?$")
}

text SootopolisCity_Text_InvolvedWithCrisisComeWithMe {
    format("STEVEN: Those POKéMON fighting…\nGROUDON… And KYOGRE…\pThe two super-ancient POKéMON\nwere awakened from a long sleep…\pAnd now they are smashing each other\nwith their uncontrollable energy…\p…{PLAYER}{KUN}.\pYou being here now I'll take to mean\nthat you're prepared to become\linvolved in this crisis.\pWell, then, there's someone that\nI'd like you to meet.\pCome with me, please.$")
}

text SootopolisCity_Text_CityRegainedCalm {
    format("The city has regained its calm…$")
}

text SootopolisCity_Text_AwakenedPokemonClash {
    format("Oh, my…\pThe clash between the two awakened\nPOKéMON was quelled by the awakening\lof a third POKéMON…$")
}

text SootopolisCity_Text_MaxieArchieLeft {
    format("STEVEN: It looks like both MAXIE and\nARCHIE have gone away somewhere.\pPerhaps they've gone to MT. PYRE to\nreturn those ORBS…$")
}

text SootopolisCity_Text_AfterAllOurScheming {
    format("MAXIE: So the super-ancient POKéMON\nweren't only GROUDON and KYOGRE…\pAfter all our fruitless scheming and\nfrantic efforts, that one POKéMON's\lsimple action puts everything right\lagain as if nothing had happened…\pFu…\nFuhahaha…$")
}

text SootopolisCity_Text_GiganticPokemonFight {
    format("When two POKéMON that gigantic\nare fighting that savagely, there's\lnot much that we can do.$")
}

text SootopolisCity_Text_ThatWasWicked {
    format("Wow!\nThat was wicked!$")
}
