IlexForest_Text_Sign1::
# 10 "data/maps/IlexForest/scripts.pory"
	.string "IlexForest Sign 1$"

IlexForest_Text_SmithNPC1::
# 19 "data/maps/IlexForest/scripts.pory"
	.string "I've been expecting you, Mr. Anderson.$"

IlexForest_Text_SmithNPC2::
# 28 "data/maps/IlexForest/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

IlexForest_Text_SmithNPC3::
# 37 "data/maps/IlexForest/scripts.pory"
	.string "Never send a human to do a machine's\n"
	.string "job.$"

IlexForest_Text_SmithNPC4::
# 46 "data/maps/IlexForest/scripts.pory"
	.string "You hear that, Mr. Anderson? That is the\n"
	.string "sound of inevitability.$"

IlexForest_Text_SmithNPC5::
# 55 "data/maps/IlexForest/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

IlexForest_Text_SmithNPC6::
# 64 "data/maps/IlexForest/scripts.pory"
	.string "It's the question that drives us, Neo.$"

IlexForest_Text_SmithNPC7::
# 73 "data/maps/IlexForest/scripts.pory"
	.string "Unfortunately, no one can be told what\n"
	.string "the Matrix is.$"

IlexForest_Text_SmithNPC8::
# 82 "data/maps/IlexForest/scripts.pory"
	.string "I know kung fu.$"

IlexForest_Text_SmithNPC9::
# 91 "data/maps/IlexForest/scripts.pory"
	.string "Dodge this.$"

IlexForest_Text_SmithNPC10::
# 100 "data/maps/IlexForest/scripts.pory"
	.string "Choice is an illusion created between\n"
	.string "those with power and those without.$"

IlexForest_Text_SmithNPC11::
# 109 "data/maps/IlexForest/scripts.pory"
	.string "Hope is an illusion, Mr. Anderson.$"
