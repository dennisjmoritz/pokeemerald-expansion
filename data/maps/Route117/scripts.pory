text Route117_Text_DayCareSign {
    format("POKéMON DAY CARE Let us raise your POKéMON.")
}

text Route117_Text_RouteSignVerdanturf {
    format("ROUTE 117 {LEFT_ARROW} VERDANTURF TOWN")
}

text Route117_Text_RouteSignMauville {
    format("ROUTE 117 {RIGHT_ARROW} MAUVILLE CITY")
}


text Route117_Text_AishaDefeat {
    format("I don't waste any time being angry over a loss--I would rather train.")
}

text Route117_Text_AishaIntro {
    format("Concentrate on getting the win. That's how I battle!")
}

text Route117_Text_AishaPostBattle {
    format("I think that if you worry about losing, you're more likely to lose.")
}

text Route117_Text_BrandiDefeat {
    format("Astonishing!")
}

text Route117_Text_BrandiIntro {
    format("Let me demonstrate the power hidden within a PSYCHIC POKéMON!")
}

text Route117_Text_BrandiPostBattle {
    format("PSYCHIC POKéMON are complex. You should try catching some.")
}

text Route117_Text_DerekDefeat {
    format("My ineptitude also remains unchanged…")
}

text Route117_Text_DerekIntro {
    format("Once a BUG CATCHER! And now a BUG MANIAC!\pBut my love for POKéMON remains unchanged!")
}

text Route117_Text_DerekPostBattle {
    format("All I did was follow my heart, and now they call me a BUG MANIAC…\pStill, I am an expert on BUG POKéMON, so it's only natural that they call me a BUG MANIAC.")
}

text Route117_Text_DylanDefeat {
    format("I ran out of energy!")
}

text Route117_Text_DylanIntro {
    format("I'm in the middle of a triathlon, but, whatever, let's have a battle!")
}

text Route117_Text_DylanPostBattle {
    format("I may have blown it…\pI might have dropped to last during that battle…")
}

text Route117_Text_IsaacDefeat {
    format("You've raised yours superbly…")
}

text Route117_Text_IsaacIntro {
    format("Listen, could I get you to battle the POKéMON I'm raising?")
}

text Route117_Text_IsaacPostBattle {
    format("POKéMON isn't all about power.\pPolishing a unique aspect of one's character is another way of enjoying POKéMON.")
}

text Route117_Text_LydiaDefeat {
    format("Yes, they are growing properly.")
}

text Route117_Text_LydiaIntro {
    format("Please, allow me to evaluate if you have raised your POKéMON properly.")
}

text Route117_Text_LydiaPostBattle {
    format("Try raising POKéMON with more attention to their character traits.")
}

text Route117_Text_MariaDefeat {
    format("I need to get more practices in, I guess.")
}

text Route117_Text_MariaIntro {
    format("I do my triathlon training with POKéMON, so I'm pretty confident about my speed.")
}

text Route117_Text_MariaPostBattle {
    format("Training is meaningful only if you keep it up regularly.\pOkay! I'll resume my training! Tomorrow!")
}

text Route117_Text_MelinaDefeat {
    format("Oh, that's quite impressive!")
}

text Route117_Text_MelinaIntro {
    format("Isn't it nice? To battle while looking at pretty flowers?")
}

text Route117_Text_MelinaPostBattle {
    format("It feels wonderful to go for a jog while looking at flowers.")
}

text Route117_Text_ArentTheseFlowersPretty {
    format("What do you think?\nAren't these flowers pretty?\pI planted them all!$")
}

text Route117_Text_AirIsTastyHere {
    format("The air is tasty here!$")
}

text Route117_Text_DayCarePokemonHadNewMove {
    format("I left my POKéMON at the DAY CARE.\pWhen I got it back, it had a new move\nthat I didn't teach it.\lI was really, really surprised.$")
}
