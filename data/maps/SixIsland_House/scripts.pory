mapscripts SixIsland_House_MapScripts {
}

script SixIsland_House_EventScript_OldMan {
    msgbox(SixIsland_House_Text_GoodPlaceForNatureAndHistory, MSGBOX_NPC)
    end
}


text SixIsland_House_Text_GoodPlaceForNatureAndHistory {
    format("There's nothing that young people'd\nfind exciting here on this island.\pBut, this is a good place in terms\nof nature and history.\pRelax and enjoy your stay.$")
}
