    // goto_if_eq VAR_RESULT, NO, SixIsland_RuinValley_EventScript_IgnoreDottedHoleDoor
    msgbox(SixIsland_RuinValley_Text_SeveralDotsOnTheDoor, MSGBOX_DEFAULT)
    // braillemessage Braille_Text_Cut
    // waitbuttonpress
    // releaseall
    end
}

script SixIsland_RuinValley_EventScript_Scientist {
    end
}


text SixIsland_RuinValley_Text_CheckDoorMoreThoroughly {
    format("The door doesn't budge at all. Check it more thoroughly?")
}

text SixIsland_RuinValley_Text_SeveralDotsOnTheDoor {
    format("On closer inspection, there are several dots on the door…")
}
