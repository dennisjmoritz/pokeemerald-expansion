mapscripts ResortArea_MapScripts {
}


script ResortArea_EventScript_Sign1 {
    msgbox(ResortArea_Text_Sign1, MSGBOX_SIGN)
    end
}

text ResortArea_Text_Sign1 {
    format("ResortArea Sign 1")
}

script ResortArea_EventScript_SmithNPC1 {
    msgbox(ResortArea_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text ResortArea_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script ResortArea_EventScript_SmithNPC2 {
    msgbox(ResortArea_Text_SmithNPC2, MSGBOX_NPC)
    end
}

text ResortArea_Text_SmithNPC2 {
    format("Human beings are a disease; I'm the cure.$")
}

script ResortArea_EventScript_SmithNPC3 {
    msgbox(ResortArea_Text_SmithNPC3, MSGBOX_NPC)
    end
}

text ResortArea_Text_SmithNPC3 {
    format("Never send a human to do a machine's job.$")
}
