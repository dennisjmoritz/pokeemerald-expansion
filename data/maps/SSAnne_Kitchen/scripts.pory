text SSAnne_Kitchen_Text_BusyOutOfTheWay {
    format("You, mon petit!\nWe're busy here!\lOut of the way!$")
}

text SSAnne_Kitchen_Text_SawOddBerryInTrash {
    format("I saw an odd BERRY in the trash.\nI wonder what that was?$")
}

text SSAnne_Kitchen_Text_SoBusyImDizzy {
    format("I'm so busy I'm getting dizzy!\nYou have to give me room here!$")
}

text SSAnne_Kitchen_Text_PeelSpudsEveryDay {
    format("Hum-de-hum-de-ho…\pI peel spuds every day!\nHum-hum…$")
}

text SSAnne_Kitchen_Text_HearAboutSnorlaxItsAGlutton {
    format("Did you hear about SNORLAX?\nIt's a glutton.\pNo other POKéMON eats and sleeps\nthe way SNORLAX can and does!$")
}

text SSAnne_Kitchen_Text_OnlyGetToPeelOnions {
    format("Snivel… Sniff…\pI only get to peel onions…\nSnivel…$")
}
