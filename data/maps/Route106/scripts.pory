mapscripts Route106_MapScripts {
}

script Route106_EventScript_Douglas {
    trainerbattle_double(TRAINER_DOUGLAS, Route106_Text_DouglasIntro, Route106_Text_DouglasDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route106_Text_DouglasPostBattle)
}

script Route106_EventScript_Elliot {
    trainerbattle_double(TRAINER_ELLIOT, Route106_Text_ElliotIntro, Route106_Text_ElliotDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route106_Text_ElliotPostBattle)
}

script Route106_EventScript_Kyla {
    trainerbattle_double(TRAINER_KYLA, Route106_Text_KylaIntro, Route106_Text_KylaDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route106_Text_KylaPostBattle)
}

script Route106_EventScript_Ned {
    trainerbattle_double(TRAINER_NED, Route106_Text_NedIntro, Route106_Text_NedDefeated, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route106_Text_NedPostBattle)
}

script Route106_EventScript_TrainerTipsSign {
    msgbox(Route106_Text_TrainerTips, MSGBOX_SIGN)
    end
}


text Route106_Text_TrainerTips {
    format("TRAINER TIPS\p Advice on catching POKéMON with a ROD: Press the A Button if you get a bite.")
}


text Route106_Text_DouglasDefeated {
    "I give up!"
}

text Route106_Text_DouglasIntro {
    "Hahahah! I'm a lousy runner, but in\nthe water you can't catch me!"
}

text Route106_Text_DouglasPostBattle {
    "I wouldn't lose in a swim race…"
}

text Route106_Text_ElliotDefeated {
    "Like in deep-sea fishing, I lost\nspectacularly!"
}

text Route106_Text_ElliotIntro {
    "Which do you prefer, fishing in the\nsea or a stream?"
}

text Route106_Text_ElliotPostBattle {
    "Fishing is the greatest whether it's\nin the sea or a stream.\nYou agree with me, right?"
}

text Route106_Text_KylaDefeated {
    "Did you take it easy on me by any\nchance?"
}

text Route106_Text_KylaIntro {
    "The sea is my backyard. I'm not going\nto take it easy because you're a kid!"
}

text Route106_Text_KylaPostBattle {
    "Drifting along with the waves…\nI love it! Why don't you give it a try?"
}

text Route106_Text_NedDefeated {
    "I lost because I'm trying to not go\nto the washroom…"
}

text Route106_Text_NedIntro {
    "What do people do if they need to go\nto a washroom?\pWhat if my ROD hooks a big one while\nI'm in the washroom? I just can't go…"
}

text Route106_Text_NedPostBattle {
    "Oh, no! I've got this feeling I'll hook\na big one!"
}