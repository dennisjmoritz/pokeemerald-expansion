text FallarborTown_Text_TownSign {
    format("FALLARBOR TOWN “A farm community with small gardens.”")
}

text FallarborTown_Text_MoveTutorSign {
    format("MOVE TUTOR'S HOUSE “New moves taught to POKéMON.”")
}

text FallarborTown_Text_BattleTentSign {
    format("BATTLE TENT FALLARBOR SITE “May the Greatest Teams Gather!”")
}

text FallarborTown_Text_Azurill {
    format("AZURILL: Rooreelooo.$")
}

text FallarborTown_Text_HaveYouChallengedFlannery {
    format("Have you already challenged FLANNERY,\nthe LEADER of LAVARIDGE GYM?\pThe girl's grandfather was famous.\nHe was one of the ELITE FOUR in the\lPOKéMON LEAGUE at one point.\pIt wouldn't surprise me to see FLANNERY\nbecome a great TRAINER in her own\lright.$")
}

text FallarborTown_Text_MyPreciousAzurill {
    format("See! Take a look!\nThis is my precious AZURILL!\pIt's slick and smooth and plushy, too!$")
}

text FallarborTown_Text_RegionKnownForMeteors {
    format("This region's been known for meteors\nsince the olden days.\pThey say METEOR FALLS was gouged out\nby a falling meteorite long ago.$")
}
