text MossdeepCity_House1_Text_DoesntLikeOrDislikePokeblocks {
    format("It doesn't appear to like or dislike\nany {POKEBLOCK}S.$")
}

text MossdeepCity_House1_Text_HmmYourPokemon {
    format("Hmm!\nYour {STR_VAR_1}…$")
}

text MossdeepCity_House1_Text_HusbandCanTellPokeblockMonLikes {
    format("My husband can tell what kind of\n{POKEBLOCK}S a POKéMON likes at a glance.$")
}
