text CeruleanCity_Text_TrainerTipsHeldItems {
    format("TRAINER TIPS\p A POKéMON can be made to hold an item.\p Some items can even be used by the holding POKéMON in battle.")
}

text CeruleanCity_Text_GymSign {
    format("CERULEAN CITY POKéMON GYM LEADER: MISTY\l The Tomboyish Mermaid!")
}

text CeruleanCity_Text_CitySign {
    format("CERULEAN CITY A Mysterious, Blue Aura Surrounds\l It")
}

text CeruleanCity_Text_BikeShopSign {
    format("Grass and caves handled easily! BIKE SHOP")
}

text CeruleanCity_Text_PokemonEncyclopediaAmusing {
    format("You're making an encyclopedia on\nPOKéMON? That sounds amusing.$")
}

text CeruleanCity_Text_ThisIsCeruleanCave {
    format("This is CERULEAN CAVE.\pHorribly strong POKéMON live inside\nthere.\pIt takes a very special TRAINER to\nbe allowed inside there.\pYou'd have to be strong enough to\nbecome the POKéMON LEAGUE\lCHAMPION for starters.\pAnd, you would have to have\nmade a great achievement.$")
}

text CeruleanCity_Text_TrainerLifeIsToughIsntIt {
    format("You're a TRAINER, too?\pCollecting, battling…\nIt's a tough life, isn't it?$")
}
