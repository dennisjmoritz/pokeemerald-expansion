mapscripts SootopolisCity_MysteryEventsHouse_1F_MapScripts {
}

script SootopolisCity_MysteryEventsHouse_1F_EventScript_OldMan {
    end
}

text SootopolisCity_MysteryEventsHouse_1F_Text_ThatWasSuperlative {
    format("That was superlative!\pWhy, it was like seeing myself in\nmy youth again!$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_BrilliantStandoff {
    format("So, it became a standoff.\pIt was a brilliant match in which\nneither side conceded a step!$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_KeepItTo3On3 {
    format("Oh, good, good!\pBut my house isn't all that sturdy.\pCould I ask you to keep it down to\na 3-on-3 match?$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_TooBadForYou {
    format("Ah, too bad for you!\pBut it was a good match.\nI hope you can win next time.$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_YouWontBattle {
    format("You won't battle? I'm disappointed\nthat I can't see you battle…$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_ChallengeVisitingTrainer {
    format("A TRAINER named {STR_VAR_1}\nis visiting my home.\pWould you like to challenge\n{STR_VAR_1}?$")
}

text SootopolisCity_MysteryEventsHouse_1F_Text_OnlyAmusementWatchingBattles {
    format("When I was young, I traveled the world\nas a POKéMON TRAINER.\pNow that I've become an old buzzard,\nmy only amusement is watching young\lTRAINERS battle.$")
}
