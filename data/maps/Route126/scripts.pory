mapscripts Route126_MapScripts {
}

script Route126_EventScript_Barry {
    trainerbattle_double(TRAINER_BARRY, Route126_Text_BarryIntro, Route126_Text_BarryDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route126_Text_BarryPostBattle)
}

