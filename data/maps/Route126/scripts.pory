text Route126_Text_BarryDefeat {
    format("I admit it! You win!")
}

text Route126_Text_BarryIntro {
    format("Swimming is a full-body workout! You will get fit!")
}

text Route126_Text_BarryPostBattle {
    format("Thanks to my daily swimming routine… Look! Feast your eyes on this physique!")
}

text Route126_Text_BrendaDefeat {
    format("Oh, noooooh!")
}

text Route126_Text_BrendaIntro {
    format("Hello, kiddo! Want a battle with me?")
}

text Route126_Text_BrendaPostBattle {
    format("I love frolicking with POKéMON in the sea like this!")
}

text Route126_Text_DeanDefeat {
    format("I was done in?")
}

text Route126_Text_DeanIntro {
    format("This towering white mountain of rock is SOOTOPOLIS CITY.")
}

text Route126_Text_DeanPostBattle {
    format("I can't find the entrance to SOOTOPOLIS. Where could it be?")
}

text Route126_Text_IsobelDefeat {
    format("Ack! Why, you… Glub!")
}

text Route126_Text_IsobelIntro {
    format("If seawater gets up your nose, doesn't it feel terrible?")
}

text Route126_Text_IsobelPostBattle {
    format("Ooh, I choked on some water! It's bitter! It's salty!!")
}

text Route126_Text_LeonardoDefeat {
    format("Sheesh, getting greedy didn't do a thing for me.")
}

text Route126_Text_LeonardoIntro {
    format("I couldn't even swim last year, but now I'm a decent SWIMMER.\pI think I'm capable of anything now.")
}

text Route126_Text_LeonardoPostBattle {
    format("If you practice at something, you will get better at it.\pYou're young--don't be afraid to try all sorts of things!")
}

text Route126_Text_NikkiDefeat {
    format("My fantasy burst as if it were a bubble! Blub, blub, blub…")
}

text Route126_Text_NikkiIntro {
    format("Ufufufufu! I'm a mermaid!")
}

text Route126_Text_NikkiPostBattle {
    format("You thrashed me… I want to disappear in a wave of despair…")
}

text Route126_Text_PabloDefeat {
    format("Whoops! Too strong! Not bad! Not bad at all!")
}

text Route126_Text_PabloIntro {
    format("Check out this sculpted body! I'm more cut than a BLACK BELT!")
}

text Route126_Text_PabloPostBattle {
    format("Losing to you stimulated my senses! I'll train myself and POKéMON harder!")
}

text Route126_Text_SiennaDefeat {
    format("You had more heart!")
}

text Route126_Text_SiennaIntro {
    format("I'm throwing my whole heart into this!")
}

text Route126_Text_SiennaPostBattle {
    format("I need to cool down now… I think I'll go for a dive.")
}