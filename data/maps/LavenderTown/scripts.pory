mapscripts LavenderTown_MapScripts {
}

script LavenderTown_EventScript_Boy {
    msgbox(LavenderTown_Text_GhostsAppearedInTower, MSGBOX_NPC)
    end
}

script LavenderTown_EventScript_LittleGirl {
    msgbox(LavenderTown_Text_DoYouBelieveInGhosts, MSGBOX_YESNO)
    end
}

script LavenderTown_EventScript_PokemonTowerSign {
    msgbox(LavenderTown_Text_PokemonTowerSign, MSGBOX_SIGN)
    end
}

script LavenderTown_EventScript_SilphScopeNotice {
    msgbox(LavenderTown_Text_SilphScopeNotice, MSGBOX_SIGN)
    end
}

script LavenderTown_EventScript_TownSign {
    msgbox(LavenderTown_Text_TownSign, MSGBOX_SIGN)
    end
}

script LavenderTown_EventScript_VolunteerHouseSign {
    msgbox(LavenderTown_Text_VolunteerPokemonHouse, MSGBOX_SIGN)
    end
}

script LavenderTown_EventScript_WorkerM {
    msgbox(LavenderTown_Text_TownKnownAsMonGraveSite, MSGBOX_NPC)
    end
}


text LavenderTown_Text_TownSign {
    format("LAVENDER TOWN The Noble Purple Town")
}

text LavenderTown_Text_PokemonTowerSign {
    format("POKéMON TOWER Becalm the Spirits of POKéMON")
}

text LavenderTown_Text_SilphScopeNotice {
    format("New SILPH SCOPE! Make the Invisible Plain to See!\p SILPH CO.")
}

text LavenderTown_Text_VolunteerPokemonHouse {
    format("LAVENDER VOLUNTEER POKéMON HOUSE")
}

text LavenderTown_Text_GhostsAppearedInTower {
    format("Ghosts appeared in POKéMON TOWER.\pI think they're the spirits of\nPOKéMON that the ROCKETS killed.$")
}

text LavenderTown_Text_DoYouBelieveInGhosts {
    format("Do you believe in ghosts?$")
}

text LavenderTown_Text_TownKnownAsMonGraveSite {
    format("This town is known as the grave\nsite of POKéMON.\pMemorial services are held in\nPOKéMON TOWER.$")
}
