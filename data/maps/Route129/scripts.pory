text Route129_Text_AllisonDefeat {
    format("I was sure I'd win!")
}

text Route129_Text_AllisonIntro {
    format("I'm in the middle of a triathlon, but, sure, why don't we battle?")
}

text Route129_Text_AllisonPostBattle {
    format("Do you know what's the greatest thing about triathlons?\pTesting the limits of your own strength and endurance against Mother Nature!")
}

text Route129_Text_ChaseDefeat {
    format("Wroooaaar! I failed to win!")
}

text Route129_Text_ChaseIntro {
    format("This is my first triathlon. I'm all tense and nervous!")
}

text Route129_Text_ChasePostBattle {
    format("If I'm all tensed up, I won't be able to give it my all.")
}

text Route129_Text_ClarenceDefeat {
    format("Winning sure isn't easy.")
}

text Route129_Text_ClarenceIntro {
    format("Surfing isn't as easy as it seems, isn't that right?")
}

text Route129_Text_ClarencePostBattle {
    format("You have your sights on the POKéMON LEAGUE? Keep at it!")
}

text Route129_Text_ReedDefeat {
    format("Beat, I'm beaten. That's it, done!")
}

text Route129_Text_ReedIntro {
    format("Say hey, hey! Let's get on with it!")
}

text Route129_Text_ReedPostBattle {
    format("There's nothing for a loser. Time for me to beat it home.")
}

text Route129_Text_TishaDefeat {
    format("Oh, my. I wanted to relax a little more…")
}

text Route129_Text_TishaIntro {
    format("What's the hurry? Let's take it slow and easy.")
}

text Route129_Text_TishaPostBattle {
    format("Don't you hate making mistakes when you're in a rush?\pThat's why I try to take things slowly.")
}