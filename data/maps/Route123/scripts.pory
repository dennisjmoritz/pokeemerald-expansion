    trainerbattle_double(TRAINER_ALBERTO, Route123_Text_AlbertoIntro, Route123_Text_AlbertoDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route123_Text_AlbertoPostBattle)
}

