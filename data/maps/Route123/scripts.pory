text Route123_Text_RouteSign {
    format("{RIGHT_ARROW} ROUTE 123 {LEFT_ARROW} ROUTE 118")
}

text Route123_Text_RouteSignMtPyre {
    format("{UP_ARROW} MT. PYRE “Forbidden to the faint of heart.”")
}

text Route123_Text_BerryMastersHouse {
    format("BERRY MASTER'S HOUSE")
}


text Route123_Text_AlbertoDefeat {
    format("Even in defeat, BIRD POKéMON are cool!")
}

text Route123_Text_AlbertoIntro {
    format("I have to tell you, BIRD POKéMON are my obsession!\pBirds are cool! They're the best!")
}

text Route123_Text_AlbertoPostBattle {
    format("I gather BIRD POKéMON feathers that scatter during battles.\pI'm going to make a hat with BIRD POKéMON feathers.")
}

text Route123_Text_BraxtonDefeat {
    format("Oh, you're worthy, all right!")
}

text Route123_Text_BraxtonIntro {
    format("You seem to have a big collection of GYM BADGES.\pLet me see if you're actually worthy of those BADGES!")
}

text Route123_Text_BraxtonPostBattle {
    format("You did your BADGES proud in that match!")
}

text Route123_Text_CameronDefeat {
    format("I feel sad…")
}

text Route123_Text_CameronIntro {
    format("Being a psychic is about willpower.\pI've willed myself not to lose to anyone. That makes me strong!")
}

text Route123_Text_CameronPostBattle {
    format("Being a psychic is about willpower. I thought I wouldn't lose to you…")
}

text Route123_Text_DavisDefeat {
    format("Waaaah! You meanie!")
}

text Route123_Text_DavisIntro {
    format("This is my awesome BUG POKéMON! My big brother got it for me.")
}

text Route123_Text_DavisPostBattle {
    format("Don't tell my brother I lost. You have to keep it a secret!")
}

text Route123_Text_EdDefeat {
    format("I kind of like your POKéMON.")
}

text Route123_Text_EdIntro {
    format("When there are no TRAINERS around, I let my POKéMON battle each other. I watch them.")
}

text Route123_Text_EdPostBattle {
    format("Hehe, I'm swiping your battling ideas! I think they'll make me better.")
}

text Route123_Text_FernandoDefeat {
    format("Hey, hold it! I was still playing the intro!")
}

text Route123_Text_FernandoIntro {
    format("I'll turn your lights out while I rip through this tune!")
}

text Route123_Text_FernandoPostBattle {
    format("You're rock steady. I'd like to write a tune about you.")
}

text Route123_Text_FrederickDefeat {
    format("Ah, a mighty capable child! Let me contribute to your allowance.")
}

text Route123_Text_FrederickIntro {
    format("Hello, child! Can you spare some time?")
}

text Route123_Text_FrederickPostBattle {
    format("Contribute to your allowance? Wasn't the prize money enough?")
}

text Route123_Text_JackiDefeat {
    format("Overwhelmed!")
}

text Route123_Text_JackiIntro {
    format("Don't be too happy if your POKéMON develop psychic powers.\pYou need to refine those powers to make them really useful.")
}

text Route123_Text_JackiPostBattle {
    format("We all have psychic powers. We've just forgotten how to use them.")
}

text Route123_Text_JazmynDefeat {
    format("There goes my confidence…")
}

text Route123_Text_JazmynIntro {
    format("My confidence will get a boost by beating someone obviously strong!")
}

text Route123_Text_JazmynPostBattle {
    format("They say that you can't judge a person by their appearance.\pBut often, their looks don't lie…")
}

text Route123_Text_JonasDefeat {
    format("If you don't lose, how am I supposed to have fun playing ninja?")
}

text Route123_Text_JonasIntro {
    format("I lay in ambush, and a TRAINER has landed in my trap!")
}

text Route123_Text_JonasPostBattle {
    format("I'm going to ambush a weaker-looking TRAINER next time.")
}

text Route123_Text_KayleyDefeat {
    format("You're better than me by about five times!")
}

text Route123_Text_KayleyIntro {
    format("I just bought this parasol. My cuteness should be up by a third!")
}

text Route123_Text_KayleyPostBattle {
    format("Using accessories effectively is the secret behind fashion appeal.")
}

text Route123_Text_KindraDefeat {
    format("Overflowing with vitality…")
}

text Route123_Text_KindraIntro {
    format("MT. PYRE… Where the spirits of POKéMON sleep… Will your POKéMON sleep?")
}

text Route123_Text_KindraPostBattle {
    format("MT. PYRE… Where the spirits of POKéMON sleep…\pIt must overflow with a power that soothes spirits…")
}

text Route123_Text_VioletDefeat {
    format("Oh… I smell the bitter scent of misery…")
}

text Route123_Text_VioletIntro {
    format("They say that good times are filled with good aromas.")
}

text Route123_Text_VioletPostBattle {
    format("The BERRY MASTER's garden is filled with uplifting fragrances.")
}

text Route123_Text_WendyDefeat {
    format("You passed with flying colors!")
}

text Route123_Text_WendyIntro {
    format("Want to determine how strong you are? I'll be the test!")
}

text Route123_Text_WendyPostBattle {
    format("To best even me… Your strength is marvelous!")
}

text Route123_Text_CheckTreesWithMyGrassMon {
    format("I check trees with my GRASS-type\nPOKéMON. I'm like a tree doctor.$")
}

text Route123_Text_MiuPostBattle {
    format("MIU: TRAINER, your POKéMON are strong because you are friends.")
}

text Route123_Text_YukiPostBattle {
    format("YUKI: Why are you so strong? We've never lost before.")
}
