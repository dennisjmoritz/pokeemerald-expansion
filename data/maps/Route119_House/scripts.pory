}

text Route119_House_Text_RumorAboutCaveOfOrigin {
    format("I heard about a cave called the CAVE\nOF ORIGIN.\pPeople rumor that the spirits of\nPOKéMON are revived there. Could\lsomething like that really happen?$")
}
