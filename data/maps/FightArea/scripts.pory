mapscripts FightArea_MapScripts {
}

script FightArea_EventScript_SmithNPC1 {
    msgbox(FightArea_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text FightArea_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script FightArea_EventScript_SmithNPC2 {
    msgbox(FightArea_Text_SmithNPC2, MSGBOX_NPC)
    end
}

text FightArea_Text_SmithNPC2 {
    format("Human beings are a disease; I'm the cure.$")
}

script FightArea_EventScript_SmithNPC3 {
    msgbox(FightArea_Text_SmithNPC3, MSGBOX_NPC)
    end
}

text FightArea_Text_SmithNPC3 {
    format("Never send a human to do a machine's job.$")
}

script FightArea_EventScript_SmithNPC4 {
