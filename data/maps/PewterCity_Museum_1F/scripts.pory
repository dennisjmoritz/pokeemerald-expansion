text PewterCity_Museum_1F_Text_AerodactylFossil {
    format("AERODACTYL Fossil A primitive and rare POKéMON.")
}

text PewterCity_Museum_1F_Text_KabutopsFossil {
    format("KABUTOPS Fossil A primitive and rare POKéMON.")
}

text PewterCity_Museum_1F_Text_BeautifulPieceOfAmber {
    format("There is a beautiful piece of\nAMBER in a clear gold color.$")
}

text PewterCity_Museum_1F_Text_ShouldBeGratefulForLongLife {
    format("I should be grateful for my long\nlife.\pNever did I think I would get to\nsee the bones of a dragon!$")
}

text PewterCity_Museum_1F_Text_WeHaveTwoFossilsOnExhibit {
    format("We have two fossils of rare,\nprehistoric POKéMON on exhibit.$")
}
