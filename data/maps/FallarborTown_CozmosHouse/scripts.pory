script FallarborTown_CozmosHouse_EventScript_ProfCozmo {
    end
}

text FallarborTown_CozmosHouse_Text_MayIHaveMeteorite {
    format("PROF. COZMO: Please, may I have that\nMETEORITE?\pI'm not asking for it for free.\nHow about in exchange for this TM?$")
}

text FallarborTown_CozmosHouse_Text_CrushedWithDisappointment {
    format("PROF. COZMO: Oh, but…\nI'm crushed with disappointment…$")
}

text FallarborTown_CozmosHouse_Text_CozmoIsSoHappy {
    format("Look at PROF. COZMO…\nHe's so happy! I think it's cute.$")
}

text FallarborTown_CozmosHouse_Text_FeelSorryForCozmo {
    format("Poor PROF. COZMO…\nHe's so depressed… I feel sorry for him.$")
}

text FallarborTown_CozmosHouse_Text_MeteoriteWillNeverBeMineNow {
    format("PROF. COZMO: Oh…\nI never should have let myself be\lconned into telling TEAM MAGMA where\lyou can find METEORITES…\pThat METEORITE from METEOR FALLS…\nIt's never going to be mine now…$")
}

text FallarborTown_CozmosHouse_Text_ReallyGoingToHelpMyResearch {
    format("PROF. COZMO: Oh, I can't believe it.\nThis is really, really great!\pThis is really going to help my research!$")
}
