text Route103_Text_RouteSign {
    format("ROUTE 103 {DOWN_ARROW} OLDALE TOWN")
}


text Route103_Text_AndrewDefeated {
    format("Gah! Lost it! I'm even more annoyed now!")
}

text Route103_Text_AndrewIntro {
    format("Gah! My fishing line's all snarled up! I'm getting frustrated and mean! That's it! Battle me!")
}

text Route103_Text_AndrewPostBattle {
    format("Gah, I'm still boiling mad… Grrrrr…")
}

text Route103_Text_DaisyDefeated {
    format("You weren't led astray by our aroma…")
}

text Route103_Text_DaisyIntro {
    format("Did you feel the tug of our soul-soothing fragrance?")
}

text Route103_Text_DaisyPostBattle {
    format("Aromatherapy is a form of mental healing that works with fragrances.")
}

text Route103_Text_IsabelleDefeated {
    format("Groan…")
}

text Route103_Text_IsabelleIntro {
    format("Watch where you're going! We're going to crash!")
}

text Route103_Text_IsabellePostBattle {
    format("I'm a poor swimmer so I was practicing… Sorry for almost crashing into you.")
}

text Route103_Text_MarcosDefeated {
    format("My one-man show is ruined…")
}

text Route103_Text_MarcosIntro {
    format("Did my guitar's wailing draw you in?")
}

text Route103_Text_MarcosPostBattle {
    format("I was playing my guitar where few people were around, but a lot of fans have gathered.\pHeh, maybe I should turn pro.")
}

text Route103_Text_MiguelDefeated {
    format("Oh, my gosh! My darling POKéMON!")
}

text Route103_Text_MiguelIntro {
    format("My POKéMON is delightfully adorable! Don't be shy--I'll show you!")
}

text Route103_Text_MiguelPostBattle {
    format("My delightful POKéMON looks darling even when it's fainted!")
}

text Route103_Text_PeteDefeated {
    format("Oh, that's good going!")
}

text Route103_Text_PeteIntro {
    format("This sort of distance… You should just swim it!")
}

text Route103_Text_PetePostBattle {
    format("Oh, I understand where you're coming from now.\pIf I had a POKéMON that trusty, I'd want to SURF on it, too!")
}

text Route103_Text_RhettDefeated {
    format("Whoa! The kid can rock!")
}

text Route103_Text_RhettIntro {
    format("Whoa! How'd you get into a space this small?")
}

text Route103_Text_RhettPostBattle {
    format("Do you like cramped quarters like this?")
}

text Route103_Text_MayRoute103Pokemon {
    format("MAY: Let's see… The POKéMON found\non ROUTE 103 include…$")
}

text Route103_Text_ShouldHaveBroughtPotion {
    format("My POKéMON is staggeringly tired…\nI should have brought a POTION…$")
}

text Route103_Text_ShortcutToOldale {
    format("If you cross the sea from here,\nit'll be a shortcut to OLDALE TOWN.\pFufufu, that's useful, isn't it?$")
}

text Route103_Text_BrendanTimeToHeadBack {
    format("BRENDAN: I think I get it.\nI think I know why my dad has his eye\lout for you now.\pLook, your POKéMON already likes you,\neven though you just got it.\p{PLAYER}, I get the feeling that you\ncould befriend any POKéMON with ease.\pWe should head back to the LAB.$")
}

text Route103_Text_MayTimeToHeadBack {
    format("MAY: I think I know why my dad has\nan eye out for you now.\pI mean, you just got that POKéMON,\nbut it already likes you.\pYou might be able to befriend any\nkind of POKéMON easily.\pWell, it's time to head back to\nthe LAB.$")
}

text Route103_Text_BrendanRoute103Pokemon {
    format("BRENDAN: Okay, so it's this one and\nthat one that live on ROUTE 103…$")
}
