mapscripts Route2_ViridianForest_NorthEntrance_MapScripts {
}

script Route2_ViridianForest_NorthEntrance_EventScript_CooltrainerF {
    msgbox(Route2_ViridianForest_NorthEntrance_Text_CanCancelEvolution, MSGBOX_NPC)
    end
}

script Route2_ViridianForest_NorthEntrance_EventScript_OldMan {
    msgbox(Route2_ViridianForest_NorthEntrance_Text_CanCutSkinnyTrees, MSGBOX_NPC)
    end
}

script Route2_ViridianForest_NorthEntrance_EventScript_Youngster {
    msgbox(Route2_ViridianForest_NorthEntrance_Text_ManyMonsOnlyInForests, MSGBOX_NPC)
    end
}


text Route2_ViridianForest_NorthEntrance_Text_CanCancelEvolution {
    format("Do you know the evolution-cancel\ntechnique?\pWhen a POKéMON is evolving, you\ncan stop the process.\pIt's a technique for raising\nPOKéMON the way they are.$")
}

text Route2_ViridianForest_NorthEntrance_Text_CanCutSkinnyTrees {
    format("Have you noticed the skinny trees\non the roadside?\pThey can be cut down by a special\nPOKéMON move, I hear.$")
}

text Route2_ViridianForest_NorthEntrance_Text_ManyMonsOnlyInForests {
    format("Many POKéMON live only in forests \nand caves.\pYou need to be persistent and look\neverywhere to get different kinds.$")
}
