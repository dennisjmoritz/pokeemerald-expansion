mapscripts MauvilleCity_PokemonCenter_1F_MapScripts {
}

script MauvilleCity_PokemonCenter_1F_EventScript_Nurse {
    end
}

script MauvilleCity_PokemonCenter_1F_EventScript_Woman1 {
    msgbox(MauvilleCity_PokemonCenter_1F_Text_ManOverThereSaysWeirdThings, MSGBOX_NPC)
    end
}

script MauvilleCity_PokemonCenter_1F_EventScript_Woman2 {
    msgbox(MauvilleCity_PokemonCenter_1F_Text_MyDataUpdatedFromRecordCorner, MSGBOX_NPC)
    end
}

script MauvilleCity_PokemonCenter_1F_EventScript_Youngster {
    msgbox(MauvilleCity_PokemonCenter_1F_Text_RecordCornerSoundsFun, MSGBOX_NPC)
    end
}

text MauvilleCity_PokemonCenter_1F_Text_RecordCornerSoundsFun {
    format("A RECORD CORNER opened upstairs in\nthe POKéMON CENTER.\pI don't know what it's about, but it\nsounds fun. I'll go check it out!$")
}

text MauvilleCity_PokemonCenter_1F_Text_MyDataUpdatedFromRecordCorner {
    format("When I accessed the RECORD CORNER,\nthe data for what's hot in DEWFORD\lgot updated.\pNow that bit of data is the same\nas my friend's!$")
}

text MauvilleCity_PokemonCenter_1F_Text_ManOverThereSaysWeirdThings {
    format("That man over there, he says weird\nthings!\pHe's funny in a weird way.\nI doubt I'll forget about him!$")
}
