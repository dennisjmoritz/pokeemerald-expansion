Route38_Text_Sign1::
# 10 "data/maps/Route38/scripts.pory"
	.string "Route38 Sign 1$"

Route38_Text_SmithNPC1::
# 19 "data/maps/Route38/scripts.pory"
	.string "I've been expecting you, Mr. Anderson.$"

Route38_Text_SmithNPC2::
# 28 "data/maps/Route38/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

Route38_Text_SmithNPC3::
# 37 "data/maps/Route38/scripts.pory"
	.string "Never send a human to do a machine's\n"
	.string "job.$"

Route38_Text_SmithNPC4::
# 46 "data/maps/Route38/scripts.pory"
	.string "You hear that, Mr. Anderson? That is the\n"
	.string "sound of inevitability.$"

Route38_Text_SmithNPC5::
# 55 "data/maps/Route38/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

Route38_Text_SmithNPC6::
# 64 "data/maps/Route38/scripts.pory"
	.string "It's the question that drives us, Neo.$"

Route38_Text_SmithNPC7::
# 73 "data/maps/Route38/scripts.pory"
	.string "Unfortunately, no one can be told what\n"
	.string "the Matrix is.$"

Route38_Text_SmithNPC8::
# 82 "data/maps/Route38/scripts.pory"
	.string "I know kung fu.$"

Route38_Text_SmithNPC9::
# 91 "data/maps/Route38/scripts.pory"
	.string "Dodge this.$"

Route38_Text_SmithNPC10::
# 100 "data/maps/Route38/scripts.pory"
	.string "Choice is an illusion created between\n"
	.string "those with power and those without.$"
