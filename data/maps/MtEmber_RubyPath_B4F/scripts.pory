script MtEmber_RubyPath_B4F_EventScript_SmithNPC1 {
    msgbox(MtEmber_RubyPath_B4F_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text MtEmber_RubyPath_B4F_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

