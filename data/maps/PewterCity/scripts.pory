text PewterCity_Text_GymSign {
    format("PEWTER CITY POKéMON GYM LEADER: BROCK\l The Rock-Solid POKéMON TRAINER!")
}

text PewterCity_Text_MuseumOfScience {
    format("PEWTER MUSEUM OF SCIENCE")
}

text PewterCity_Text_CitySign {
    format("PEWTER CITY A Stone Gray City")
}

text PewterCity_Text_CallPoliceIfInfoOnThieves {
    format("NOTICE!\p Thieves have been stealing POKéMON fossils from MT. MOON.\p Please call the PEWTER POLICE if you have any information.")
}

text PewterCity_Text_TrainerTipsEarningEXP {
    format("TRAINER TIPS\p All POKéMON that appear in battle, however briefly, earn EXP Points.")
}

text PewterCity_Text_DoYouKnowWhatImDoing {
    format("Psssst!\nDo you know what I'm doing?$")
}

text PewterCity_Text_ClefairyCameFromMoon {
    format("CLEFAIRY came from the moon.\nThat's what the rumor is.\pThey appeared after MOON STONES\nfell on MT. MOON.$")
}

text PewterCity_Text_DidYouCheckOutMuseum {
    format("Did you check out the MUSEUM?$")
}
