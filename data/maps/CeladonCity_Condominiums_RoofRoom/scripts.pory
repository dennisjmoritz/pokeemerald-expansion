text CeladonCity_Condominiums_RoofRoom_Text_TheresNothingIDontKnow {
    format("There is nothing that I don't know,\nlike I wrote on the blackboard.\pI know about the world of POKéMON\nin your GAME BOY ADVANCE!\pGet together with your friends and\nenjoy trading POKéMON!$")
}
