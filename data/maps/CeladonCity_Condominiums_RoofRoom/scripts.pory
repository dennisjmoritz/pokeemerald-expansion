text CeladonCity_Condominiums_RoofRoom_Text_PamphletOnTMs {
    format("It's a pamphlet on TMs.\p … …\p There are fifty TMs in all.\p There are also seven HMs that can be used repeatedly.\p SILPH CO.")
}

