text VerdanturfTown_PokemonCenter_1F_Text_VisitForBattleTent {
    format("The reason why anyone would visit\nVERDANTURF…\pIt's the BATTLE TENT. It goes without\nsaying.\pOr is there somebody here that you\ncame to see?$")
}

text VerdanturfTown_PokemonCenter_1F_Text_FaithInYourPokemon {
    format("You can't consider yourself a real\nTRAINER if you don't have faith\lin your POKéMON.\pOnly those people who can believe\nin their battling POKéMON can win\lthrough to the very end.$")
}
