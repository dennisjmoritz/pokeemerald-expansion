MahoganyTown_RocketHideout_B3F_Text_SmithNPC2::
# 18 "data/maps/MahoganyTown_RocketHideout_B3F/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

MahoganyTown_RocketHideout_B3F_Text_SmithNPC3::
# 27 "data/maps/MahoganyTown_RocketHideout_B3F/scripts.pory"
