	.string "job.$"

MahoganyTown_RocketHideout_B3F_Text_SmithNPC4::
# 36 "data/maps/MahoganyTown_RocketHideout_B3F/scripts.pory"
	.string "You hear that, Mr. Anderson? That is the\n"
	.string "sound of inevitability.$"

MahoganyTown_RocketHideout_B3F_Text_SmithNPC5::
# 45 "data/maps/MahoganyTown_RocketHideout_B3F/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

MahoganyTown_RocketHideout_B3F_Text_SmithNPC6::
# 54 "data/maps/MahoganyTown_RocketHideout_B3F/scripts.pory"
