Route222_Text_SmithNPC1::
# 9 "data/maps/Route222/scripts.pory"
	.string "I've been expecting you, Mr. Anderson.$"

Route222_Text_SmithNPC2::
# 18 "data/maps/Route222/scripts.pory"
	.string "Human beings are a disease; I'm the\n"
	.string "cure.$"

Route222_Text_SmithNPC3::
# 27 "data/maps/Route222/scripts.pory"
	.string "Never send a human to do a machine's\n"
	.string "job.$"

Route222_Text_SmithNPC4::
# 36 "data/maps/Route222/scripts.pory"
	.string "You hear that, Mr. Anderson? That is the\n"
	.string "sound of inevitability.$"

Route222_Text_SmithNPC5::
# 45 "data/maps/Route222/scripts.pory"
	.string "We're not here because we're free; we're\n"
	.string "here because we're not free.$"

Route222_Text_SmithNPC6::
# 54 "data/maps/Route222/scripts.pory"
	.string "It's the question that drives us, Neo.$"

Route222_Text_SmithNPC7::
# 63 "data/maps/Route222/scripts.pory"
	.string "Unfortunately, no one can be told what\n"
	.string "the Matrix is.$"

Route222_Text_SmithNPC8::
# 72 "data/maps/Route222/scripts.pory"
	.string "I know kung fu.$"

Route222_Text_SmithNPC9::
# 81 "data/maps/Route222/scripts.pory"
	.string "Dodge this.$"

Route222_Text_SmithNPC10::
# 90 "data/maps/Route222/scripts.pory"
	.string "Choice is an illusion created between\n"
	.string "those with power and those without.$"

Route222_Text_SmithNPC11::
# 99 "data/maps/Route222/scripts.pory"
	.string "Hope is an illusion, Mr. Anderson.$"
