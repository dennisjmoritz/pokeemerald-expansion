text MauvilleCity_Text_CitySign {
    format("MAUVILLE CITY “The bright and shiny city of fun!”")
}

text MauvilleCity_Text_GymSign {
    format("MAUVILLE CITY POKéMON GYM LEADER: WATTSON\l “The cheerfully electrifying man!”")
}

text MauvilleCity_Text_BikeShopSign {
    format("“Ride in gravel and shake up your soul!”\l RYDEL'S CYCLES")
}

text MauvilleCity_Text_GameCornerSign {
    format("“The play spot for all!” MAUVILLE GAME CORNER")
}

text MauvilleCity_Text_NurseHurtMonBackToHealth {
    format("You know, it's cool to have POKéMON\nbattles and stuff…\pBut if your POKéMON gets hurt,\nyou have to nurse it back to health.$")
}

text MauvilleCity_Text_WattsonYoungTakeCharge {
    format("WATTSON: Wahahahaha!\pIt pleases me to no end to see\nthe young step up and take charge!$")
}

text MauvilleCity_Text_RydelVeryGenerous {
    format("Have you been to RYDEL'S CYCLES yet?\pRYDEL, the owner, is a very generous\nman.$")
}

text MauvilleCity_Text_WattsonThanksTakeTM {
    format("WATTSON: Wahahahaha!\pI knew it, {PLAYER}{KUN}! I knew I'd made\nthe right choice asking you!\pThis is my thanks--a TM containing\nTHUNDERBOLT!\pGo on, you've earned it!$")
}

text MauvilleCity_Text_RegisteredWally {
    format("Registered WALLY\nin the POKéNAV.$")
}

text MauvilleCity_Text_WallyPleaseBattleMe {
    format("WALLY: {PLAYER}, please!\nBattle with me, please.$")
}

text MauvilleCity_Text_UncleCanYouBattleWally {
    format("UNCLE: {PLAYER}{KUN}, was it?\nOn WALLY's behalf, can I ask you to\lbattle with him just this once?\pI don't think he's going to listen to\nany reason the way he is now.$")
}

text MauvilleCity_Text_AllSortsOfPeopleComeThrough {
    format("The roads of this town stretch north\nand south, and east and west.\pBecause of that, we get all sorts of\npeople coming through.$")
}

text MauvilleCity_Text_BeenCheckingOutTV {
    format("Hi, have you been checking out TVs?$")
}

text MauvilleCity_Text_WattsonWontBeChallenge {
    format("WATTSON: Don't you worry about it.\nIt won't be a challenge to you.\pThe entrance to NEW MAUVILLE is just\na short SURF away from ROUTE 110.\pThat's it, then, you have my trust!\nWahahahaha!$")
}

text MauvilleCity_Text_WallyMyUncleWontKnowImStrong {
    format("WALLY: Oh… If you won't battle me,\n{PLAYER}, my UNCLE won't know that I've\lbecome really strong.$")
}

text MauvilleCity_Text_PokemonCanJumpYouOnBike {
    format("Even if you're riding a BIKE,\nwild POKéMON could jump you.$")
}

text MauvilleCity_Text_WallyHereICome {
    format("WALLY: {PLAYER}, thank you.\pOkay… Here I come!$")
}
