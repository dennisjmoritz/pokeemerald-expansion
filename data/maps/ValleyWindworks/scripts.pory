mapscripts ValleyWindworks_MapScripts {
}


script ValleyWindworks_EventScript_Sign1 {
    msgbox(ValleyWindworks_Text_Sign1, MSGBOX_SIGN)
    end
}

text ValleyWindworks_Text_Sign1 {
    format("ValleyWindworks Sign 1")
}

script ValleyWindworks_EventScript_SmithNPC1 {
    msgbox(ValleyWindworks_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text ValleyWindworks_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script ValleyWindworks_EventScript_SmithNPC2 {
    msgbox(ValleyWindworks_Text_SmithNPC2, MSGBOX_NPC)
    end
}

text ValleyWindworks_Text_SmithNPC2 {
    format("Human beings are a disease; I'm the cure.$")
}

script ValleyWindworks_EventScript_SmithNPC3 {
    msgbox(ValleyWindworks_Text_SmithNPC3, MSGBOX_NPC)
    end
}

text ValleyWindworks_Text_SmithNPC3 {
    format("Never send a human to do a machine's job.$")
}
