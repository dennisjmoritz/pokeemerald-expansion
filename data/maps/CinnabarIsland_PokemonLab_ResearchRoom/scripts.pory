text CinnabarIsland_PokemonLab_ResearchRoom_Text_LegendaryBirdEmail {
    format("There's an e-mail message.\p … … …\p There are three legendary bird POKéMON.\p They are ARTICUNO, ZAPDOS, and MOLTRES.\p Their whereabouts are unknown.\p We plan to explore the cavern close to CERULEAN.\p From: POKéMON RESEARCH TEAM…")
}
