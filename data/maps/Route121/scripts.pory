text Route121_Text_SafariZoneSign {
    format("“Filled with rare POKéMON!” SAFARI ZONE")
}

text Route121_Text_MtPyrePierSign {
    format("MT. PYRE PIER\p …The sign is old and worn out. The words are barely legible…")
}


text Route121_Text_CaleDefeat {
    format("Of course I lost! I'm holding stuff in both hands!")
}

text Route121_Text_CaleIntro {
    format("Can't you see that I have all this stuff with me?\pDespite that, you still insist that we battle?")
}

text Route121_Text_CalePostBattle {
    format("I bought too much stuff at the LILYCOVE DEPT. STORE.\pIt's up the road from here. I wish I had a BAG like yours.")
}

text Route121_Text_CristinDefeat {
    format("No! You're horrid!")
}

text Route121_Text_CristinIntro {
    format("I have this routine. Defeat five TRAINERS a day. Guess what? You're number five!")
}

text Route121_Text_CristinPostBattle {
    format("I didn't expect to lose this easily… I'll win next time!")
}

text Route121_Text_JessicaDefeat {
    format("Oh, how dare you! Don't take it so seriously!")
}

text Route121_Text_JessicaIntro {
    format("Stop! Have a good look at my precious POKéMON!")
}

text Route121_Text_JessicaPostBattle {
    format("Maybe I'll go catch more POKéMON at the SAFARI.")
}

text Route121_Text_MarcelDefeat {
    format("Oh, now what happened here?")
}

text Route121_Text_MarcelIntro {
    format("My POKéMON have never tasted defeat! On their next win, I'm entering them in CONTESTS.")
}

text Route121_Text_MarcelPostBattle {
    format("I may have to train my gang some more before entering any CONTEST.")
}

text Route121_Text_MylesDefeat {
    format("Super awesome!")
}

text Route121_Text_MylesIntro {
    format("There's nothing I love more than checking out other people's POKéMON!")
}

text Route121_Text_MylesPostBattle {
    format("They're great, your POKéMON! How do you raise them?")
}

text Route121_Text_PatDefeat {
    format("Wow! Spectacular!")
}

text Route121_Text_PatIntro {
    format("I want everybody to see the POKéMON I've raised!")
}

text Route121_Text_PatPostBattle {
    format("I raise every POKéMON with the same love and care--I don't pick favorites.")
}

text Route121_Text_TammyDefeat {
    format("I have lost…")
}

text Route121_Text_TammyIntro {
    format("There are powers beyond our understanding in the world…")
}

text Route121_Text_TammyPostBattle {
    format("MT. PYRE… There is a mysterious power at work there…")
}

text Route121_Text_VanessaDefeat {
    format("This isn't what I meant!")
}

text Route121_Text_VanessaIntro {
    format("Will you play with my delightfully pretty POKéMON?")
}

text Route121_Text_VanessaPostBattle {
    format("I'm going to a CONTEST in LILYCOVE.\pMy POKéMON should have no problem sweeping the MASTER CLASS.")
}

text Route121_Text_WalterDefeat {
    format("Ah, well played.")
}

text Route121_Text_WalterIntro {
    format("With my POKéMON, I have traveled to the world's four corners.\pYou might say I have some confidence in my abilities.")
}

text Route121_Text_WalterPostBattle {
    format("I would like to circle the globe once again with my POKéMON.")
}

text Route121_Text_OkayMoveOutToMtPyre {
    format("Okay!\nWe're to move out to MT. PYRE!$")
}

text Route121_Text_AheadLoomsMtPyre {
    format("Ahead looms MT. PYRE…\pIt is a natural monument to the spirits \nof departed POKéMON…$")
}

text Route121_Text_JoyPostBattle {
    format("JOY: Ehehe, I'll have to train with KATE, my senior student partner, again.")
}

text Route121_Text_KatePostBattle {
    format("KATE: When someone's relying on me, I get this urge to look cool in front of them…")
}
