text Route121_Text_SafariZoneSign {
    format("“Filled with rare POKéMON!” SAFARI ZONE")
}

text Route121_Text_MtPyrePierSign {
    format("MT. PYRE PIER\p …The sign is old and worn out. The words are barely legible…")
}


text Route121_Text_CaleDefeat {
    "Of course I lost!\nI'm holding stuff in both hands!"
}

text Route121_Text_CaleIntro {
    "Can't you see that I have all this\nstuff with me?\pDespite that, you still insist that\nwe battle?"
}

text Route121_Text_CalePostBattle {
    "I bought too much stuff at\nthe LILYCOVE DEPT. STORE.\pIt's up the road from here.\nI wish I had a BAG like yours."
}

text Route121_Text_CristinDefeat {
    "No!\nYou're horrid!"
}

text Route121_Text_CristinIntro {
    "I have this routine.\nDefeat five TRAINERS a day.\nGuess what? You're number five!"
}

text Route121_Text_CristinPostBattle {
    "I didn't expect to lose this easily…\nI'll win next time!"
}

text Route121_Text_JessicaDefeat {
    "Oh, how dare you!\nDon't take it so seriously!"
}

text Route121_Text_JessicaIntro {
    "Stop! Have a good look at my precious\nPOKéMON!"
}

text Route121_Text_JessicaPostBattle {
    "Maybe I'll go catch more POKéMON at\nthe SAFARI."
}

text Route121_Text_MarcelDefeat {
    "Oh, now what happened here?"
}

text Route121_Text_MarcelIntro {
    "My POKéMON have never tasted defeat!\nOn their next win, I'm entering them\nin CONTESTS."
}

text Route121_Text_MarcelPostBattle {
    "I may have to train my gang some more\nbefore entering any CONTEST."
}

text Route121_Text_MylesDefeat {
    "Super awesome!"
}

text Route121_Text_MylesIntro {
    "There's nothing I love more than\nchecking out other people's POKéMON!"
}

text Route121_Text_MylesPostBattle {
    "They're great, your POKéMON!\nHow do you raise them?"
}

text Route121_Text_PatDefeat {
    "Wow!\nSpectacular!"
}

text Route121_Text_PatIntro {
    "I want everybody to see the POKéMON\nI've raised!"
}

text Route121_Text_PatPostBattle {
    "I raise every POKéMON with the same\nlove and care--I don't pick favorites."
}

text Route121_Text_TammyDefeat {
    "I have lost…"
}

text Route121_Text_TammyIntro {
    "There are powers beyond our\nunderstanding in the world…"
}

text Route121_Text_TammyPostBattle {
    "MT. PYRE…\nThere is a mysterious power\nat work there…"
}

text Route121_Text_VanessaDefeat {
    "This isn't what I meant!"
}

text Route121_Text_VanessaIntro {
    "Will you play with my delightfully\npretty POKéMON?"
}

text Route121_Text_VanessaPostBattle {
    "I'm going to a CONTEST in LILYCOVE.\pMy POKéMON should have no problem\nsweeping the MASTER CLASS."
}

text Route121_Text_WalterDefeat {
    "Ah, well played."
}

text Route121_Text_WalterIntro {
    "With my POKéMON, I have traveled\nto the world's four corners.\pYou might say I have some confidence\nin my abilities."
}

text Route121_Text_WalterPostBattle {
    "I would like to circle the globe once\nagain with my POKéMON."
}