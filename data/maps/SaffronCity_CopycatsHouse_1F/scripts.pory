text SaffronCity_CopycatsHouse_1F_Text_DaughterLikesToMimicPeople {
    format("My daughter likes to mimic people.\nIt's rather vexing.\pHer mimicry has earned her the\nnickname COPYCAT around here.$")
}

text SaffronCity_CopycatsHouse_1F_Text_DaughterIsSelfCentered {
    format("My daughter is so self-centered.\nShe has but a few friends.$")
}
