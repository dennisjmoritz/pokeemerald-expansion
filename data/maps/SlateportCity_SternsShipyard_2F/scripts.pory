text SlateportCity_SternsShipyard_2F_Text_FloatsBecauseBuoyancy {
    format("Don't you think it's strange that\na ship made of heavy iron floats?\pIt floats because of a principle\ncalled buoyancy.$")
}

text SlateportCity_SternsShipyard_2F_Text_ShipDesignMoreLikeBuilding {
    format("Designing a large ship is more like\nmaking a big building than putting\ltogether a transportation vehicle.$")
}
