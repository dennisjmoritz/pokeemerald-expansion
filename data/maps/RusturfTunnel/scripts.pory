text RusturfTunnel_Text_ComeAndGetSome {
    format("What, are you coming?\nCome and get some, then!$")
}

text RusturfTunnel_Text_GruntIntro {
    format("Grah, keelhaul it all!\pThat hostage POKéMON turned out to\nbe worthless!\pAnd to think I made a getaway…\nIn this tunnel to nowhere!\pHey! You!\nSo you want to battle me?$")
}

text RusturfTunnel_Text_Peeko {
    format("PEEKO: Pii pihyoh!$")
}

text RusturfTunnel_Text_ToGetToVerdanturf {
    format("To get from RUSTBORO to VERDANTURF,\nyou need to go to DEWFORD, then pass\lthrough SLATEPORT and MAUVILLE…$")
}

text RusturfTunnel_Text_BoyfriendOnOtherSideOfRock {
    format("On the other side of this rock…\nMy boyfriend is there.\pHe… He's not just digging the tunnel\nto come see me.\pHe works his hands raw and rough\nfor the benefit of everyone.$")
}
