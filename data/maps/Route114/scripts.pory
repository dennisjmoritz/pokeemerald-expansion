text Route114_Text_MeteorFallsSign {
    format("METEOR FALLS RUSTBORO CITY THROUGH HERE")
}

text Route114_Text_LanettesHouse {
    format("LANETTE'S HOUSE")
}

text Route114_Text_FossilManiacsHouseSign {
    format("FOSSIL MANIAC'S HOUSE “Fossils gratefully accepted!”")
}


text Route114_Text_AngelinaDefeat {
    format("Oh, I see. That's good to know.")
}

text Route114_Text_AngelinaIntro {
    format("Have you made your POKéMON evolve very much?")
}

text Route114_Text_AngelinaPostBattle {
    format("Some POKéMON change so much when they evolve, it's startling!")
}

text Route114_Text_BernieDefeat {
    format("Thanks for dousing my fire!")
}

text Route114_Text_BernieIntro {
    format("If you're lighting a campfire, make sure you have water handy.")
}

text Route114_Text_BerniePostBattle {
    format("You really do have to be careful with any sort of fire in a forest.\pDon't ever underestimate the power of fire.")
}

text Route114_Text_CharlotteDefeat {
    format("That wasn't cute in the least!")
}

text Route114_Text_CharlotteIntro {
    format("Me! I'm not just a pretty face!")
}

text Route114_Text_CharlottePostBattle {
    format("I don't want a POKéMON that's just cute.\pI adore cute ones that have a quirk or two!")
}

text Route114_Text_ClaudeDefeat {
    format("If we were fishing, I would've won…")
}

text Route114_Text_ClaudeIntro {
    format("If we were fishing, you wouldn't stand a chance against me. So, bring on your POKéMON!")
}

text Route114_Text_ClaudePostBattle {
    format("I think I'll try my luck at landing a big one at METEOR FALLS.\pThere has to be something in there. I just know it.")
}

text Route114_Text_KaiDefeat {
    format("What was that about? Did mine lose in size?")
}

text Route114_Text_KaiIntro {
    format("I landed a big one! A huge one, I tell you!")
}

text Route114_Text_KaiPostBattle {
    format("Okay! I'll just fish me a bigger one!")
}

text Route114_Text_LennyDefeat {
    format("Yodelayhihoo!")
}

text Route114_Text_LennyIntro {
    format("Yodelayhihoo!\p… …\pYou're supposed to shout “yodelayhihoo” since it doesn't echo here!")
}

text Route114_Text_LennyPostBattle {
    format("When I was a wee tyke, I believed there was someone copying me and shouting back, “Yodelayhihoo.”")
}

text Route114_Text_LucasDefeat {
    format("The mountains are unforgiving…")
}

text Route114_Text_LucasIntro {
    format("If you're not prepared, you shouldn't be up in the mountains!")
}

text Route114_Text_LucasPostBattle {
    format("In the winter, mountains turn deadly with blizzards and avalanches.")
}

text Route114_Text_NancyDefeat {
    format("Oh, no!")
}

text Route114_Text_NancyIntro {
    format("I need to exercise after a meal. Let's have a match!")
}

text Route114_Text_NancyPostBattle {
    format("I just had a tasty meal. I'm getting drowsy…")
}

text Route114_Text_NolanDefeat {
    format("I like to battle, but that doesn't mean I'm good at it…")
}

text Route114_Text_NolanIntro {
    format("I like to fish. But I also like to battle!\pIf anyone challenges me, I'm there, even if I'm fishing.")
}

text Route114_Text_NolanPostBattle {
    format("This time I'll do it!\pI always think that, so I can't walk away from fishing or POKéMON.")
}

text Route114_Text_ShaneDefeat {
    format("Way too strong!")
}

text Route114_Text_ShaneIntro {
    format("Camping's fun! You can fish, roast marshmallows, and tell spooky stories!\pBut the best of all are the POKéMON battles!")
}

text Route114_Text_ShanePostBattle {
    format("I think it's great that I can go camping with my POKéMON.")
}

text Route114_Text_SteveDefeat {
    format("M-My POKéMON…")
}

text Route114_Text_SteveIntro {
    format("Ufufufufufu… Want to battle against my POKéMON?")
}

text Route114_Text_StevePostBattle {
    format("A big body that's all lumpy and hard, enormous horns, and vicious fangs…\pUfufufufu… I wish I had a POKéMON like that…")
}

text Route114_Text_ExplainRoar {
    format("TM05 contains ROAR.\nA ROAR sends POKéMON scurrying.$")
}

text Route114_Text_Poochyena {
    format("Bow! Bowwow!$")
}

text Route114_Text_IvyPostBattle {
    format("IVY: I started training POKéMON because TYRA, my student mentor, taught me!")
}

text Route114_Text_TyraPostBattle {
    format("TYRA: I was teaching my junior IVY about POKéMON.")
}
