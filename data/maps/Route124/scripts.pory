text Route124_Text_HuntersHouse {
    format("HUNTER'S HOUSE")
}


text Route124_Text_ChadDefeat {
    format("Glub, glub, glub… I'm sinking…")
}

text Route124_Text_ChadIntro {
    format("Fufufufu… I dive deep underwater to go deep under cover. Plumbing the depths is where I excel!")
}

text Route124_Text_ChadPostBattle {
    format("I have it on good authority that there's a DIVE spot around here.\pIt gives me the urge to go deep again…")
}

text Route124_Text_DeclanDefeat {
    format("I'm feeling blue. Blue as the sky…")
}

text Route124_Text_DeclanIntro {
    format("Here I am swimming by my lonesome on this wide, beautiful sea.\pThere's no other word for it. This is pathetic!")
}

text Route124_Text_DeclanPostBattle {
    format("I should chat up lady SWIMMERS and invite them on a long swim.")
}

text Route124_Text_GraceDefeat {
    format("I had no idea that you were this strong!")
}

text Route124_Text_GraceIntro {
    format("I'm growing bored of swimming… How about a battle?")
}

text Route124_Text_GracePostBattle {
    format("All the effort you put in must have made you this strong.")
}

text Route124_Text_IsabellaDefeat {
    format("I've only got sweat in my eyes! I am not crying!")
}

text Route124_Text_IsabellaIntro {
    format("I'm not going to lose to some surfer TRAINER.")
}

text Route124_Text_IsabellaPostBattle {
    format("You can find pretty colored shards of things around here.")
}

text Route124_Text_JennyDefeat {
    format("Oh, darn. I've gone and lost.")
}

text Route124_Text_JennyIntro {
    format("If you just float in the sea like this, POKéMON come around to play.")
}

text Route124_Text_JennyPostBattle {
    format("While swimming, I noticed that some POKéMON attack, and some just watch.\pI guess POKéMON have personalities of their own.")
}

text Route124_Text_RolandDefeat {
    format("Oh! I can't…")
}

text Route124_Text_RolandIntro {
    format("Hm! You're riding a POKéMON instead of swimming yourself…\pI am envious!")
}

text Route124_Text_RolandPostBattle {
    format("I'm getting chilled… I've been in the water too long…\pI wish I could ride a POKéMON like you…")
}

text Route124_Text_SpencerDefeat {
    format("I lost my bearings in battle!")
}

text Route124_Text_SpencerIntro {
    format("Hey, are you lost at sea?\pIf you can beat my POKéMON, I can serve as your pilot.")
}

text Route124_Text_SpencerPostBattle {
    format("Many people lose their bearings at sea.\pIf you're that sort, you should refer to the POKéNAV's MAP.")
}