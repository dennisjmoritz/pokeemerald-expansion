script Route124_EventScript_Spencer {
    trainerbattle_double(TRAINER_SPENCER, Route124_Text_SpencerIntro, Route124_Text_SpencerDefeat, Text_NotEnoughMonsForDoubleBattle)
    msgbox(Route124_Text_SpencerPostBattle)
