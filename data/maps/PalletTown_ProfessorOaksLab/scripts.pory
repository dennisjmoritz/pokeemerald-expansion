text PalletTown_ProfessorOaksLab_Text_EmailMessage {
    format("There's an e-mail message here.\p …\p Finally! The ultimate TRAINERS of the\l POKéMON LEAGUE are ready to\l take on all comers!\p Bring your best POKéMON and see how you rate as a TRAINER!\p POKéMON LEAGUE HQ INDIGO PLATEAU\p PROF. OAK, please visit us! …")
}

