text PetalburgCity_Gym_Text_EnterRecoveryRoom {
    format("“RECOVERY ROOM,” the sign says.\p Do you want to go through?")
}

text PetalburgCity_Gym_Text_EnterGymLeadersRoom {
    format("“GYM LEADER'S ROOM\p “See for yourself what POKéMON await you!” the sign says.\p Do you want to go through?")
}

