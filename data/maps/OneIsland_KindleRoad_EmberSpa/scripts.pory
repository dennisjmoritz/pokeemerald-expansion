text OneIsland_KindleRoad_EmberSpa_Text_EnjoyBowlOfChowder {
    format("My favorite part of bathing comes\nup right after this.\pI enjoy a bowl of chowder to\nwarm me from the inside, too!$")
}

text OneIsland_KindleRoad_EmberSpa_Text_HotSpringIsTherapeutic {
    format("Soaking in a hot spring pool is\ntherapeutic, people say.$")
}

text OneIsland_KindleRoad_EmberSpa_Text_WaterWarmsMeToCore {
    format("Hm!\nHaaaaaaaaaaah!\pAaaah! This is heavenly!\nThe water warms me to my core!\pYou should jump in, too.\pGo to the middle, relax, and get\ngood and warm!$")
}

text OneIsland_KindleRoad_EmberSpa_Text_SeeHowSmoothMySkinIs {
    format("Have a look at my face.\nSee how smooth my skin is?\pThe hot spring's water keeps my\nskin younger than my age.$")
}
