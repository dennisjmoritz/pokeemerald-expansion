text Route110_SeasideCyclingRoadSouthEntrance_Text_TooDangerousToWalk {
    format("Sorry, you can't walk on CYCLING\nROAD. It's too dangerous.\pPlease come back with a BIKE.$")
}

text Route110_SeasideCyclingRoadSouthEntrance_Text_GoAllOutOnCyclingRoad {
    format("On CYCLING ROAD, you can go all out\nand cycle as fast as you'd like.\pIt feels great to go that fast, but try\nnot to crash into anyone!$")
}
