mapscripts Route37_MapScripts {
}


script Route37_EventScript_Sign1 {
    msgbox(Route37_Text_Sign1, MSGBOX_SIGN)
    end
}

text Route37_Text_Sign1 {
    format("Route37 Sign 1")
}

script Route37_EventScript_SmithNPC1 {
    msgbox(Route37_Text_SmithNPC1, MSGBOX_NPC)
    end
}

text Route37_Text_SmithNPC1 {
    format("I've been expecting you, Mr. Anderson.$")
}

script Route37_EventScript_SmithNPC2 {
