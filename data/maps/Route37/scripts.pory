    end
}

text Route37_Text_SmithNPC2 {
    format("Human beings are a disease; I'm the cure.$")
}

script Route37_EventScript_SmithNPC3 {
    msgbox(Route37_Text_SmithNPC3, MSGBOX_NPC)
    end
}

text Route37_Text_SmithNPC3 {
    format("Never send a human to do a machine's job.$")
}

