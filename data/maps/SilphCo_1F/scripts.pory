mapscripts SilphCo_1F_MapScripts {
}

script SilphCo_1F_EventScript_FloorSign {
    msgbox(SilphCo_1F_Text_FloorSign, MSGBOX_SIGN)
    end
}

script SilphCo_1F_EventScript_Receptionist {
    msgbox(SilphCo_1F_Text_WelcomePresidentInBoardroom, MSGBOX_NPC)
    end
}


text SilphCo_1F_Text_FloorSign {
    format("SILPH CO. HEAD OFFICE 1F")
}

text SilphCo_1F_Text_WelcomePresidentInBoardroom {
    format("Welcome.\pThe PRESIDENT is in the boardroom\non 11F.$")
}
