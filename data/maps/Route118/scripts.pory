text Route118_Text_RouteSignMauville {
    format("ROUTE 118 {LEFT_ARROW} MAUVILLE CITY")
}

text Route118_Text_RouteSign119 {
    format("ROUTE 118 {UP_ARROW} ROUTE 119")
}


text Route118_Text_BarnyDefeat {
    format("I thought I was doing okay in my training…")
}

text Route118_Text_BarnyIntro {
    format("I'm a FISHERMAN, but also a TRAINER. I'm raising the POKéMON I caught.")
}

text Route118_Text_BarnyPostBattle {
    format("I couldn't win by training POKéMON while I fished…\pWas I doing things in half measures?")
}

text Route118_Text_ChesterDefeat {
    format("They did take flight…")
}

text Route118_Text_ChesterIntro {
    format("Take flight! My BIRD POKéMON!")
}

text Route118_Text_ChesterPostBattle {
    format("If they'd get stronger, they'd be able to fly more freely…")
}

text Route118_Text_DaltonDefeat {
    format("La-lalala…")
}

text Route118_Text_DaltonIntro {
    format("Let my melody rock your soul!")
}

text Route118_Text_DaltonPostBattle {
    format("An electric guitar doesn't always have to be noisy…\pIt can be strummed to squeeze out this heart-stirring melody…")
}

text Route118_Text_DeandreDefeat {
    format("Come in, POKéMON! Are you okay? POKéMON 1, 2, and 3?!")
}

text Route118_Text_DeandreIntro {
    format("Go, go, go! POKéMON 1, 2, and 3!")
}

text Route118_Text_DeandrePostBattle {
    format("Isn't it cool that I have a POKéMON battle team?\pYou can copy me--I don't mind!")
}

text Route118_Text_PerryDefeat {
    format("Urgh… I crashed…")
}

text Route118_Text_PerryIntro {
    format("BIRD POKéMON that FLY elegantly in the sky… They're the best!")
}

text Route118_Text_PerryPostBattle {
    format("You've got great POKéMON. I'll have to train mine better.")
}

text Route118_Text_RoseDefeat {
    format("Oh, dear me. I seem to have lost.")
}

text Route118_Text_RoseIntro {
    format("The aroma of flowers has a magical power. It cleanses us body and soul.")
}

text Route118_Text_RosePostBattle {
    format("Flowers, POKéMON… I love whatever smells nice.\pStinky things… I'll pass.")
}

text Route118_Text_WadeDefeat {
    format("I was beaten in heart?")
}

text Route118_Text_WadeIntro {
    format("For FISHERMEN, equipment is the key.\pBut for TRAINERS, the key ingredients are POKéMON and heart, of course!")
}

text Route118_Text_WadePostBattle {
    format("Come to think of it, fishing is a battle between a FISHERMAN and a POKéMON.")
}

text Route118_Text_CanCrossRiversWithSurf {
    format("Even if there isn't a boat, you can\ncross rivers and the sea if you have\la POKéMON that knows SURF.\pPOKéMON can be counted on to do so\nmuch!$")
}

text Route118_Text_TryCatchingMonWithGoodRod {
    format("Try catching all sorts of POKéMON\nwith your GOOD ROD.$")
}

text Route118_Text_StevenQuestions {
    format("STEVEN: Hi, {PLAYER}{KUN}!\pIt's me, STEVEN!\nWe met in the cave near DEWFORD.\pHave you met many kinds of POKéMON\nsince I last saw you?\pThere are many, many kinds of POKéMON\nin this wide world of ours.\pIf you wanted to raise only your\nfavorites, that's fine.\pPerhaps you find it more fun to raise\nall sorts of POKéMON.\pAs a TRAINER of POKéMON,\nwhat do you think?\pOf course, it's not any of my business.\pIt would be nice if we were to meet\nagain somewhere.$")
}

text Route118_Text_IdenticalMindsTakeThis {
    format("Hmm!\nWe're of identical minds!\pHmm!\nTake this GOOD ROD!$")
}

text Route118_Text_DontYouLikeToFish {
    format("Don't you like to fish?$")
}
