text DewfordTown_PokemonCenter_1F_Text_StoneCavern {
    format("There's a stone cavern at the edge\nof town.\pI've heard you can find rare stones\nthere.$")
}

text DewfordTown_PokemonCenter_1F_Text_FaintedMonCanUseHM {
    format("Even if a POKéMON faints and can't\nbattle, it can still use a move learned\lfrom a HIDDEN MACHINE (HM).$")
}
