text SlateportCity_OceanicMuseum_2F_Text_PressureExperiment {
    format("A rubber ball is expanding and shrinking.\p “In the sea, the weight of water itself exerts pressure.\p “In shallow water, the pressure is not very heavy.\p “However, in extremely deep water, the pressure can reach even tens of\l thousands of tons on a small area.”")
}

text SlateportCity_OceanicMuseum_2F_Text_HoennModel {
    format("“MODEL OF HOENN REGION”\p It's a miniature diorama of the HOENN region.\p Where is LITTLEROOT TOWN on this?")
}

text SlateportCity_OceanicMuseum_2F_Text_SSAnneReplica {
    format("“S.S. ANNE\p “A replica of the luxury liner that circles the globe.”")
}

text SlateportCity_OceanicMuseum_2F_Text_SubmarineReplica {
    format("“SUBMARINE EXPLORER 1\p “A replica of the high-performance ocean floor exploration submarine.”")
}

text SlateportCity_OceanicMuseum_2F_Text_SurfaceSeawaterDisplay {
    format("It's a display on the flow of seawater.\p “Toward the surface, seawater flows as currents driven by the winds.”")
}

text SlateportCity_OceanicMuseum_2F_Text_DeepSeawaterDisplay {
    format("It's a display on the flow of seawater.\p “Near the bottom of the sea, water flows due to differences in such\l factors as temperature and salinity.”")
}

text SlateportCity_OceanicMuseum_2F_Text_SSTidalReplica {
    format("“THE FERRY S.S. TIDAL\p “A scale replica of the ship under construction at STERN'S SHIPYARD.”")
}

text SlateportCity_OceanicMuseum_2F_Text_WaterQualitySample1 {
    format("“WATER QUALITY SAMPLE 1,” the label says.\p The sea is all connected, but the water seems to differ by region.")
}

text SlateportCity_OceanicMuseum_2F_Text_SumbersibleReplica {
    format("“SUBMERSIBLE POD\p “A replica of a compact, unmanned pod for seafloor exploration.”")
}

text SlateportCity_OceanicMuseum_2F_Text_WaterQualitySample2 {
    format("“WATER QUALITY SAMPLE 2,” the label says.\p Does the saltiness of seawater differ by region, too?")
}
