text SlateportCity_PokemonCenter_1F_Text_TradedMonWithFriend {
    format("I trade POKéMON with my friends.\pIf a traded POKéMON is holding an\nitem, it makes me twice as happy!$")
}

text SlateportCity_PokemonCenter_1F_Text_RaiseDifferentTypesOfPokemon {
    format("Want a tip for battling?\pI'd say it's raising different kinds\nof POKéMON in a balanced manner.\pIt's no good to make just one\nPOKéMON strong.\pIf it has a type disadvantage,\nit might not stand a chance.$")
}
