text Route109_SeashoreHouse_Text_TakeTheseSodaPopBottles {
    format("You're scorching hot!\nThose battles blazed!\lI'm more than just satisfied!\pAs thanks for showing me your hot\nstreak, I want you to take these.\pIt's half a dozen bottles of SODA POP!$")
}

text Route109_SeashoreHouse_Text_BagFull {
    format("Oh, but hey, your BAG's jammed full.\nI'll hang on to these for you.$")
}

text Route109_SeashoreHouse_Text_WantToBuySodaPop {
    format("Want to buy some SODA POP?\nPOKéMON love it!\pJust ¥300 a bottle!\nBuy some!$")
}

text Route109_SeashoreHouse_Text_ShowMeSomeHotMatches {
    format("Show me some hot matches!\pI run this SEASHORE HOUSE just for\nthat reason alone!$")
}

text Route109_SeashoreHouse_Text_NotEnoughMoney {
    format("You don't have the money.$")
}
